{# templates/admin/role/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-agency-role-index-scope container">
		<header class="header-refined mb-30">
			<div class="header-left">
				<div class="breadcrumb-mini">
					<span>Organigramme</span>
					<i class="fa-solid fa-chevron-right"></i>
					<strong>Postes & Fonctions</strong>
				</div>
				<h1>Structure des Postes ({{ isAgency ? 'Agence' : 'Plateforme' }})</h1>
				<p class="subtitle">Définissez les fonctions de votre personnel et configurez leurs accès granulaires.</p>
			</div>
			<div class="header-right">
				<a href="{{ path(add_route) }}" class="btn-refined btn-primary-gradient">
					<i class="fa-solid fa-plus-circle"></i>
					<span>Créer une fonction</span>
				</a>
			</div>
		</header>

		<div class="table-responsive-wrapper">
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Intitulé de la fonction</th>
						<th>Description du Poste</th>
						<th class="text-center">Permissions</th>
						<th class="text-center">Statut</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for r in roles %}
						<tr>
							<td>
								<div class="job-title-cell">
									<i class="fa-solid fa-briefcase text-gray"></i>
									<strong>{{ r.name }}</strong>
								</div>
							</td>
							<td>
								{{ r.description|default('Aucune description métier enregistrée.') }}
							</td>
							<td class="text-center">
								<span class="badge bg-secondary">{{ r.permissions_count }} actives</span>
							</td>
							<td class="text-center">
								<span class="pill-role-status {{ r.isActive ? 'active' : 'inactive' }}">
									{{ r.isActive ? 'Actif' : 'Désactivé' }}
								</span>
							</td>
							<td class="text-right">
								<div class="action-group-refined">
									<a href="{{ path(edit_route, {id: r.id}) }}" class="action-link config" title="Modifier l'intitulé et les droits">
										<i class="fa-solid fa-user-gear"></i>
									</a>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="5" class="text-center text-gray italic padding-20">
								Aucune fonction configurée pour le moment.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
