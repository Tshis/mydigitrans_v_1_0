{# templates/admin/partials/menu/_agency.html.twig #}

{# 1. OPÉRATIONS QUOTIDIENNES #}
<a href="{{ path('admin_agency_dashboard') }}" class="menu-link {{ page is same as('dashboard') ? 'active' : '' }}" data-tooltip="Tableau de bord">
	<span class="icon">
		<i class="fa-solid fa-gauge"></i>
	</span>
	<span class="text">Dashboard</span>
</a>

{# Planification des départs (Voyages) #}
{% if is_granted('trip.view') %}
	<a href="{{ path('admin_agency_trip_index') }}" class="menu-link {{ page is same as('trip') ? 'active' : '' }}" data-tooltip="Gestion des Voyages">
		<span class="icon">
			<i class="fa-solid fa-calendar-days"></i>
		</span>
		<span class="text">Voyages</span>
	</a>
{% endif %}

{# Réservations #}
{% if is_granted('reservation.view') %}
	<a href="{{ path('admin_agency_reservation_index') }}" class="menu-link {{ page is same as('reservation') ? 'active' : '' }}" data-tooltip="Réservations & Billetterie">
		<span class="icon">
			<i class="fa-solid fa-file-circle-check"></i>
		</span>
		<span class="text">Réservations</span>
	</a>
{% endif %}

{# Gestion des Colis #}
{% if is_granted('shipment.view') %}
	<a href="{{ path('admin_agency_shipment_index') }}" class="menu-link {{ page is same as('shipment') ? 'active' : '' }}" data-tooltip="Gestion des Colis">
		<span class="icon">
			<i class="fa-solid fa-box-open"></i>
		</span>
		<span class="text">Colis</span>
	</a>
{% endif %}

{# 2. FINANCES #}
{# Caisse #}
{% if is_granted('cash.view') %}
	<a href="{{ path('admin_agency_cashier_index') }}" class="menu-link {{ page is same as('cashier') ? 'active' : '' }}" data-tooltip="Gestion des Caisses">
		<span class="icon">
			<i class="fa-solid fa-cash-register"></i>
		</span>
		<span class="text">Caisse</span>
	</a>
{% endif %}

{# Flux / Dépenses #}
{% if is_granted('payment.view') or is_granted('expense.view') %}
	<a href="{{ path('admin_agency_finance_index') }}" class="menu-link {{ page is same as('finances') ? 'active' : '' }}" data-tooltip="Paiements & Dépenses">
		<span class="icon">
			<i class="fa-solid fa-hand-holding-dollar"></i>
		</span>
		<span class="text">Finances / Flux</span>
	</a>
{% endif %}

