{# templates/admin/agency/cashier/payment.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/admin/cashier-payment.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-cashier-payment-scope container">

		{% for message in app.flashes('error') %}
			<div class="notice-box-danger-dashboard mt-20"><p><i class="fa-solid fa-triangle-exclamation"></i> {{ message }}</p></div>
		{% endfor %}

		{# --- EN-TÊTE DE LA PAGE --- #}
		<header class="header-refined my-30">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_cashier_dashboard') }}" class="agency-back-action" title="Retour au tableau de bord">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<h1>
						<i class="fa-solid fa-cash-register"></i>
						Guichet Unique d'Encaissement
					</h1>
					<p class="subtitle">Saisissez une référence (Réservation ou Colis) pour charger le dossier, appliquer une éventuelle remise et percevoir le montant exact.</p>
				</div>
			</div>
		</header>

		{# --- BLOC DE RECHERCHE UNIFIÉ --- #}
		<div class="card mb-25">
			<h2>
				<i class="fa-solid fa-magnifying-glass"></i>
				Identification du Bon Client
			</h2>
			<form class="form-search-voucher-group" id="voucher-search-form" data-lookup-url="{{ path('admin_agency_cashier_lookup') }}">
				<div class="field-item-flex">
					<label class="section-micro-label">Référence du Bon (Ex : RES-... ou SHP-...)</label>
					<input
						type="text"
						id="voucher-input"
						class="input-search-voucher text-uppercase"
						placeholder="Ex: RES-2611-01-XXXX ou SHP-2611-01-XXXX"
						value="{{ prefill_ref }}"
						required
					>
				</div>
				<button type="submit" class="btn btn-dark btn-search-submit">
					<i class="fa-solid fa-arrow-right-to-bracket"></i>
					Charger le dossier
				</button>
			</form>
			<div id="voucher-lookup-error" class="text-danger font-bold text-size-13 mt-10 is-hidden"></div>
		</div>

		{# --- ZONE DE TRAITEMENT DEUX COLONNES --- #}
		<div class="reservation-container" id="cashier-payment-container">

			{# PANNEAU DE GAUCHE : LE CALCULATEUR DE FLUX LINÉAIRE #}
			<div class="card">
				<h2>
					<i class="fa-solid fa-calculator"></i>
					Règlement & Calcul de la Remise
				</h2>

				{{ form_start(form, {attr: {id: 'payment-processing-form'}}) }}
					{{ form_widget(form.voucherReference) }}

					{% if form.vars.errors|length > 0 %}
						<div class="notice-box-danger-dashboard mb-15">{{ form_errors(form) }}</div>
					{% endif %}

					{# 1. MONTANT INITIAL DU DOCUMENT --- #}
					<div class="field mb-15">
						<label class="session-micro-label">Montant initial du bon</label>
						<div class="input-currency-wrapper">
							<input type="text" id="base-amount-display" class="input-search-voucher text-amount-base" readonly value="0,00" data-raw="0">
							<span class="currency-badge-suffix id-doc-currency">-</span>
						</div>
					</div>

					{# 2. ZONE DE REMISE --- #}
					<div class="field-group mb-15 discount-badge-container grid-two-columns">
						<div class="field flex-full">
							{{ form_label(form.discountAmount, null, {label_attr: {class: 'session-micro-label discount-label'}}) }}
							{{ form_widget(form.discountAmount) }}
							<div class="text-danger text-size-12">{{ form_errors(form.discountAmount) }}</div>
						</div>
						<div class="field flex-full">
							{{ form_label(form.discountType, null, {label_attr: {class: 'session-micro-label discount-label'}}) }}
							{{ form_widget(form.discountType) }}
							<div class="text-danger text-size-12">{{ form_errors(form.discountType) }}</div>
						</div>
					</div>

					{# 3. NET À ENCAISSER --- #}
					<div class="field mb-15 text-success-highlight">
						<label class="session-micro-label font-bold">Montant exact à payer au guichet</label>
						<div class="input-currency-wrapper">
							<input type="text" id="final-amount-display" class="input-search-voucher text-amount-xl font-bold" readonly value="0,00">
							<span class="currency-badge-suffix id-doc-currency font-bold">-</span>
						</div>
					</div>

					<hr class="summary-divider mb-20">

					<div class="field mb-15">
						{{ form_label(form.paymentMethod, null, {label_attr: {class: 'session-micro-label font-bold'}}) }}
						{{ form_widget(form.paymentMethod) }}
						<div class="text-danger text-size-12">{{ form_errors(form.paymentMethod) }}</div>
					</div>

					{# 4. PERCEPTION RÉELLE --- #}
					<div class="field-group mb-15 grid-two-columns execution-receipt-box">
						<div class="field flex-full">
							{{ form_label(form.capturedAmount, null, {label_attr: {class: 'session-micro-label font-bold text-danger-mode'}}) }}
							{{ form_widget(form.capturedAmount) }}
							<div class="text-danger text-size-12">{{ form_errors(form.capturedAmount) }}</div>
							<span class="sub-meta-text">Inscrivez le montant exact remis par le client.</span>
						</div>
						<div class="field flex-full">
							{{ form_label(form.capturedCurrency, null, {label_attr: {class: 'session-micro-label font-bold text-danger-mode'}}) }}
							{{ form_widget(form.capturedCurrency) }}
							<div class="text-danger text-size-12">{{ form_errors(form.capturedCurrency) }}</div>
							<span class="sub-meta-text">Sélectionnez le compartiment du coffre impacté.</span>
						</div>
					</div>

					<div class="field mb-15">
						{{ form_label(form.discountObservation, null, {label_attr: {class: 'session-micro-label'}}) }}
						{{ form_widget(form.discountObservation) }}
						<div class="text-danger text-size-12">{{ form_errors(form.discountObservation) }}</div>
					</div>

					<div class="text-right table-action-buttons block-action-wrapper">
						<button type="submit" class="btn-submit-perceive">
							<i class="fa-solid fa-print"></i>
							Confirmer l'encaissement & Émettre le reçu
						</button>
					</div>
				{{ form_end(form) }}
			</div>

			{# DROITE : DETAILS DU DOCUMENT INTERCEPTÉ --- #}
			<div class="layout-main-panel">
				<div class="card cashier-document-card">
					<h2>
						<i class="fa-solid fa-file-invoice-dollar"></i>
						Détails du Document Intercepté
					</h2>

					<div class="field-group mb-20 status-alert-box alert-reservation" id="doc-alert-banner">
						<div class="meta-item flex-item">
							<span class="section-micro-label label-reservation">Nature du document</span>
							<strong class="text-highlight" id="doc-nature-text">EN ATTENTE DE RECHERCHE</strong>
						</div>
						<div class="meta-item flex-item">
							<span class="section-micro-label label-reservation">Référence Système</span>
							<strong class="text-highlight" id="doc-ref-text">-</strong>
						</div>
					</div>

					<div class="field-group mb-20 core-info-grid flex-row-gap">
						<div class="field flex-item">
							<span class="section-micro-label" id="doc-actor1-label">Client / Expéditeur</span>
							<p class="actor-name" id="doc-actor1-name">-</p>
							<span class="actor-sub-text" id="doc-actor1-phone">-</span>
						</div>
						<div class="field flex-item">
							<span class="section-micro-label" id="doc-actor2-label">Prestation / Trajet</span>
							<p class="actor-name" id="doc-actor2-name">-</p>
							<span class="actor-sub-text" id="doc-actor2-phone">-</span>
						</div>
					</div>
				</div>
			</div>

		</div>
	</div>
{% endblock %}
