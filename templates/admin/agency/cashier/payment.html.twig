{# templates/admin/agency/cashier/payment.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div
		class="admin-cashier-payment-scope container">

		{# --- EN-TÊTE DE LA PAGE --- #}
		<header class="header mb-25">
			<a href="{{ path('admin_agency_cashier_dashboard') }}" class="agency-back-action" title="Retour au tableau de bord">
				<i class="fa-solid fa-arrow-left"></i>
			</a>
			<div class="title">
				<h2>Guichet Unique d'Encaissement</h2>
				<p>Régularisez les documents en attente (Billets Voyageurs ou Bordereaux de Fret).</p>
			</div>
		</header>

		{# --- MOTEUR D'INTERCEPTION --- #}
		<div class="card mb-25">
			<div class="form-search-voucher-group">
				<div class="field">
					<label>Saisir ou Scanner la référence du Bon</label>
					<input type="text" placeholder="Ex: RVS-2026-8943 ou SHP-2026-8942..." class="input-search-voucher" value="RVS-2026-8943">
				</div>
				<button type="button" class="btn btn-search-trigger">
					<i class="fa-solid fa-magnifying-glass"></i>
					Charger le Bon
				</button>
			</div>
		</div>

		{# --- ZONE DE TRAITEMENT DEUX COLONNES --- #}
		<div
			class="reservation-container">

			{# GAUCHE : L'INCLUSION DU FRAGMENT (EXEMPLE PASSAGER) #}
			<div class="layout-main-panel">
				<div class="card cashier-document-card">
					<h2>
						<i class="fa-solid fa-file-invoice-dollar"></i>
						Détails du Document Intercepté</h2>
					<div class="field-group mb-20 status-alert-box alert-reservation">
						<div class="meta-item">
							<span class="section-micro-label label-reservation">Nature du document</span>
							<strong class="text-highlight">BON DE RÉSERVATION PASSAGER</strong>
						</div>
						<div class="meta-item">
							<span class="section-micro-label label-reservation">Référence Système</span>
							<strong class="text-highlight">RVS-2026-8943</strong>
						</div>
					</div>
					<div class="field-group mb-20 core-info-grid">
						<div class="field">
							<span class="section-micro-label">Bénéficiaire / Voyageur</span>
							<p class="actor-name">Mputu Antoinette</p>
							<span class="actor-sub-text">+243 897 112 233</span>
						</div>
						<div class="field">
							<span class="section-micro-label">Logistique Associée</span>
							<p class="actor-name">Kinshasa → Kenge</p>
							<span class="actor-sub-text">Bus 01 | Siège 14 (Standard)</span>
						</div>
					</div>
				</div>
			</div>

			{# DROITE : LE BLOCK COMPTOIR DE PERCEPTION #}
			<aside class="summary">
				<div class="card summary-sticky-card">
					<h2>Perception de la Taxe</h2>
					<div class="payment-method-selectors mb-20">
						<label class="section-micro-label">MODE DE RÈGLEMENT EFFECTIF</label>
						<div class="payment-grid-buttons">
							<label class="pay-method-item">
								<input type="radio" name="pay_mode" checked>
								<span class="custom-box">
									<i class="fa-solid fa-money-bill-wave"></i>
									Espèces</span>
							</label>
							<label class="pay-method-item">
								<input type="radio" name="pay_mode">
								<span class="custom-box">
									<i class="fa-solid fa-mobile-screen"></i>
									M-Money</span>
							</label>
						</div>
					</div>
					<div class="field mb-15">
						<label class="section-micro-label">Devise de Réception</label>
						<select required>
							<option>CDF (Franc Congolais)</option>
							<option>USD (Dollar Américain)</option>
						</select>
					</div>
					<div class="field mb-20">
						<label class="section-micro-label">Référence Transaction Mobile Money</label>
						<input type="text" placeholder="Ex: TxID-98342" autocomplete="off">
					</div>
					<hr class="summary-divider mb-15">
					<div class="total">Net Encaissé :
						<strong>45 000 CDF</strong>
					</div>
					<button type="submit" class="btn btn-full mt-20 py-12">
						<i class="fa-solid fa-print"></i>
						Valider & Imprimer le Titre
					</button>
				</div>
			</aside>

		</div>
	</div>
{% endblock %}
