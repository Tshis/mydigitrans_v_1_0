{# templates/admin/agency/cashier/open.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/cashier-open.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-cashier-session-scope container">

		<header class="header mb-25">
			<div class="title">
				<h2>
					<i class="fa-solid fa-lock-open"></i>
					Ouverture de Session & Confirmation de Dotation
				</h2>
				<p>Vérifiez et confirmez le montant physique de l'enveloppe de monnaie remise par votre gérant ce matin.</p>
			</div>
		</header>

		<div
			class="session-init-container">

			{# DROITE : PROFIL ET DOTATION DE LA SEMAINE (Saisie par le gérant en amont) #}
			<aside class="summary">
				<div class="card summary-sticky-card alert-session-box">
					<h2>
						<i class="fa-solid fa-user-check"></i>
						Infos Guichet
					</h2>

					<div class="meta-item mb-15">
						<span class="session-micro-label">Caissier Titulaire</span>
						<strong class="text-dark">Jean Mukendi</strong>
						<span class="sub-meta-text">Affecté au :
							<strong>Guichet Principal 01</strong>
						</span>
					</div>

					<hr
					class="summary-divider mb-15">

					{# Zone de sécurité modifiée : Elle affiche la dotation enregistrée par le gérant #}
					<div class="meta-item prev-session-audit-box">
						<span class="session-micro-label text-highlight">Dotation du matin (Par le Gérant)</span>
						<p style="margin: 4px 0 0 0; font-size: 13px; font-weight: 700; color: #0c326d;">
							•
							<span id="expected-cdf-val">50 000</span>
							CDF
							<br>
							•
							<span id="expected-usd-val">0</span>
							USD
						</p>
						<span class="sub-meta-text" style="font-style: italic; margin-top: 5px;">Le gérant déclare vous
							                        avoir remis cette somme. Votre saisie à gauche doit y correspondre.</span>
					</div>
				</div>
			</aside>

			{# GAUCHE : LE FORMULAIRE DE COMPTAGE DU TIROIR #}
			<div class="card">
				<h2>
					<i class="fa-solid fa-calculator"></i>
					Comptage des espèces reçues
				</h2>
				<form action="#" method="POST" id="session-open-form">

					<div class="field-group mb-15 flex-gap-15">
						<div class="field flex-full">
							<label class="session-micro-label">Espèces physiques comptées en CDF *</label>
							<input type="number" name="opening_cdf" id="opening-cdf" class="input-session-field" placeholder="0" min="0" required>
							<span class="sub-meta-text">Comptez les billets Francs Congolais remis par le gérant.</span>
						</div>
						<div class="field flex-full">
							<label class="session-micro-label">Espèces physiques comptées en USD *</label>
							<input type="number" name="opening_usd" id="opening-usd" class="input-session-field" placeholder="0" min="0" required>
							<span class="sub-meta-text">Comptez les billets Dollars remis par le gérant.</span>
						</div>
					</div>

					<div class="field mb-15">
						<label class="session-micro-label">Observations / Notes d'ouverture</label>
						<textarea class="input-session-field text-area-fixed" placeholder="Signalez si des coupures sont trop usées ou si l'enveloppe reçue ne correspond pas..."></textarea>
					</div>

					<div class="block-action-wrapper">
						<button type="submit" class="btn-submit-open">
							<i class="fa-solid fa-key"></i>
							Confirmer la dotation & Ouvrir la caisse
						</button>
					</div>
				</form>
			</div>
		</div>

	</div>


	<script>

		document.addEventListener('DOMContentLoaded', () => {
const openForm = document.getElementById('session-open-form');
const inputCdf = document.getElementById('opening-cdf');
const inputUsd = document.getElementById('opening-usd');

// Récupération des valeurs configurées par le gérant (à droite dans le Twig)
const expectedCdf = parseFloat(document.getElementById('expected-cdf-val').innerText) || 0;
const expectedUsd = parseFloat(document.getElementById('expected-usd-val').innerText) || 0;

if (openForm) {
openForm.addEventListener('submit', (e) => {
const declaredCdf = parseFloat(inputCdf.value) || 0;
const declaredUsd = parseFloat(inputUsd.value) || 0;

// Alerte si le caissier ne valide pas la même somme que le gérant
if (declaredCdf !== expectedCdf || declaredUsd !== expectedUsd) {
e.preventDefault(); // Bloque la soumission automatique

const message = `⚠️ LITIGE DE DOTATION INITIALE\n\n` + `Le gérant a enregistré une dotation de : ${expectedCdf} CDF / ${expectedUsd} USD.\n` + `Vous déclarez avoir reçu en main : ${declaredCdf} CDF / ${declaredUsd} USD.\n\n` + `Cette différence va bloquer l'ouverture automatique. Un arbitrage immédiat du gérant de succursale est requis pour valider ce guichet.`;

alert(message);
}
});
}
});
	</script>
{% endblock %}
