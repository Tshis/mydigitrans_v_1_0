{# templates/admin/agency/cashier/open.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/cashier-open.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-cashier-session-scope container">

		<header class="header mb-25">
			<div class="title">
				<h2>
					<i class="fa-solid fa-lock-open"></i>
					Ouverture de Session & Confirmation de Dotation
				</h2>
				<p>Vérifiez et confirmez le montant physique de l'enveloppe de monnaie remise par votre gérant ce matin.</p>
			</div>
		</header>

		<div
			class="session-init-container">

			{# DROITE : PROFIL ET DOTATION DE LA SESSIONS (Configurée par le gérant en amont) #}
			<aside class="summary">
				<div class="card summary-sticky-card alert-session-box">
					<h2>
						<i class="fa-solid fa-user-check"></i>
						Infos Guichet
					</h2>

					<div class="meta-item mb-15">
						<span class="session-micro-label">Caissier Titulaire</span>
						<strong class="text-dark">Jean Mukendi</strong>
						<span class="sub-meta-text">Affecté au :
							<strong>Guichet Principal 01</strong>
						</span>
					</div>

					<hr
					class="summary-divider mb-15">

					{# Zone de sécurité dynamique : Affiche les dotations attendues configurées dans la table pivot CashSessionBalance #}
					<div class="meta-item prev-session-audit-box">
						<span class="session-micro-label text-highlight">Dotation attendue du matin (Par le Gérant)</span>
						<ul class="dynamic-expected-balances-list">
							{% for currency in active_currencies %}
								<li>
									•
									<span class="js-expected-val" data-currency="{{ currency.code }}">{{ currency.expected_amount }}</span>
									{{ currency.code }}
								</li>
							{% else %}
								<li class="text-danger">Aucune dotation configurée pour ce matin.</li>
							{% endfor %}
						</ul>
						<span class="sub-meta-text inline-notice-italic">Le gérant déclare vous avoir remis cette enveloppe. Votre saisie à gauche doit y correspondre.</span>
					</div>
				</div>
			</aside>

			{# GAUCHE : LE FORMULAIRE DE COMPTAGE DU TIROIR MULTI-DEVISES #}
			<div class="card">
				<h2>
					<i class="fa-solid fa-calculator"></i>
					Comptage des espèces reçues
				</h2>
				<form
					action="#" method="POST" id="session-open-form">

					{# Boucle magique : Génère les champs uniquement pour les devises actives de l'agence #}
					<div class="field-group mb-15 grid-dynamic-currencies">
						{% for currency in active_currencies %}
							<div class="field">
								<label class="session-micro-label">Espèces physiques en
									{{ currency.code }}
									*</label>
								<div class="input-currency-wrapper">
									<input type="number" name="opening_balances[{{ currency.code }}]" class="input-session-field js-declared-input" data-currency="{{ currency.code }}" placeholder="0" min="0" step="0.01" required>
									<span class="currency-badge-suffix">{{ currency.code }}</span>
								</div>
								<span class="sub-meta-text">Comptez les billets physiques reçus en
									{{ currency.code }}.</span>
							</div>
						{% endfor %}
					</div>

					<div class="field mb-15">
						<label class="session-micro-label">Observations / Notes d'ouverture</label>
						<textarea name="opening_note" class="input-session-field text-area-fixed" placeholder="Signalez si des coupures sont trop usées ou si l'enveloppe reçue ne correspond pas..."></textarea>
					</div>

					<div class="block-action-wrapper">
						<button type="submit" class="btn-submit-open">
							<i class="fa-solid fa-key"></i>
							Confirmer la dotation & Ouvrir la caisse
						</button>
					</div>
				</form>
			</div>
		</div>

	</div>

	{# Intercepteur JS universel et décorrélé des devises figées #}
	<script>
		document.addEventListener('DOMContentLoaded', () => {
const openForm = document.getElementById('session-open-form');

if (openForm) {
openForm.addEventListener('submit', (e) => {
let hasDiscrepancy = false;
let logExpected = [];
let logDeclared = [];

// 1. Parcourir toutes les valeurs attendues générées à droite
const expectedElements = document.querySelectorAll('.js-expected-val');

expectedElements.forEach(el => {
const currency = el.getAttribute('data-currency');
const expectedAmt = parseFloat(el.innerText) || 0;

// Trouver l'input de déclaration correspondant à gauche
const inputEl = document.querySelector (`.js-declared-input[data-currency="${currency}"]`);
const declaredAmt = inputEl ? (parseFloat(inputEl.value) || 0) : 0;

logExpected.push(`${expectedAmt} ${currency}`);
logDeclared.push(`${declaredAmt} ${currency}`);

if (declaredAmt !== expectedAmt) {
hasDiscrepancy = true;
}
});

// 2. Si un écart est détecté sur au moins une devise, bloquer le formulaire et lancer l'alerte
if (hasDiscrepancy) {
e.preventDefault();

const message = `⚠️ LITIGE DE DOTATION INITIALE DETECTÉ\n\n` + `Le gérant a enregistré en base : ${
logExpected.join(' / ')
}.\n` + `Vous déclarez avoir compté en main : ${
logDeclared.join(' / ')
}.\n\n` + `Cette différence empêche l'ouverture automatique sécurisée. Un arbitrage du gérant de succursale est requis immédiatement pour forcer ou corriger ce tiroir de caisse.`;

alert(message);
}
});
}
});
	</script>
{% endblock %}
