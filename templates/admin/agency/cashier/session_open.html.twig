{# templates/admin/agency/cashier/session_open.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div class="admin-cashier-session-scope container">

		{% for message in app.flashes('error') %}
			<div class="notice-box-danger-dashboard mt-20"><p><i class="fa-solid fa-triangle-exclamation"></i> {{ message }}</p></div>
		{% endfor %}

		<header class="header-refined mb-25">
			<div class="header-main-info">
				<div class="info">
					<h1>
						<i class="fa-solid fa-lock-open text-primary"></i>
						Ouverture de Session & Confirmation de Dotation
					</h1>
					<p class="subtitle">Vérifiez et confirmez le montant physique de l'enveloppe de monnaie remise par votre gérant ce matin.</p>
				</div>
			</div>
		</header>

		<div class="session-init-container">

			{# DROITE : PROFIL ET DOTATION DE LA SESSION #}
			<aside class="summary">
				<div class="card summary-sticky-card alert-session-box">
					<h2>
						<i class="fa-solid fa-user-check"></i>
						Infos Guichet
					</h2>

					<div class="meta-item mb-15">
						<span class="session-micro-label">Caissier Titulaire</span>
						<strong class="text-dark">{{ actor.fullName }}</strong>
						<span class="sub-meta-text">Affecté au :
							<strong>{{ session.cashRegister.name }} ({{ session.cashRegister.code }})</strong>
						</span>
					</div>

					<hr class="summary-divider mb-15">

					<div class="meta-item prev-session-audit-box">
						<span class="session-micro-label text-highlight">Dotation attendue du matin (Par le Gérant)</span>
						<ul class="dynamic-expected-balances-list">
							{% for bal in balances %}
								<li>
									•
									<span class="js-expected-val" data-currency="{{ bal.currency.code }}">{{ bal.openingBalanceExpected|number_format(2, ',', ' ') }}</span>
									{{ bal.currency.code }}
								</li>
							{% else %}
								<li class="text-danger">Aucune dotation configurée pour ce matin.</li>
							{% endfor %}
						</ul>
						{% if balances|first and balances|first.openingNote %}
							<p class="sub-meta-text mt-10"><strong>Note du gérant :</strong> {{ balances|first.openingNote }}</p>
						{% endif %}
					</div>
				</div>
			</aside>

			{# GAUCHE : LE FORMULAIRE DE COMPTAGE DU TIROIR MULTI-DEVISES #}
			<div class="card">
				<h2>
					<i class="fa-solid fa-calculator"></i>
					Comptage des espèces reçues
				</h2>
				<form action="{{ path('admin_agency_cashier_session_open') }}" method="POST" id="session-open-form">
					<input type="hidden" name="_token" value="{{ csrf_token('open_session_' ~ session.id) }}">

					<div class="field-group mb-15 grid-dynamic-currencies">
						{% for bal in balances %}
							<div class="field">
								<label class="session-micro-label">Espèces physiques en {{ bal.currency.code }} *</label>
								<div class="input-currency-wrapper">
									<input
										type="number"
										name="opening_balances[{{ bal.currency.code }}]"
										class="input-session-field js-declared-input"
										data-currency="{{ bal.currency.code }}"
										placeholder="0.00"
										min="0"
										step="0.01"
										value="{{ bal.openingBalanceExpected }}"
										required
									>
									<span class="currency-badge-suffix">{{ bal.currency.code }}</span>
								</div>
								<span class="sub-meta-text">Comptez les billets physiques reçus en {{ bal.currency.code }}.</span>
							</div>
						{% endfor %}
					</div>

					<div class="field mb-15">
						<label class="session-micro-label">Observations / Notes d'ouverture</label>
						<textarea name="opening_note" class="input-session-field text-area-fixed"
							placeholder="Signalez si des coupures sont trop usées ou si l'enveloppe reçue ne correspond pas..."></textarea>
					</div>

					<div class="block-action-wrapper">
						<button type="submit" class="btn-submit-open text-size-11">
							<i class="fa-solid fa-key"></i>
							Confirmer la dotation & Ouvrir la caisse
						</button>
					</div>
				</form>
			</div>
		</div>

	</div>
{% endblock %}
