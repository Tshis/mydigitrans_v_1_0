{# templates/admin/agency/cashier/session_init.html.twig #}
{% extends "admin/base.html.twig" %}

{% block ux_assets %}{{ importmap('app') }}{% endblock %}

{% block body %}
	<div class="admin-cashier-session-scope container">

		{% for message in app.flashes('error') %}
			<div class="notice-box-danger-dashboard mt-20"><p><i class="fa-solid fa-triangle-exclamation"></i> {{ message }}</p></div>
		{% endfor %}

		{# --- EN-TÊTE DE LA PAGE --- #}
		<header class="header-refined my-30">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_cashier_index') }}" class="agency-back-action" title="Retour au tableau de bord succursale">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<h1>Initialisation de Session de Caisse</h1>
					<p class="subtitle">
						<span class="text-gray text-size-13">Procédure Top-Down</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Allocation de la Dotation Matinale</span>
					</p>
				</div>
			</div>
		</header>

		{# --- STRUCTURE DEUX COLONNES --- #}
		<div class="session-init-container">

			{# GAUCHE : LE FORMULAIRE DE CRÉATION DE LA DOTATION #}
			<div class="card" style="min-width: 0;">
				<h2>
					<i class="fa-solid fa-money-bill-transfer"></i>
					Préparation de l'enveloppe de fonds
				</h2>

				{{ form_start(form, {attr: {'data-turbo': 'false'}}) }}

					{% if form.vars.errors|length > 0 %}
						<div class="notice-box-danger-dashboard mb-15">{{ form_errors(form) }}</div>
					{% endif %}

					<div class="field mb-15">
						{{ form_label(form.cashRegister) }}
						{{ form_widget(form.cashRegister) }}
						<div class="text-danger text-size-12 mt-5">{{ form_errors(form.cashRegister) }}</div>
					</div>

					<div class="field mb-15">
						{{ form_label(form.cashier) }}
						{{ form_widget(form.cashier) }}
						<div class="text-danger text-size-12 mt-5">{{ form_errors(form.cashier) }}</div>
					</div>

					<div class="field-group-dynamic">
						{% for currency in active_currencies %}
							<div class="field mb-15">
								<label class="session-micro-label">Dotation initiale en <strong>{{ currency.code }}</strong></label>
								<div class="input-currency-wrapper">
									<input
										type="number"
										name="amounts[{{ currency.code }}]"
										class="input-session-field"
										placeholder="0.00"
										min="0"
										step="0.01"
										value="0"
									>
									<span class="currency-badge-suffix">{{ currency.code }}</span>
								</div>
								<span class="sub-meta-text">Saisissez le montant physique transféré pour la devise {{ currency.code }} ({{ currency.name }}).</span>
							</div>
						{% else %}
							<p class="alert-text">Aucune devise active configurée pour cette agence.</p>
						{% endfor %}
					</div>

					<div class="field mb-15">
						{{ form_label(form.openingNote) }}
						{{ form_widget(form.openingNote) }}
						<div class="text-danger text-size-12 mt-5">{{ form_errors(form.openingNote) }}</div>
					</div>

					<div class="block-action-wrapper">
						<button type="submit" class="btn-submit-open btn-manager-init">
							<i class="fa-solid fa-paper-plane"></i>
							Allouer les fonds & Envoyer au guichet
						</button>
					</div>

				{{ form_end(form) }}
			</div>

			{# DROITE : PROFIL SÉCURITÉ DU MANAGER CONNECTÉ #}
			<aside class="summary">
				<div class="card summary-sticky-card alert-session-box alert-manager-box">
					<h2>
						<i class="fa-solid fa-user-shield"></i>
						Signature Manager
					</h2>

					<div class="meta-item mb-15">
						<span class="session-micro-label">Manager émetteur</span>
						<strong class="text-dark">{{ actor.fullName }}</strong>
						<span class="sub-meta-text">{{ actor.email }}</span>
					</div>

					<div class="meta-item mb-15">
						<span class="session-micro-label">Gare d'exploitation</span>
						<strong>{{ actor.branch ? actor.branch.name : 'Direction Réseau' }}</strong>
					</div>

					<hr class="summary-divider mb-15">

					<div class="meta-item">
						<span class="sub-meta-text">
							<i class="fa-solid fa-shield-halved"></i>
							Impact sur la Caisse
						</span>
						<span class="sub-meta-text">Cette action initialise l'ouverture d'une session de caisse. Le caissier verra ces chiffres s'afficher dès sa connexion pour confirmation physique.</span>
					</div>
				</div>
			</aside>

		</div>

	</div>
{% endblock %}
