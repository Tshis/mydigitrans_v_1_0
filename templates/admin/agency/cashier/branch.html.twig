{# templates/admin/agency/dashboard/succursale.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
<div class="admin-dashboard-branch-scope container">

	{# --- EN-TÊTE DE LA PAGE DE LA SUCCURSALE --- #}


	{# --- EN-TÊTE DE LA PAGE (Fidèle à votre modèle de voyage) --- #}
	<header class="header mb-20">
		<div class="main-info">
			<a href="#" class="agency-back-action" title="Retour à la supervision générale">
				<i class="fa-solid fa-arrow-left"></i>
			</a>
			<div class="title">
				<h2>
					<i class="fa-solid fa-cash-register"></i>
					Gestion des Caisses & Sessions
				</h2>
				<p>
					Suivi des sessions actives et des guichetiers.
				</p>
			</div>
		</div>
		<div class="admin-bus-layout-add-action-zone">
			<a href="#" class="btn btn-success text-size-12"
				onclick="alert('Action statique : Configuration d\'un nouveau guichet physique');">
				<i class="fa-solid fa-plus"></i>
				Nouveau guichet physique
			</a>
		</div>
	</header>

	{# --- CARTES DE STATISTIQUES COMPTABLES --- #}
	<div class="stats-overview-grid mb-20">
		<div class="stat-card">
			<div class="stat-icon stat-icon--success">
				<i class="fa-solid fa-door-open"></i>
			</div>
			<div class="stat-details">
				<span class="stat-label">Sessions Actives</span>
				<strong class="stat-value">3 Guichets</strong>
			</div>
		</div>

		<div class="stat-card">
			<div class="stat-icon stat-icon--primary">
				<i class="fa-solid fa-vault"></i>
			</div>
			<div class="stat-details">
				<span class="stat-label">Total Espèces Estimé</span>
				<strong class="stat-value text-success">1 875 000 FC</strong>
				<span class="sub-meta-text">+ 450.00 USD</span>
			</div>
		</div>

		<div class="stat-card">
			<div class="stat-icon stat-icon--danger">
				<i class="fa-solid fa-triangle-exclamation"></i>
			</div>
			<div class="stat-details">
				<span class="stat-label">Alertes Écarts Clôture</span>
				<strong class="stat-value text-danger">1 En Attente</strong>
			</div>
		</div>
	</div>

	{# --- REGISTRE DE CONTRÔLE DES CAISSIERS --- #}
	<div class="card monitoring-table-card">
		<h2>
			<i class="fa-solid fa-users-gear"></i>
			Journal des Caissiers / Sessions de Guichet
		</h2>

		<table class="table table-scrollable table-striped">
			<thead>
				<tr>
					<th>Guichetier (Operator)</th>
					<th>N° Session Caisse</th>
					<th>État Session</th>
					<th>Encaissements (CDF)</th>
					<th>Encaissements (USD)</th>
					<th class="text-right">Action</th>
				</tr>
			</thead>


			<tbody>
				{# Caissier 1 : Session ouverte active (Ligne inchangée) #}
				<tr>
					<td>
						<strong>Mputu Antoinette</strong>
						<span class="sub-meta-text">Guichet Principal #1</span>
					</td>
					<td>
						<span class="session-code-text">CS-2026-0712</span>
					</td>
					<td>
						<span class="session-badge active-status">
							OUVERTE
							<p class="text-gray">07h00</p>
						</span>

					</td>
					<td>2 450 000 CDF</td>
					<td>450 USD</td>
					<td class="text-right table-action-buttons">

						<a href="{{ path('admin_agency_finance_journal', {'code': 2}) }}"
							class="table-action-trigger view" title="Auditer le journal en direct (Live)">
							<i class="fa-solid fa-chart-line"></i>
						</a>
					</td>
				</tr>

				{# Caissier 2 : Session CLÔTURÉE -> Intégration directe du bouton d'initialisation #}
				<tr>
					<td>
						<strong>Ilunga Christian</strong>
						<span class="sub-meta-text">Guichet Fret & Colis</span>
					</td>
					<td>
						<span class="session-code-text">CS-2026-0711</span>
					</td>
					<td>
						<span class="session-badge closed-status">
							CLÔTURÉE
							<p class="text-gray">06h00</p>
						</span>
					</td>
					<td>1 600 000 CDF</td>
					<td>500 USD</td>
					<td class="text-right table-action-buttons">
						{# LE BOUTON CLÉ EST ICI : Il remplace l'icône de l'œil pour les caisses fermées #}

						<a href="{{ path('admin_agency_cashier_session_init', {'id': 2}) }}"
							class="table-action-trigger view" title="Initialiser l'ouverture d'une session">
							<i class="fa-solid fa-key"></i>
						</a>
						<a href="{{ path('admin_agency_finance_journal', {'code': 2}) }}"
							class="table-action-trigger view" title="Auditer le journal en direct (Live)">
							<i class="fa-solid fa-chart-line"></i>
						</a>
					</td>
				</tr>

				{# Caissier 3 : Session En Attente -> Intégration directe du bouton d'arbitrage #}
				<tr>
					<td>
						<strong>Ilunga Christian</strong>
						<span class="sub-meta-text">Guichet Fret & Colis</span>
					</td>
					<td>
						<span class="session-code-text">CS-2026-0711</span>
					</td>
					<td>
						<span class="session-badge await-status bage badge-primary">
							A CLOTURER
							<p class="text-gray">06h00</p>
						</span>
					</td>
					<td>1 600 000 CDF</td>
					<td>500 USD</td>
					<td class="text-right table-action-buttons">
						{# LE BOUTON CLÉ EST ICI : Il remplace l'icône de l'œil pour les caisses fermées #}
						<a href="{{ path('admin_agency_cashier_session_closing_validation', {'id': 2}) }}"
							class="table-action-trigger view"
							title="Ouvrir l'inventaire contradictoire et signer la décharge">
							<i class="fa-solid fa-gavel"></i>
						</a>
						<a href="{{ path('admin_agency_finance_journal', {'code': 2}) }}"
							class="table-action-trigger view" title="Auditer le journal en direct (Live)">
							<i class="fa-solid fa-chart-line"></i>
						</a>
					</td>
				</tr>
			</tbody>

		</table>
	</div>

</div>


{% endblock %}