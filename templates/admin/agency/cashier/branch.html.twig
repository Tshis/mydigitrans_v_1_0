{# templates/admin/agency/dashboard/succursale.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div
		class="admin-dashboard-branch-scope container">

		{# --- EN-TÊTE DE LA PAGE DE LA SUCCURSALE --- #}
		<header class="header mb-20">
			<div class="main-info">
				<a href="#" class="agency-back-action" title="Retour à la supervision générale">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<h2>
						<i class="fa-solid fa-cash-register"></i>
						Gestion des Caisses & Sessions
					</h2>
					<p>Suivi des sessions actives et des guichetiers de la succursale.</p>
				</div>
			</div>
			<div class="admin-bus-layout-add-action-zone">
				<a href="{{ path('admin_agency_cashier_add') }}" class="btn btn-success text-size-12">
					<i class="fa-solid fa-plus"></i>
					Nouveau guichet de caisse
				</a>
			</div>
		</header>

		{# --- CARTES DE STATISTIQUES COMPTABLES MULTI-DEVISES --- #}
		<div class="stats-overview-grid mb-20">
			<div class="stat-card">
				<div class="stat-icon stat-icon--success">
					<i class="fa-solid fa-door-open"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Sessions Actives</span>
					<strong class="stat-value">3 Guichets</strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--primary">
					<i class="fa-solid fa-vault"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Fonds Estimés en Caisse</span>
					{# Pile de devises de la succursale locale #}
					<div class="stats-currency-stack">
						<strong class="stat-value text-success">1 875 000 CDF</strong>
						<span class="sub-meta-text">+ 450.00 USD</span>
						<span class="sub-meta-text">+ 120.00 EUR</span>
					</div>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--danger">
					<i class="fa-solid fa-triangle-exclamation"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Alertes Écarts Clôture</span>
					<strong class="stat-value text-danger">1 En Attente</strong>
				</div>
			</div>
		</div>

		{# --- REGISTRE DE CONTRÔLE DES CAISSIERS --- #}
		<div class="card monitoring-table-card">
			<h2>
				<i class="fa-solid fa-users-gear"></i>
				Journal des Caissiers / Sessions de Guichet
			</h2>

			<table class="table table-scrollable table-striped">
				<thead>
					<tr>
						<th>Guichetier (Operator)</th>
						<th>N° Session Caisse</th>
						<th>État Session</th>
						<th>Bilan des Encaissements par Devise</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{# Caissier 1 : Session ouverte active #}
					<tr>
						<td>
							<strong>Mputu Antoinette</strong>
							<span class="sub-meta-text">Guichet Principal #1</span>
						</td>
						<td>
							<span class="session-code-text">CS-2026-0712</span>
						</td>
						<td>
							<span class="session-badge active-status">
								OUVERTE
								<p class="status-time-meta">07h00</p>
							</span>
						</td>
						<td>
							{# Pile dynamique issue de la table CashSessionBalance #}
							<div class="table-balances-stack">
								<div class="balance-item">
									<span class="cur-code">CDF:</span>
									2 450 000 FC</div>
								<div class="balance-item">
									<span class="cur-code">USD:</span>
									450.00 $</div>
							</div>
						</td>
						<td class="text-right table-action-buttons">
							<a href="{{ path('admin_agency_finance_journal', {'code': 2}) }}" class="table-action-trigger view" title="Auditer le journal en direct (Live)">
								<i class="fa-solid fa-chart-line"></i>
							</a>
						</td>
					</tr>

					{# Caissier 2 : Session CLÔTURÉE (Prête pour une ré-initialisation / ré-ouverture) #}
					<tr>
						<td>
							<strong>Ilunga Christian</strong>
							<span class="sub-meta-text">Guichet Fret & Colis</span>
						</td>
						<td>
							<span class="session-code-text">CS-2026-0711</span>
						</td>
						<td>
							<span class="session-badge closed-status">
								CLÔTURÉE
								<p class="status-time-meta">06h00</p>
							</span>
						</td>
						<td>
							<div class="table-balances-stack">
								<div class="balance-item">
									<span class="cur-code">CDF:</span>
									1 600 000 FC</div>
								<div class="balance-item">
									<span class="cur-code">USD:</span>
									500.00 $</div>
								<div class="balance-item">
									<span class="cur-code">EUR:</span>
									70.00 €</div>
							</div>
						</td>
						<td class="text-right table-action-buttons">
							<a href="{{ path('admin_agency_cashier_session_init', {'code': 2}) }}" class="table-action-trigger init" title="Initialiser l'ouverture d'une session (Top-Down)">
								<i class="fa-solid fa-key"></i>
							</a>
							<a href="{{ path('admin_agency_finance_journal', {'code': 2}) }}" class="table-action-trigger view" title="Voir l'historique comptable de ce journal">
								<i class="fa-solid fa-chart-line"></i>
							</a>
						</td>
					</tr>

					{# Caissier 3 : Session En Attente de validation d'arbitrage #}
					<tr>
						<td>
							<strong>Ilunga Christian</strong>
							<span class="sub-meta-text">Guichet Fret & Colis</span>
						</td>
						<td>
							<span class="session-code-text">CS-2026-0711</span>
						</td>
						<td>
							<span class="session-badge await-status">
								A CLOTURER
								<p class="status-time-meta">06h00</p>
							</span>
						</td>
						<td>
							<div class="table-balances-stack">
								<div class="balance-item">
									<span class="cur-code">CDF:</span>
									1 600 000 FC</div>
								<div class="balance-item">
									<span class="cur-code">USD:</span>
									500.00 $</div>
							</div>
						</td>
						<td class="text-right table-action-buttons">
							<a href="{{ path('admin_agency_cashier_session_closing_validation', {'code': 2}) }}" class="table-action-trigger arbitrate" title="Ouvrir l'inventaire contradictoire et arbitrer les écarts">
								<i class="fa-solid fa-gavel"></i>
							</a>
							<a href="{{ path('admin_agency_finance_journal', {'code': 2}) }}" class="table-action-trigger view" title="Auditer le journal des ventes de cette session">
								<i class="fa-solid fa-chart-line"></i>
							</a>
						</td>
					</tr>
				</tbody>
			</table>
		</div>

	</div>
{% endblock %}
