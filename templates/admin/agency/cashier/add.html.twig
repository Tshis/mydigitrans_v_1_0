{# templates/admin/agency/cashier/create_register.html.twig #}
{% extends "admin/base.html.twig" %}

{% block ux_assets %}{{ importmap('app') }}{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/admin/cashier_register_add.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-booking-creation-scope container">

		{% for message in app.flashes('error') %}
			<div class="notice-box-danger-dashboard mt-20"><p><i class="fa-solid fa-triangle-exclamation"></i> {{ message }}</p></div>
		{% endfor %}

		<header class="header-refined my-30">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_cashier_dashboard_branch') }}" class="agency-back-action" title="Retour à la supervision des caisses">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="info">
					<h1>Déclaration d'un Nouveau Guichet de caisse</h1>
					<p class="subtitle">Réseau d'Agences :
						<strong class="text-primary">{{ agency.name }}</strong>
					</p>
				</div>
			</div>
		</header>

		{{ form_start(form, {attr: {class: 'reservation-form', id: 'dynamic-register-form', 'data-turbo': 'false'}}) }}

			{% if form.vars.errors|length > 0 %}
				<div class="notice-box-danger-dashboard mb-20">{{ form_errors(form) }}</div>
			{% endif %}

			<div class="reservation-container">

				{# PANNEAU PRINCIPAL (GAUCHE) #}
				<div class="layout-main-panel" style="min-width: 0;">

					{# Section 1 : Identité technique du terminal #}
					<div class="card mb-20">
						<h2>Fiche technique d'immatriculation</h2>
						<div class="field-group">
							<div class="field">
								{{ form_label(form.name) }}
								{{ form_widget(form.name) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.name) }}</div>
							</div>
							<div class="field">
								{{ form_label(form.code) }}
								{{ form_widget(form.code) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.code) }}</div>
							</div>
						</div>
					</div>

					{# Section 2 : Affectation administrative sécurisée #}
					<div class="card">
						<h2>Affectation administrative</h2>
						<div class="field-group">
							<div class="field">
								{{ form_label(form.branch) }}
								{{ form_widget(form.branch) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.branch) }}</div>
							</div>
						</div>
					</div>
				</div>

				{# COLONNE DE CONTEXTE ET DE SÉCURITÉ STICKY (DROITE) #}
				<aside class="summary">
					<div class="card mb-20">
						<h2>Hardware & Périphériques</h2>
						<div class="field-group">
							<div class="field">
								{{ form_label(form.hardwareNote) }}
								{{ form_widget(form.hardwareNote) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.hardwareNote) }}</div>
							</div>
						</div>
					</div>

					<div class="card summary-sticky-card">
						<h2>Bon d'Activation Guichet</h2>
						<div class="reservation-notice-zone mb-20">
							<p class="notice-title">
								<i class="fa-solid fa-circle-nodes"></i>
								Isolation Logique
							</p>
							<p class="notice-text">Ce terminal collectera les flux financiers de manière étanche sous le compte de la succursale.</p>
						</div>

						<hr class="summary-divider mb-15">

						<ul class="billing-details-list">
							<li>
								<strong>Libellé :</strong>
								<span id="summary-register-name">Non défini</span>
							</li>
							<li>
								<strong>Code technique :</strong>
								<span id="summary-register-code" class="font-code-preview">-</span>
							</li>
							<li>
								<strong>Affectation :</strong>
								<span id="summary-register-branch">Sélectionnée</span>
							</li>
						</ul>

						<div class="total">
							Statut initial :
							<strong id="summary-total-price" class="text-success-mode">ACTIF</strong>
						</div>

						<button type="submit" class="btn btn-primary btn-full mt-20 py-12 btn-submit-activation">
							<i class="fa-solid fa-circle-check"></i>
							Activer & Déployer le Guichet
						</button>
					</div>
				</aside>

			</div>
		{{ form_end(form) }}
	</div>
{% endblock %}
