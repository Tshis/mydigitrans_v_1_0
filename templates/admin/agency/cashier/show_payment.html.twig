{# templates/admin/agency/cashier/show_payment.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div class="admin-cashier-show-scope container">

		{% for message in app.flashes('success') %}
			<div class="notice-box-info mt-20"><p><i class="fa-solid fa-circle-check"></i> {{ message }}</p></div>
		{% endfor %}

		{# --- EN-TÊTE --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_cashier_dashboard') }}" class="agency-back-action" title="Retour">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<h2>Reçu d'Encaissement N° {{ operation.reference }}</h2>
					<p>Transaction archivée le {{ operation.date }} à {{ operation.time }} | Statut :
						<strong class="status-validated">Validé</strong>
					</p>
				</div>
			</div>
			{% if operation.tickets is defined and operation.tickets is not empty %}
				{% for tkNumber in operation.tickets %}
					<a href="{{ path('admin_agency_ticket_print', {'ticketNumber': tkNumber}) }}" target="_blank" class="btn-refined btn-primary-gradient">
						<i class="fa-solid fa-ticket"></i>
						Imprimer le Billet {{ tkNumber }} (PDF)
					</a>
				{% endfor %}
			{% endif %}

		</header>

		<div class="reservation-container">
			<div class="layout-main-panel">
				<div class="card mb-20">
					<h2>
						<i class="fa-solid fa-circle-info"></i>
						Informations de l'Écriture
					</h2>
					<div class="field-group mb-20">
						<div class="field">
							<span class="section-micro-label">Nature du Flux</span>
							<p class="text-dark bold text-success">FLUX ENTRANT (RECETTE)</p>
						</div>
						<div class="field">
							<span class="section-micro-label">Canal & Session</span>
							<p class="text-dark bold text-main">{{ operation.funding_source }}</p>
						</div>
					</div>
					<div class="field-group">
						<div class="field">
							<span class="section-micro-label">Opérateur / Caissier</span>
							<p class="text-main bold">{{ operation.confirmed_by }}</p>
						</div>
						<div class="field">
							<span class="section-micro-label">Succursale</span>
							<p class="text-main bold">{{ operation.branch_name }}</p>
						</div>
					</div>
				</div>
				<div class="card">
					<h2>
						<i class="fa-solid fa-user-check"></i>
						Prestation & Document Lié
					</h2>
					<div class="field-group">
						<div class="field">
							<span class="section-micro-label">Type de prestation</span>
							<p class="text-dark bold text-main">{{ operation.label }}</p>
							<span class="sub-meta-text">{{ operation.description }}</span>
						</div>
						<div class="field">
							<span class="section-micro-label">Référence Document</span>
							<p class="text-dark bold text-main">{{ operation.actor }}</p>
						</div>
					</div>
				</div>
			</div>
			<aside class="summary">
				<div class="card summary-sticky-card">
					<h2>Règlement Encaissé</h2>
					<ul class="billing-details-list">
						<li>
							<strong>Référence pièce :</strong>
							<span class="text-main bold">{{ operation.reference }}</span>
						</li>
						<li>
							<strong>Devise d'encaissement :</strong>
							<span class="text-main bold">{{ operation.currency }}</span>
						</li>
					</ul>
					<hr class="summary-divider mb-15">
					<div class="total">Montant Perçu :
						<strong class="text-success">{{ operation.amount }} {{ operation.currency }}</strong>
					</div>
				</div>
			</aside>
		</div>
	</div>

	{% block javascripts %}
		{{ parent() }}
		{% if app.request.query.get('printTicket') == '1' and operation.tickets is defined and operation.tickets is not empty %}
			<script>
            document.addEventListener('DOMContentLoaded', () => {
                {% for tkNumber in operation.tickets %}
                    window.open("{{ path('admin_agency_ticket_print', {'ticketNumber': tkNumber}) }}", '_blank');
                {% endfor %}
            });
        </script>
		{% endif %}
	{% endblock %}


{% endblock %}
