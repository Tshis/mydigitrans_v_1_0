{# templates/admin/agency/cashier/show_payment.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div
		class="admin-cashier-show-scope container">

		{# --- EN-TÊTE --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_cashier_dashboard') }}" class="agency-back-action" title="Retour">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<h2>Reçu d'Encaissement N° TXN-45920</h2>
					<p>Transaction archivée le 03/08/2026 à 09h42 | Statut :
						<strong class="status-validated">Validé</strong>
					</p>
				</div>
			</div>
			<div class="border-actions-group">
				<button type="button" class="btn btn-action-caisse btn-danger-caisse">
					<i class="fa-solid fa-print"></i>
					Réimprimer</button>
			</div>
		</header>

		<div class="reservation-container">
			<div class="layout-main-panel">
				<div class="card mb-20">
					<h2>
						<i class="fa-solid fa-circle-info"></i>
						Informations de l'Écriture</h2>
					<div class="field-group mb-20">
						<div class="field">
							<span class="section-micro-label">Nature du Flux</span>
							<p class="text-dark bold text-success">FLUX ENTRANT (RECETTE)</p>
						</div>
						<div class="field">
							<span class="section-micro-label">Session Comptable</span>
							<p class="text-dark bold text-main">Session #CS-2026-0712</p>
						</div>
					</div>
					<div class="field-group">
						<div class="field">
							<span class="section-micro-label">Opérateur / Caissier</span>
							<p class="text-main bold">Mputu Antoinette</p>
						</div>
						<div class="field">
							<span class="section-micro-label">Succursale</span>
							<p class="text-main bold">Gare Centrale - Kinshasa</p>
						</div>
					</div>
				</div>
				<div class="card">
					<h2>
						<i class="fa-solid fa-user-check"></i>
						Attribution et Client</h2>
					<div class="field-group">
						<div class="field">
							<span class="section-micro-label">Client / Voyageur</span>
							<p class="text-dark bold text-main">Kabila Dieudonné</p>
							<span class="sub-meta-text">Contact : +243 812 345 678</span>
						</div>
						<div class="field">
							<span class="section-micro-label">Prestation liée</span>
							<p class="text-dark bold text-main">Billet Voyage (VIP)</p>
							<span class="sub-meta-text">Trajet : Kinshasa → Matadi | Siège 01</span>
						</div>
					</div>
				</div>
			</div>
			<aside class="summary">
				<div class="card summary-sticky-card">
					<h2>Règlement Encaissé</h2>
					<ul class="billing-details-list">
						<li>
							<strong>Mode de paiement :</strong>
							<span class="text-main bold">Espèces</span>
						</li>
						<li>
							<strong>Devise d'encaissement :</strong>
							<span class="text-main bold">CDF</span>
						</li>
						<li>
							<strong>Référence pièce :</strong>
							<span class="text-main bold">FAC-2026-0042</span>
						</li>
					</ul>
					<hr class="summary-divider mb-15">
					<div class="total">Montant Perçu :
						<strong class="text-success">40 000 CDF</strong>
					</div>
				</div>
			</aside>
		</div>
	</div>
{% endblock %}
