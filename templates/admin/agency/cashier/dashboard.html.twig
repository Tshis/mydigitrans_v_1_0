{# templates/admin/agency/cashier/dashboard.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-cashier-dashboard-scope container">

		{% for message in app.flashes('success') %}
			<div class="notice-box-info mt-20"><p><i class="fa-solid fa-circle-check"></i> {{ message }}</p></div>
		{% endfor %}

		{% for message in app.flashes('error') %}
			<div class="notice-box-danger-dashboard mt-20"><p><i class="fa-solid fa-triangle-exclamation"></i> {{ message }}</p></div>
		{% endfor %}

		{# --- EN-TÊTE DE LA PAGE --- #}
		<header class="header-refined my-30">
			<div class="header-main-info">
				<div class="info">
					<h1>
						<i class="fa-solid fa-vault"></i>
						Tableau de Bord de la Caisse — {{ session.cashRegister.name }}
					</h1>
					<p class="subtitle">Suivi des soldes physiques en direct, enregistrement des flux et contrôle de session.</p>
				</div>
			</div>
		</header>

		<div class="header mb-30">
			<div class="border-actions-group">
				<a href="{{ path('admin_agency_cashier_payment') }}" class="btn-refined btn-success-gradient">
					<i class="fa-solid fa-cash-register"></i>
					Encaisser un Bon
				</a>
				<a href="{{ path('admin_agency_cashier_expense') }}" class="btn-refined btn-primary-gradient">
					<i class="fa-solid fa-money-bill-transfer"></i>
					Bons de décaissement ({{ pending_expense_count }})
				</a>
				<a href="{{ path('admin_agency_cashier_session_closing') }}" class="btn-refined btn-danger-gradient">
					<i class="fa-solid fa-lock"></i>
					Clôturer la session
				</a>
			</div>
		</div>

		{# --- SOLDE GLOBAL CONSOLIDÉ EN DEVISE DE BASE --- #}
		<div class="stats-overview-grid mb-25">
			<div class="stat-card">
				<div class="stat-icon stat-icon--success">
					<i class="fa-solid fa-vault"></i>
				</div>
				<div class="stat-details">
					<p class="stat-label">Solde Global en Caisse
						<span class="text-primary">({{ balance_summary.baseCode }})</span>
					</p>
					<strong class="stat-value text-success">
						{{ balance_summary.consolidatedFormatted }}
						<small>{{ balance_summary.baseCode }}</small>
					</strong>
				</div>
			</div>

			{# Carte consolidée des dépenses de la session en devise de base #}
			<div class="stat-card">
				<div class="stat-icon stat-icon--danger">
					<i class="fa-solid fa-arrow-trend-down"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Total Sorties ({{ balance_summary.baseCode }})</span>
					<strong class="stat-value text-danger">
						{{ balance_summary.consolidatedOutFormatted }}
						<small>{{ balance_summary.baseCode }}</small>
					</strong>
				</div>
			</div>
		</div>


		{# --- GRAND LIVRE DES FLUX JOURNALIERS UNIFIÉ (FinancialOperation) --- #}
		<div class="card monitoring-table-card">
			<h2>
				<i class="fa-solid fa-list-ol"></i>
				Grand Livre des Flux de la Session
			</h2>
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Heure & Réf</th>
						<th>Direction</th>
						<th>Libellé / Motif</th>
						<th>Opérateur</th>
						<th class="text-right">Montant & Devise</th>
						<th class="text-right">Action</th>
					</tr>
				</thead>
				<tbody>
					{% for op in operations %}
						{% set isIn = op.type.value == 'in' %}
						<tr>
							<td>
								<strong>{{ op.createdAt|date('H\\hi') }}</strong>
								<span class="sub-meta-text">FLX-{{ '%04d'|format(op.id) }}</span>
							</td>
							<td>
								{% if isIn %}
									<span class="cash-badge badge-entry">IN</span>
								{% else %}
									<span class="cash-badge badge-exit">OUT</span>
								{% endif %}
							</td>
							<td>
								<strong>{{ op.description }}</strong>
							</td>
							<td>
								<span class="sub-meta-text">{{ op.createdBy.fullName }}</span>
							</td>
							<td class="text-right {{ isIn ? 'text-success-mode' : 'text-danger-mode' }} font-bold">
								{{ isIn ? '+' : '-' }}{{ op.amount|number_format(2, ',', ' ') }} {{ op.currency.code }}
							</td>
							<td class="text-right table-action-buttons">
								{% if op.referenceType.value == 'agency_payment' %}
									<a href="{{ path('admin_agency_cashier_show_payment', {'id': op.referenceId}) }}" class="table-action-trigger view" title="Voir le reçu">
										<i class="fa-solid fa-eye"></i>
									</a>
								{% elseif op.referenceType.value == 'expense' %}
									<a href="{{ path('admin_agency_cashier_show_expense', {'id': op.referenceId}) }}" class="table-action-trigger view" title="Voir la pièce justificative">
										<i class="fa-solid fa-eye"></i>
									</a>
								{% endif %}
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-muted py-15">Aucune transaction enregistrée sur cette session pour le moment.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

	</div>
{% endblock %}
