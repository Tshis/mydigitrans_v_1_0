{# templates/admin/agency/cashier/dashboard.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div
		class="admin-cashier-dashboard-scope container">

		{# --- EN-TÊTE DE LA PAGE --- #}
		<header class="header mb-25">
			<div class="title">
				<h2>
					<i class="fa-solid fa-vault"></i>
					Tableau de Bord de la Caisse
				</h2>
				<p>Suivi des soldes physiques en direct, enregistrement des flux et contrôle de session.</p>
			</div>
			<div class="border-actions-group">
				<a href="{{ path('admin_agency_cashier_payment') }}" class="btn btn-action-caisse btn-success-caisse">
					<i class="fa-solid fa-cash-register"></i>
					Encaisser un Bon
				</a>
				<a href="{{ path('admin_agency_cashier_expense') }}" class="btn btn-action-caisse btn-primary-caisse">
					<i class="fa-solid fa-money-bill-transfer"></i>
					Bons de décaissement (2)
				</a>
				<a href="{{ path('admin_agency_cashier_session_closing') }}" class="btn btn-action-caisse btn-danger-caisse">
					<i class="fa-solid fa-lock"></i>
					Clôturer la session
				</a>
			</div>
		</header>

		{# --- LES SOLDES DU TIROIR-CAISSE DYNAMIQUE (PAR DEVISE ACTIVE) --- #}
		<div
			class="stats-overview-grid mb-25">
			{# Boucle dynamique sur les soldes réels présents dans le tiroir #}
			{% for balance in vault_balances %}
				<div class="stat-card">
					<div class="stat-icon {% if balance.code == 'CDF' %}stat-icon--success{% else %}stat-icon--primary{% endif %}">
						<i class="fa-solid fa-money-bill-wave"></i>
					</div>
					<div class="stat-details">
						<span class="stat-label">Solde Tiroir
							{{ balance.code }}</span>
						<strong class="stat-value {% if balance.code == 'CDF' %}text-success{% else %}text-primary{% endif %}">
							{{ balance.amount }}
							{{ balance.code }}
						</strong>
					</div>
				</div>
			{% endfor %}

			{# Carte consolidée des dépenses de la journée multi-devises #}
			<div class="stat-card">
				<div class="stat-icon stat-icon--danger">
					<i class="fa-solid fa-arrow-trend-down"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Total Sorties (Ce jour)</span>
					<div class="expenses-currency-stack">
						{% for expense in daily_expenses %}
							<strong class="stat-value text-danger">{{ expense.amount }}
								{{ expense.code }}</strong>
						{% else %}
							<strong class="stat-value text-muted">0.00</strong>
						{% endfor %}
					</div>
				</div>
			</div>
		</div>

		{# --- GRAND LIVRE DES FLUX JOURNALIERS UNIFIÉ (FinancialOperation) --- #}
		<div class="card monitoring-table-card">
			<h2>
				<i class="fa-solid fa-list-ol"></i>
				Grand Livre des Flux du Jour
			</h2>
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Heure & Réf</th>
						<th>Direction</th>
						<th>Libellé / Motif</th>
						<th>Mode de Règlement</th>
						<th class="text-right">Montant & Devise</th>
						<th class="text-right">Action</th>
					</tr>
				</thead>
				<tbody>
					{# Ligne 1 : Flux Entrant #}
					<tr>
						<td>
							<strong>09h42</strong>
							<span class="sub-meta-text">FLX-9834</span>
						</td>
						<td>
							<span class="cash-badge badge-entry">IN</span>
						</td>
						<td>
							<strong>Billet Passager : Mputu Antoinette</strong>
							<span class="sub-meta-text">Réf: RVS-2026-8943 • Kinshasa → Kenge</span>
						</td>
						<td>
							<span class="text-success-mode font-weight-700">Espèces</span>
						</td>
						<td class="text-right text-success-mode font-bold">
							+45 000 CDF
						</td>
						<td class="text-right table-action-buttons">
							<a href="{{ path('admin_agency_cashier_show_payment') }}" class="table-action-trigger view" title="Voir le reçu">
								<i class="fa-solid fa-eye"></i>
							</a>
						</td>
					</tr>

					{# Ligne 2 : Flux Sortant #}
					<tr>
						<td>
							<strong>11h15</strong>
							<span class="sub-meta-text">FLX-9835</span>
						</td>
						<td>
							<span class="cash-badge badge-exit">OUT</span>
						</td>
						<td>
							<strong>Carburant Bus 01 (Marcopolo)</strong>
							<span class="sub-meta-text">Reçu Station Engen #44</span>
						</td>
						<td>
							<span class="text-danger-mode font-weight-700">Espèces</span>
						</td>
						<td class="text-right text-danger-mode font-bold">
							-60 000 CDF
						</td>
						<td class="text-right table-action-buttons">
							<a href="{{ path('admin_agency_cashier_show_expense') }}" class="table-action-trigger view" title="Voir la pièce justificative">
								<i class="fa-solid fa-eye"></i>
							</a>
						</td>
					</tr>
				</tbody>
			</table>
		</div>

	</div>
{% endblock %}
