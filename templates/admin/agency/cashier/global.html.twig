{# templates/admin/agency/cashier/global.html.twig #}
{% extends "admin/base.html.twig" %}

{% block ux_assets %}{{ importmap('app') }}{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
	<script src="/js/admin/modalQuestion.js" defer></script>
{% endblock %}


{% block body %}
	<div class="admin-agency-cashier-dashboard-global-scope container">

		{% for message in app.flashes('success') %}
			<div class="notice-box-info mt-20"><p><i class="fa-solid fa-circle-check"></i> {{ message }}</p></div>
		{% endfor %}

		{% for message in app.flashes('error') %}
			<div class="notice-box-danger-dashboard mt-20"><p><i class="fa-solid fa-triangle-exclamation"></i> {{ message }}</p></div>
		{% endfor %}

		{# --- EN-TÊTE DE NIVEAU DIRECTION GÉNÉRALE --- #}
		<header class="header-refined my-30">
			<div class="header-main-info">
				<div class="info">
					<h1>
						<i class="fa-solid fa-shield-halved"></i>
						Console d'Audit Globale des Caisses
					</h1>
					<p class="subtitle">Supervisez les succursales, consolidez les flux en {{ treasury.baseCode }} et pilotez les écarts du réseau.</p>
				</div>
			</div>
			<div class="right">
				<a href="{{ path('admin_agency_cashier_session_init') }}" class="btn-refined btn-primary-gradient text-size-12">
					<i class="fa-solid fa-key"></i>
					Allouer une dotation
				</a>
				<a href="{{ path('admin_agency_finance_transfers') }}" class="btn-refined btn-primary-gradient text-size-12">
					<i class="fa-solid fa-money-bill-transfer"></i>
					Transferts & Trésorerie
				</a>
				<a href="{{ path('admin_agency_cashier_add') }}" class="btn-refined btn-success-gradient text-size-12">
					<i class="fa-solid fa-plus"></i>
					Immatriculer un guichet réseau
				</a>
			</div>
		</header>

		{# --- CARTES STATISTIQUES CONSOLIDÉES EN DEVISE DE BASE --- #}
		<div class="stats-overview-grid mb-25">
			<div class="stat-card">
				<div class="stat-icon stat-icon--primary">
					<i class="fa-solid fa-cash-register"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Sessions en cours ({{ active_sessions_count }} guichet(s))</span>
					<strong class="stat-value text-primary">{{ treasury.openSessionsFormatted }} <small>{{ treasury.baseCode }}</small></strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--success">
					<i class="fa-solid fa-vault"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Coffre Clôturé Réseau</span>
					<strong class="stat-value text-success">{{ treasury.closedVaultFormatted }} <small>{{ treasury.baseCode }}</small></strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--danger">
					<i class="fa-solid fa-paper-plane"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Transferts Sortants</span>
					<strong class="stat-value text-danger">{{ treasury.outgoingTransfersFormatted }} <small>{{ treasury.baseCode }}</small></strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--success">
					<i class="fa-solid fa-scale-balanced"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Solde Réel Disponible</span>
					<strong class="stat-value text-success">{{ treasury.realAvailableFormatted }} <small>{{ treasury.baseCode }}</small></strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--danger">
					<i class="fa-solid fa-triangle-exclamation"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Sessions à Arbitrer</span>
					<strong class="stat-value text-danger">{{ pending_arbitration_count }} En attente</strong>
				</div>
			</div>
		</div>

		{# --- ZONE DE FILTRES DIRECTIONNELS --- #}
		<div class="trip-filters-card mb-20">
			<form action="{{ path('admin_agency_cashier_dashboard_global') }}" method="GET">
				<div class="field-group">
					<div class="field">
						<label class="admin-bus-layout-add-label">Filtrer par Succursale Réseau</label>
						<select
							class="admin-bus-layout-add-select"
							name="filter_branch"
							placeholder="-- Toutes les succursales --"
							data-controller="symfony--ux-autocomplete--autocomplete"
							data-symfony--ux-autocomplete--autocomplete-tom-select-options-value="{{ {'plugins': ['dropdown_input'], 'allowEmptyOption': true}|json_encode|e('html_attr') }}"
						>
							<option value="">-- Toutes les succursales --</option>
							{% for branch in branches %}
								<option value="{{ branch.id }}" {{ filters.branchId == branch.id ? 'selected' : '' }}>
									{{ branch.name }} ({{ branch.city }})
								</option>
							{% endfor %}
						</select>
					</div>

					<div class="field">
						<label class="admin-bus-layout-add-label">État de Session</label>
						<select name="filter_status" class="admin-bus-layout-add-select">
							<option value="">-- Tous les états --</option>
							<option value="pending" {{ filters.status == 'pending' ? 'selected' : '' }}>En attente d'ouverture (pending)</option>
							<option value="opened" {{ filters.status == 'opened' ? 'selected' : '' }}>En cours de vente (opened)</option>
							<option value="closing_pending" {{ filters.status == 'closing_pending' ? 'selected' : '' }}>À arbitrer (closing_pending)</option>
							<option value="closed" {{ filters.status == 'closed' ? 'selected' : '' }}>Clôturée & Validée (closed)</option>
						</select>
					</div>

					<div class="field">
						<label class="admin-bus-layout-add-label">Recherche libre</label>
						<input
							type="text"
							name="search_query"
							class="admin-bus-layout-add-input"
							placeholder="Code caisse, nom d'agent..."
							value="{{ filters.query }}"
						>
					</div>
				</div>
				<div class="field-button-right mt-10">
					<button type="submit" class="btn btn-dark">
						<i class="fa-solid fa-chart-pie"></i>
						Générer le rapport filtré
					</button>
				</div>
			</form>
		</div>

		{# --- PARC DES GUICHETS DU RÉSEAU --- #}
		<div class="layout-main-card mb-25">
			<div class="card-inner-box table-responsive-wrapper">
				<h2 class="mb-15 text-primary text-size-18"><i class="fa-solid fa-desktop"></i> Guichets Physiques du Réseau ({{ registers|length }})</h2>
				<table class="table table-scrollable table-striped js-datatable">
					<thead>
						<tr>
							<th>Succursale</th>
							<th>Guichet & Code</th>
							<th>Statut Matériel</th>
							<th>Occupation</th>
							<th class="text-right">Action</th>
						</tr>
					</thead>
					<tbody>
						{% for reg in registers %}
							<tr>
								<td><strong>{{ reg.branchName }}</strong></td>
								<td><strong>{{ reg.name }}</strong> <span class="sub-meta-text">({{ reg.code }})</span></td>
								<td>
									<span class="cash-badge {{ reg.isActive ? 'badge-entry' : 'badge-exit' }}">
										{{ reg.isActive ? 'ACTIF' : 'INACTIF' }}
									</span>
								</td>
								<td>
									{% if reg.cashierName %}
										<strong>{{ reg.cashierName }}</strong>
										<span class="sub-meta-text">
											({% if reg.sessionState == 'closing_pending' %}À arbitrer{% elseif reg.sessionState == 'opened' %}En service{% elseif reg.sessionState == 'pending' %}Dotation envoyée{% else %}{{ reg.sessionState }}{% endif %})
										</span>
									{% else %}
										<span class="text-muted">Libre</span>
									{% endif %}
								</td>
								<td class="text-right actions">
									<a
										id="ctaBtn"
										href="javascript:void(0)"
										data-target="{{ path('admin_agency_cashier_register_toggle', {'id': reg.id}) }}"
										class="table-action-btn {{ reg.isActive ? 'bg-mute' : 'bg-success' }}"
										title="{{ reg.isActive ? 'Désactiver ce guichet' : 'Activer ce guichet' }}"
									>
										<i class="fa-solid {{ reg.isActive ? 'fa-ban' : 'fa-circle-check' }}"></i>
									</a>
								</td>
							</tr>
						{% else %}
							<tr><td colspan="5" class="text-center text-muted py-15">Aucun guichet immatriculé.</td></tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

		{# --- REGISTRE CONSOLIDÉ DES FLUX DE SESSIONS --- #}
		<div class="layout-main-card mb-20">
			<div class="card-inner-box table-responsive-wrapper">
				<h2 class="mb-15 text-primary text-size-18"><i class="fa-solid fa-users-gear"></i> Journal des Sessions de Caisse du Réseau</h2>
				<table class="table table-scrollable table-striped js-datatable">
					<thead>
						<tr>
							<th>Succursale</th>
							<th>Guichet de caisse</th>
							<th>Caissier</th>
							<th>Bilan des Encaissements</th>
							<th>Statut</th>
							<th class="text-right">Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for s in sessions %}
							<tr>
								<td>
									<strong>{{ s.branchName }}</strong>
								</td>
								<td>
									<strong>{{ s.registerName }}</strong>
									<span class="sub-meta-text">ID: {{ s.registerCode }}</span>
								</td>
								<td>{{ s.cashierName }}</td>
								<td>
									<div class="table-balances-stack">
										{% for bal in s.balances %}
											<div class="balance-item">
												<span class="cur-code">{{ bal.code }}:</span>
												{{ bal.amount }} {{ bal.code }}
												{% if s.status in ['closing_pending', 'closed'] %}
													<span class="gap-indicator {{ bal.gap < 0 ? 'text-danger-mode font-bold' : 'text-success-mode' }}">
														(Écart: {{ bal.gapFormatted }} {{ bal.code }})
													</span>
												{% endif %}
											</div>
										{% else %}
											<span class="text-muted">0,00</span>
										{% endfor %}
									</div>
								</td>
								<td>
									{% if s.status == 'closed' %}
										<span class="badge-status-validated">
											Clôturée & Validée
											{% if s.validatedByName %}
												<span class="sub-meta-text">Par : {{ s.validatedByName }}</span>
											{% endif %}
										</span>
									{% elseif s.status == 'closing_pending' %}
										<span class="badge-status-closed">À arbitrer</span>
									{% elseif s.status == 'opened' %}
										<span class="badge-status-open">Ouverte</span>
									{% else %}
										<span class="badge-status-open">En attente</span>
									{% endif %}
								</td>
								<td class="text-right actions">
									{% if s.status == 'closing_pending' %}
										<a
											href="{{ path('admin_agency_cashier_session_closing_validation', {'id': s.id}) }}"
											class="btn-gavel-arbitrate"
											title="Super-arbitrage de l'écart financier"
										>
											<i class="fa-solid fa-gavel"></i>
										</a>
									{% endif %}
									<a
										href="{{ path('admin_agency_finance_journal', {'code': s.id}) }}"
										class="table-action-btn bg-mute"
										title="Inspecter le grand livre des opérations"
									>
										<i class="fa-solid fa-eye"></i>
									</a>
								</td>
						{% else %}
							Aucune session trouvée.
						{% endfor %}



						{% include 'admin/partials/_modal.html.twig' %}
{% endblock %}
