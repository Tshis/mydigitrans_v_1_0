{# templates/admin/agency/cashier/show_expense.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div class="admin-cashier-show-expense-scope container">

		{# --- EN-TÊTE --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_cashier_dashboard') }}" class="agency-back-action" title="Retour">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<h2>Pièce de Décaissement N° {{ operation.reference }}</h2>
					<p>Sortie de fonds du {{ operation.date }} à {{ operation.time }} | Statut :
						<strong class="status-declined">Décaissé</strong>
					</p>
				</div>
			</div>
		</header>

		{# --- LAYOUT DEUX COLONNES --- #}
		<div class="reservation-container">
			<div class="layout-main-panel">
				<div class="card mb-20">
					<h2>
						<i class="fa-solid fa-file-invoice"></i>
						Justificatif de la Charge
					</h2>
					<div class="field-group mb-20">
						<div class="field">
							<span class="section-micro-label">Nature du Flux</span>
							<p class="text-danger-mode bold">FLUX SORTANT (CHARGE / DÉPENSE)</p>
						</div>
						<div class="field">
							<span class="section-micro-label">Motif de la dépense</span>
							<p class="text-dark bold">{{ operation.label }}</p>
						</div>
					</div>
					<div class="field-group">
						<div class="field">
							<span class="section-micro-label">Succursale concernée</span>
							<p class="text-dark bold">{{ operation.branch_name }}</p>
						</div>
						<div class="field">
							<span class="section-micro-label">Notes & Références</span>
							<p class="text-dark bold">{{ operation.description }}</p>
						</div>
					</div>
				</div>
			</div>
			<aside class="summary">
				<div class="card summary-sticky-card">
					<h2>Comptabilité Sortie</h2>
					<ul class="billing-details-list">
						<li>
							<strong>Source de fonds :</strong>
							<span class="text-main bold">{{ operation.funding_source }}</span>
						</li>
						<li>
							<strong>Devise décaissée :</strong>
							<span class="text-main bold">{{ operation.currency }}</span>
						</li>
						<li>
							<strong>Ordonné par :</strong>
							<span class="text-main bold">{{ operation.created_by }}</span>
						</li>
						<li>
							<strong>Exécuté par :</strong>
							<span class="text-main bold">{{ operation.confirmed_by }}</span>
						</li>
					</ul>
					<hr class="summary-divider mb-15">
					<div class="total">Montant Sorti :
						<strong class="text-danger-mode">{{ operation.amount }} {{ operation.currency }}</strong>
					</div>
				</div>
			</aside>
		</div>
	</div>
{% endblock %}
