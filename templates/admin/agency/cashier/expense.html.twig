{# templates/admin/agency/cashier/expense.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-cashier-expense-scope container">

		{% for message in app.flashes('success') %}
			<div class="notice-box-info mt-20"><p><i class="fa-solid fa-circle-check"></i> {{ message }}</p></div>
		{% endfor %}

		{% for message in app.flashes('error') %}
			<div class="notice-box-danger-dashboard mt-20"><p><i class="fa-solid fa-triangle-exclamation"></i> {{ message }}</p></div>
		{% endfor %}

		{# --- EN-TÊTE DE LA PAGE --- #}
		<header class="header-refined my-30">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_cashier_dashboard') }}" class="agency-back-action" title="Retour au tableau de bord">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<h1>
						<i class="fa-solid fa-money-bill-transfer"></i>
						Bons de Décaissement à Payer
					</h1>
					<p class="subtitle">Consultez et payez les dépenses opérationnelles validées et ordonnées par votre gérant de succursale.</p>
				</div>
			</div>
		</header>

		{# --- CARTES DES FLUX DISPONIBLES EN DIRECT --- #}
		<div class="stats-overview-grid mb-25">
			<div class="stat-card">
				<div class="stat-icon stat-icon--primary">
					<i class="fa-solid fa-file-signature"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Bons en attente</span>
					<strong class="stat-value text-primary">{{ pending_count }} En attente</strong>
				</div>
			</div>

			{% for bal in balances %}
				<div class="stat-card">
					<div class="stat-icon stat-icon--success">
						<i class="fa-solid fa-wallet"></i>
					</div>
					<div class="stat-details">
						<span class="stat-label">Espèces Dispo ({{ bal.code }})</span>
						<strong class="stat-value text-success">
							{{ bal.formatted }} {{ bal.code }}
						</strong>
					</div>
				</div>
			{% endfor %}
		</div>

		{# --- LISTE DES BONS DE DÉCAISSEMENT EN ATTENTE --- #}
		<div class="card monitoring-table-card">
			<h2>
				<i class="fa-solid fa-clock-rotate-left"></i>
				Ordres de décaissement autorisés par le gérant
			</h2>
			<div class="table-responsive-wrapper">
				<table class="table table-scrollable table-striped js-datatable">
					<thead>
						<tr>
							<th>Réf & Date d'Ordre</th>
							<th>Autorisé Par</th>
							<th>Succursale / Motif</th>
							<th class="text-right">Montant Ordonné</th>
							<th>Statut</th>
							<th class="text-right">Action</th>
						</tr>
					</thead>
					<tbody>
						{% for expense in pending_expenses %}
							<tr>
								<td>
									<strong>EXP-{{ '%04d'|format(expense.id) }}</strong>
									<span class="sub-meta-text">{{ expense.createdAt|date('d/m/Y H\\hi') }}</span>
								</td>
								<td>
									<strong>{{ expense.createdBy.fullName }}</strong>
									<span class="sub-meta-text">{{ expense.createdBy.email }}</span>
								</td>
								<td>
									<strong>{{ expense.name }}</strong>
									<span class="sub-meta-text">{{ expense.branch.name }}{% if expense.description %} — {{ expense.description }}{% endif %}</span>
								</td>
								<td class="text-right font-bold text-danger-mode">
									{{ expense.amount|number_format(2, ',', ' ') }} {{ expense.currency.code }}
								</td>
								<td>
									<span class="cash-badge badge-pending">EN ATTENTE</span>
								</td>
								<td class="text-right table-action-buttons">
									<form method="POST" action="{{ path('admin_agency_cashier_expense_exec', {'id': expense.id}) }}" onsubmit="return confirm('Confirmer le décaissement physique de {{ expense.amount }} {{ expense.currency.code }} ?');">
										<input type="hidden" name="_token" value="{{ csrf_token('exec_expense_' ~ expense.id) }}">
										<button type="submit" class="btn-disburse-trigger">
											<i class="fa-solid fa-money-bill-wave"></i>
											Décaisser le cash
										</button>
									</form>
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="6" class="text-center text-muted py-15">Aucun ordre de décaissement en attente de paiement.</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

	</div>
{% endblock %}
