{# templates/admin/agency/cashier/session_closing_validation.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div class="admin-booking-creation-scope container">

		{% for message in app.flashes('error') %}
			<div class="notice-box-danger-dashboard mt-20"><p><i class="fa-solid fa-triangle-exclamation"></i> {{ message }}</p></div>
		{% endfor %}

		<header class="header-refined mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_cashier_dashboard_branch') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="info">
					<h1>Clôture de Caisse & Arbitrage Comptable</h1>
					<p class="subtitle">Validation contradictoire de la session
						<strong class="text-primary">{{ sessionCode }}</strong>
					</p>
				</div>
			</div>
		</header>

		{{ form_start(form, {attr: {class: 'reservation-form'}}) }}
			<div class="reservation-container">

				{# PANNEAU MAÎTRE (GAUCHE) #}
				<div class="layout-main-panel">
					<div class="card mb-20">
						<h2>Comparatif des Écarts par Devise</h2>

						<div class="dynamic-discrepancy-grid">
							{% set activeBalances = session.balances|filter(b => b.closingBalanceExpected is not null and (b.closingBalanceExpected + 0 > 0 or b.closingBalanceDeclared + 0 > 0)) %}
							{% set displayBalances = activeBalances is not empty ? activeBalances : [session.balances|first] %}
							{% for bal in displayBalances %}

								{% set diff = bal.closingBalanceDifference + 0 %}
								<div class="currency-discrepancy-block mb-15">
									<div class="block-header">
										<h3>Devise de transaction :
											<strong>{{ bal.currency.code }}</strong>
										</h3>
									</div>
									<div class="field-group">
										<div class="field">
											<label>Solde Attendu</label>
											<input
												type="text"
												class="input-readonly font-bold"
												value="{{ (bal.closingBalanceExpected ?? 0)|number_format(2, ',', ' ') }} {{ bal.currency.code }}"
												readonly
											>
										</div>
										<div class="field">
											<label>Solde Déclaré</label>
											<input
												type="text"
												class="input-readonly text-highlight-input"
												value="{{ (bal.closingBalanceDeclared ?? 0)|number_format(2, ',', ' ') }} {{ bal.currency.code }}"
												readonly
											>
										</div>
										<div class="field">
											<label>Écart constaté</label>
											<input
												type="text"
												class="input-readonly {{ diff < 0 ? 'text-danger-mode' : 'text-success-mode' }} font-bold"
												value="{{ diff|number_format(2, ',', ' ') }} {{ bal.currency.code }}"
												readonly
											>
										</div>
									</div>
									{% if bal.closingObservation %}
										<p class="sub-meta-text mt-10"><strong>Note du caissier :</strong> {{ bal.closingObservation }}</p>
									{% endif %}
								</div>
							{% endfor %}
						</div>
					</div>

					{# Décision managériale commune #}
					<div class="card">
						<h2>Rapport d'Arbitrage & Signature du Gérant</h2>
						<div class="field">
							{{ form_label(form.managerConclusion) }}
							{{ form_widget(form.managerConclusion) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.managerConclusion) }}</div>
						</div>
					</div>
				</div>

				{# SIDEBAR DE CONFIRMATION (DROITE) #}
				<aside class="summary">
					<div class="card summary-sticky-card">
						<h2>Validation Définitive</h2>
						<div class="reservation-notice-zone mb-20">
							<p class="notice-title">
								<i class="fa-solid fa-triangle-exclamation"></i>
								Action irréversible
							</p>
							<p class="notice-text">La signature de cette décharge gèle définitivement les écritures comptables de la journée.</p>
						</div>

						<ul class="billing-details-list">
							<li>
								<strong>Guichet :</strong>
								<span>{{ session.cashRegister.name }}</span>
							</li>
							<li>
								<strong>Caissier :</strong>
								<span>{{ session.openedBy.fullName }}</span>
							</li>
							<li>
								<strong>Statut cible :</strong>
								<span class="text-success-mode">Validée</span>
							</li>
						</ul>

						<button type="submit" class="btn btn-primary btn-full mt-20 py-12 btn-sign">
							<i class="fa-solid fa-signature"></i>
							Signer & Clôturer la Session
						</button>
					</div>
				</aside>

			</div>
		{{ form_end(form) }}
	</div>
{% endblock %}
