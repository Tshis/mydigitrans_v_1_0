{# templates/admin/agency/reservation/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-reservations-wrapper container">

		{% for message in app.flashes('success') %}
			<div class="notice-box-info mt-20"><p><i class="fa-solid fa-circle-check"></i> {{ message }}</p></div>
		{% endfor %}

		{# --- EN-TÊTE DE LA PAGE --- #}
		<header class="header-refined my-30">
			<div class="header-left">
				<div class="breadcrumb-mini">
					<span>OPÉRATIONS</span>
					<i class="fa-solid fa-chevron-right"></i>
					<strong>BILLETTERIE</strong>
				</div>
				<h1>
					<i class="fa-solid fa-file-circle-check"></i>
					Gestion des Billets & Réservations
				</h1>
				<p class="subtitle">Suivez les ventes, filtrez les réservations et gérez les paiements voyageurs.</p>
			</div>
		</header>

		{# --- CARTES DE STATISTIQUES DE BILLETTERIE --- #}
		<div class="stats-overview-grid">
			<div class="stat-card">
				<div class="stat-icon stat-icon--success">
					<i class="fa-solid fa-ticket"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Confirmées (Payées)</span>
					<strong class="stat-value">{{ stats.confirmed }}</strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--primary">
					<i class="fa-solid fa-hourglass-half"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">En attente (Réservées)</span>
					<strong class="stat-value">{{ stats.pending }}</strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--danger">
					<i class="fa-solid fa-ban"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Annulées / Expirées</span>
					<strong class="stat-value">{{ stats.cancelled }}</strong>
				</div>
			</div>
		</div>

		{# --- ZONE DE FILTRES AVANCÉS --- #}
		<div class="trip-filters-card mb-20">
			<form action="{{ path('admin_agency_reservation_index') }}" method="GET" class="field-group">
				<div class="field">
					<label class="admin-bus-layout-add-label">Référence / Téléphone / Nom</label>
					<input type="text" name="search_query" class="admin-bus-layout-add-input" placeholder="Ex: RSV-MDT-..." value="{{ filters.query }}">
				</div>
				<div class="field">
					<label class="admin-bus-layout-add-label">Statut</label>
					<select name="ticket_status" class="admin-bus-layout-add-select">
						<option value="">-- Tous les statuts --</option>
						<option value="paid" {{ filters.status == 'paid' ? 'selected' : '' }}>Confirmé (Payé)</option>
						<option value="pending" {{ filters.status == 'pending' ? 'selected' : '' }}>En attente (Réservé)</option>
						<option value="cancelled" {{ filters.status == 'cancelled' ? 'selected' : '' }}>Annulé</option>
						<option value="expired" {{ filters.status == 'expired' ? 'selected' : '' }}>Expiré</option>
					</select>
				</div>
				<div class="field">
					<label class="admin-bus-layout-add-label">Ligne Commerciale</label>
					<select name="route_filter" class="admin-bus-layout-add-select">
						<option value="">-- Toutes les lignes --</option>
						{% for route in routes %}
							<option value="{{ route.id }}" {{ filters.routeId == route.id ? 'selected' : '' }}>{{ route.name }}</option>
						{% endfor %}
					</select>
				</div>
				<div class="field-actions">
					<button type="submit" class="btn btn-reset">
						<i class="fa-solid fa-filter"></i>
						Filtrer
					</button>
				</div>
			</form>
		</div>

		{# --- TABLEAU DES RÉSERVATIONS --- #}
		<div class="table-responsive-wrapper">
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Référence</th>
						<th>Voyageur & Contact</th>
						<th>Voyage / Trajet</th>
						<th>Siège & Catégorie</th>
						<th>Montant</th>
						<th>Statut</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for res in reservations %}
						<tr>
							<td>
								<strong>{{ res.reference }}</strong>
								<span class="sub-meta-text">{{ res.sourceLabel }}</span>
							</td>
							<td>
								<strong>{{ res.passengerName }}</strong>
								<span class="sub-meta-text">{{ res.passengerPhone }}</span>
							</td>
							<td>
								<strong>{{ res.departureDate|date('d/m/Y') }} à {{ res.departureTime }}</strong>
								<span class="sub-meta-text">{{ res.segment }}</span>
							</td>
							<td>
								<strong>Siège {{ res.seats }}</strong>
								<span class="sub-meta-text">{{ res.category }}</span>
							</td>
							<td>
								<strong>{{ res.amountFormatted }}</strong>
							</td>
							<td class="table-badge-cell">
								{% if res.status == 'paid' %}
									<span class="badge-status-confirmed">{{ res.statusLabel }}</span>
								{% elseif res.status == 'pending' %}
									<span class="badge-status-pending">{{ res.statusLabel }}</span>
								{% else %}
									<span class="badge-status-danger">{{ res.statusLabel }}</span>
								{% endif %}
							</td>
							<td class="text-right table-action-buttons">
								<a href="{{ path('admin_agency_reservation_show', {'reference': res.reference}) }}" class="table-action-trigger view" title="Voir les détails">
									<i class="fa-solid fa-eye"></i>
								</a>
								<a href="{{ path('admin_agency_reservation_print_voucher', {'reference': res.reference}) }}" class="table-action-trigger print" title="Imprimer le bon" target="_blank">
									<i class="fa-solid fa-print"></i>
								</a>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="7" class="text-center text-gray italic padding-20">
								Aucune réservation enregistrée pour le moment.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

	</div>
{% endblock %}
