{# templates/admin/agency/role/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div
		class="admin-agency-role-index-scope container">
		{# --- HEADER DE LA CONSOLE --- #}
		<header class="header-refined mb-30">
			<div class="header-left">
				<div class="breadcrumb-mini">
					<span>Organigramme</span>
					<i class="fa-solid fa-chevron-right"></i>
					<strong>Postes & Fonctions</strong>
				</div>
				<h1>Structure des Postes</h1>
				<p class="subtitle">Définissez les fonctions de votre personnel et configurez leurs accès granulaires [MCD 4].</p>
			</div>
			<div class="header-right">
				<a href="{{ path('admin_agency_role_add') }}" class="btn-refined btn-primary-gradient">
					<i class="fa-solid fa-plus-circle"></i>
					<span>Créer une fonction</span>
				</a>
			</div>
		</header>

		{# --- LE TABLEAU STRICT ET CONFORME (TA STRUCTURE TEXTUELLE REPRISE) --- #}
		<div class="table-responsive-wrapper">
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Intitulé de la fonction</th>
						<th>Description du Poste</th>
						<th class="text-center">Status</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for role in roles %}
						<tr>
							<td>
								<div class="job-title-cell">
									<i class="fa-solid fa-briefcase text-gray"></i>
									<strong>{{ role.name }}</strong>
								</div>
							</td>
							<td>
								{{ role.description|default('Aucune description métier enregistrée.') }}
							</td>
							<td class="text-center">
								<span class="pill-role-status {{ role.isActive ? 'active' : 'inactive' }}">
									{{ role.isActive ? 'Actif' : 'Désactivé' }}
								</span>
							</td>
							<td class="text-right">
								<div class="action-group-refined">
									{% if role.scope == 'agency' %}
										<a href="{{ path('admin_agency_role_edit', {code: role.code}) }}" class="action-link config" title="Modifier l'intitulé et les droits">
											<i class="fa-solid fa-user-gear"></i>
										</a>
									{% else %}
										<span class="action-link text-disabled" title="Rôle système non modifiable">
											<i class="fa-solid fa-lock"></i>
										</span>
									{% endif %}
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-gray italic padding-20">
								Aucune fonction configurée pour le moment.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
