{# templates/admin/agency/role/form.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div
		class="admin-agency-role-form-scope container">
		{# --- HEADER DYNAMIQUE --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_role_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Organigramme</span>
						<span class="arrow-divider">•</span>
						<span class="text-gray text-size-13 text-highlight">
							{{ isEdit ? 'Habilitations [MCD 4]' : 'Nouveau Poste [MCD 4]' }}
						</span>
					</div>
					<h1 class="mt-5">{{ isEdit ? 'Modifier la Fonction' : 'Créer un Poste / Fonction' }}</h1>
				</div>
			</div>
			<div class="header-actions">
				<button type="submit" form="role-master-form" class="btn btn-success">
					<i class="fa-solid fa-floppy-disk"></i>
					<span>Enregistrer la fonction</span>
				</button>
			</div>
		</header>

		{# --- FORMULAIRE UNIQUE ET ETANCHE --- #}
		<form id="role-master-form" action="#" method="POST" class="role-form-layout">
			<div
				class="role-container-grid">

				{# COLONNE GAUCHE : DÉFINITION ET MATRICE DE BOUTONS RADIOS TEXTUELLE #}
				<div
					class="main-form-panel">

					{# PARAMÈTRES DU POSTE #}
					<div class="card control-card mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-id-card-clip text-primary"></i>
							Définition Commerciale</h2>
						<div class="direct-pricing-row">
							<div class="field">
								<label class="admin-bus-layout-add-label">Intitulé du poste pour l'agence *</label>
								<input type="text" name="name" class="admin-bus-layout-add-input" value="{{ isEdit ? role.name : '' }}" placeholder="Ex: Guichetier de Nuit, Percepteur Fret, Dispatcher..." required>
							</div>
							<div class="field">
								<label class="admin-bus-layout-add-label">Description courte des attributions</label>
								<input type="text" name="description" class="admin-bus-layout-add-input" value="{{ isEdit ? role.description : '' }}" placeholder="Ex: En charge de l'encaissement et de la validation des colis au départ...">
							</div>
						</div>
					</div>

					{# TA MATRICE TEXTUELLE DE BOUTONS RADIOS REPRISE #}
					<div class="agency-permission-card">
						<div class="agency-card-topbar">
							<div>
								<h3 class="agency-card-heading">Permissions Granulaires : Gestion des flux</h3>
								<p class="agency-card-subheading">Ajustez les privilèges d'exécution de ce poste sur chaque segment métier de la succursale.</p>
							</div>
						</div>

						<div class="responsive-permission-table">
							<table class="agency-permission-table">
								<thead>
									<tr>
										<th>Module du Menu & Droits Métiers</th>
										<th class="column-radio-center">Aucun Accès</th>
										<th class="column-radio-center">Lecture Seule</th>
										<th class="column-radio-center">Écriture Seule</th>
										<th class="column-radio-center">Lecture / Écriture</th>
									</tr>
								</thead>
								<tbody>
									{% for module in modules %}
										<tr class="agency-permission-row">
											<td>
												<div class="agency-feature-description">
													<span class="module-icon-inline">
														<i class="fa-solid {{ module.icon }}"></i>
													</span>
													<strong>{{ module.label }}</strong>
													<p>{{ module.description }}</p>
												</div>
											</td>
											<td class="column-radio-center">
												<input type="radio" name="perms[{{ module.key }}]" value="none" class="agency-custom-radio" {% if not isEdit or module.value == 'none' %} checked {% endif %}>
											</td>
											<td class="column-radio-center">
												<input type="radio" name="perms[{{ module.key }}]" value="read" class="agency-custom-radio" {% if isEdit and module.value == 'read' %} checked {% endif %}>
											</td>
											<td class="column-radio-center">
												<input type="radio" name="perms[{{ module.key }}]" value="write" class="agency-custom-radio" {% if isEdit and module.value == 'write' %} checked {% endif %}>
											</td>
											<td class="column-radio-center">
												<input type="radio" name="perms[{{ module.key }}]" value="read_write" class="agency-custom-radio" {% if isEdit and module.value == 'read_write' %} checked {% endif %}>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>
				</div>

				{# COLONNE DROITE : SÉCURITÉ & AUDIT #}
				<aside class="sidebar-action-panel">
					<div class="card control-card mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-gears text-primary"></i>
							Statut d'Habilitation</h2>
						<div class="field">
							<label class="admin-bus-layout-add-label">État du poste</label>
							<select name="is_active" class="admin-bus-layout-add-select" required>
								<option value="1" {% if not isEdit or role.isActive %} selected {% endif %}>Actif (Sélectionnable pour le personnel)</option>
								<option value="0" {% if isEdit and not role.isActive %} selected {% endif %}>Inactif (Désactivé temporairement)</option>
							</select>
						</div>
					</div>


				</aside>

			</div>
		</form>
	</div>
{% endblock %}
