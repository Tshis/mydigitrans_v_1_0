{# templates/admin/agency/shipment/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-shipment-wrapper container">

		{% for message in app.flashes('success') %}
			<div class="notice-box-info mt-20"><p><i class="fa-solid fa-circle-check"></i> {{ message }}</p></div>
		{% endfor %}

		{# --- EN-TÊTE DE LA PAGE --- #}
		<header class="header-refined my-30">
			<div class="header-left">
				<div class="breadcrumb-mini">
					<span>Logistique</span>
					<i class="fa-solid fa-chevron-right"></i>
					<strong>Gestion des colis</strong>
				</div>
				<h1>
					<i class="fa-solid fa-box-open"></i>
					Registre de Suivi du Fret & Colis
				</h1>
				<p class="subtitle">Enregistrez les dépôts, attribuez les colis aux trajets et suivez les livraisons.</p>
			</div>
			<div class="header-right">
				{% if is_granted('shipment.write') %}
					<a href="{{ path('admin_agency_shipment_add') }}" class="btn-refined btn-success-gradient">
						<i class="fa-solid fa-plus"></i>
						Enregistrer un colis
					</a>
				{% endif %}
			</div>
		</header>

		{# --- CARTES DE STATISTIQUES DE FRET --- #}
		<div class="stats-overview-grid">
			<div class="stat-card">
				<div class="stat-icon stat-icon--primary">
					<i class="fa-solid fa-warehouse"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">En Entrepôt / Attente Retrait</span>
					<strong class="stat-value">{{ stats.warehouse }}</strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--success">
					<i class="fa-solid fa-truck-ramp-box"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">En Transit (Dans le bus)</span>
					<strong class="stat-value">{{ stats.in_transit }}</strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--danger">
					<i class="fa-solid fa-circle-check"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Livrés / Retirés</span>
					<strong class="stat-value">{{ stats.delivered }}</strong>
				</div>
			</div>
		</div>

		{# --- ZONE DE FILTRES AVANCÉS DU BACKOFFICE --- #}
		<div class="trip-filters-card mb-20">
			<form action="{{ path('admin_agency_shipment_index') }}" method="GET" class="field-group">
				<div class="field">
					<label class="admin-bus-layout-add-label">Code Suivi / Téléphone</label>
					<input
						type="text"
						name="search_query"
						class="admin-bus-layout-add-input"
						placeholder="Ex: SHP-2611-..."
						value="{{ filters.query }}"
					>
				</div>
				<div class="field">
					<label class="admin-bus-layout-add-label">État du Colis</label>
					<select name="shipment_status" class="admin-bus-layout-add-select">
						<option value="">-- Tous les états actifs --</option>
						<option value="pending" {{ filters.status == 'pending' ? 'selected' : '' }}>En attente (Non payé)</option>
						<option value="in_transit" {{ filters.status == 'in_transit' ? 'selected' : '' }}>En Transit</option>
						<option value="ready_for_pickup" {{ filters.status == 'ready_for_pickup' ? 'selected' : '' }}>Disponible Terminus</option>
						<option value="delivered" {{ filters.status == 'delivered' ? 'selected' : '' }}>Livré / Retiré</option>
						<option value="cancelled" {{ filters.status == 'cancelled' ? 'selected' : '' }}>Annulé</option>
					</select>
				</div>
				<div class="field-actions">
					<button type="submit" class="btn btn-reset">
						<i class="fa-solid fa-filter"></i>
						Filtrer
					</button>
				</div>
			</form>
		</div>

		{# --- TABLEAU DES COLIS --- #}
		<div class="table-responsive-wrapper">
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Code Suivi</th>
						<th>Expéditeur (Sender)</th>
						<th>Destinataire (Receiver)</th>
						<th>Caractéristiques</th>
						<th>Paiement Fret</th>
						<th>État Logistique</th>
						<th class="text-right">Actions Guichet</th>
					</tr>
				</thead>
				<tbody>
					{% for shp in shipments %}
						<tr>
							<td>
								<strong>{{ shp.reference }}</strong>
								<span class="sub-meta-text">{{ shp.departureBranch }} → {{ shp.arrivalBranch }}</span>
							</td>
							<td>
								<strong>{{ shp.senderName }}</strong>
								<span class="sub-meta-text">{{ shp.senderPhone }}</span>
							</td>
							<td>
								<strong>{{ shp.receiverName }}</strong>
								<span class="sub-meta-text">{{ shp.receiverPhone }}</span>
							</td>
							<td>
								<strong>{{ shp.description }}</strong>
								<span class="sub-meta-text">Poids : {{ shp.weight }} Kg ({{ shp.nature }})</span>
							</td>
							<td>
								<strong>{{ shp.amountFormatted }}</strong>
								{% if shp.isPaid %}
									<span class="sub-meta-text text-weight-700 text-success">PAYÉ (Caisse)</span>
								{% else %}
									<span class="sub-meta-text text-weight-700 text-danger">NON ACQUITTÉ</span>
								{% endif %}
							</td>
							<td class="table-badge-cell">
								{% if shp.status == 'delivered' %}
									<span class="badge badge-success-status">{{ shp.statusLabel }}</span>
								{% elseif shp.status == 'ready_for_pickup' %}
									<span class="badge-shipment ready">{{ shp.statusLabel }}</span>
								{% elseif shp.status == 'in_transit' %}
									<span class="badge-shipment transit">{{ shp.statusLabel }}</span>
								{% elseif shp.status == 'pending' %}
									<span class="badge-status-pending">{{ shp.statusLabel }}</span>
								{% else %}
									<span class="badge badge-danger-status">{{ shp.statusLabel }}</span>
								{% endif %}
							</td>
							<td class="text-right table-action-buttons">
								{% if shp.status not in ['delivered', 'cancelled'] %}
									{% if is_granted('shipment.write') and shp.status in ['in_transit', 'ready_for_pickup'] and shp.isPaid %}
										<a
											href="{{ path('admin_agency_shipment_pickup', {'reference': shp.reference}) }}"
											class="table-action-trigger validate"
											title="Confirmer le retrait physique par le destinataire"
										>
											<i class="fa-solid fa-box-open"></i>
										</a>
									{% endif %}
									
									{% if not shp.isPaid %}
										<a
											href="{{ path('admin_agency_cashier_payment', {'ref': shp.reference}) }}"
											class="table-action-trigger validate"
											title="Confirmer le retrait physique par le destinataire"
										>
											<i class="fa-solid fa-money-bill-transfer"></i>
										</a>
									{% endif %}

									<a
										href="{{ path('admin_agency_shipment_print', {'reference': shp.reference}) }}"
										class="table-action-trigger print"
										title="Imprimer le reçu / étiquette"
										target="_blank"
									>
										<i class="fa-solid fa-tag"></i>
									</a>
								{% endif %}
								<a
									href="{{ path('admin_agency_shipment_show', {'reference': shp.reference}) }}"
									class="table-action-trigger view"
									title="Voir le dossier du colis"
								>
									<i class="fa-solid fa-eye"></i>
								</a>
							</td>

						</tr>
					{% else %}
						<tr>
							<td colspan="7" class="text-center text-gray italic padding-20">
								Aucune expédition enregistrée pour le moment.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

	</div>
{% endblock %}
