{# templates/admin/agency/shipment/add.html.twig #}
{% extends "admin/base.html.twig" %}

{% block ux_assets %}{{ importmap('app') }}{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/admin/shipment_add.js" defer></script>
{% endblock %}

{% block body %}


	<div class="admin-shipment-creation-scope container">

		{% for message in app.flashes('error') %}
			<div class="notice-box-danger-dashboard mt-20"><p><i class="fa-solid fa-triangle-exclamation"></i> {{ message }}</p></div>
		{% endfor %}

		{# --- EN-TÊTE --- #}
		<header class="header mb-25">
			<a href="{{ path('admin_agency_shipment_index') }}" class="agency-back-action" title="Retour au registre">
				<i class="fa-solid fa-arrow-left"></i>
			</a>
			<div class="title">
				<h2>Enregistrement de Fret & Colis</h2>
				<p>Enregistrez et tarifez la marchandise selon les règles d'encaissement du réseau.</p>
			</div>
		</header>

		{{ form_start(form, {
			attr: {
				class: 'reservation-form',
				id: 'dynamic-shipment-form',
				'data-turbo': 'false',
				'data-trips-meta': trips_meta|json_encode,
				'data-base-currency': base_currency
			}
		}) }}

		{% if form.vars.errors|length > 0 %}
			<div class="notice-box-danger-dashboard mb-20">{{ form_errors(form) }}</div>
		{% endif %}

		<div class="reservation-container">

			{# COLONNE GAUCHE #}
			<div class="layout-main-panel">

				<div class="card mb-20">
					<h2><i class="fa-solid fa-route"></i> Voyage, Succursales & Arrêts</h2>

					<div class="field mb-15">
						{{ form_label(form.trip) }}
						{{ form_widget(form.trip) }}
						<div class="text-danger text-size-12 mt-5">{{ form_errors(form.trip) }}</div>
					</div>

					<div class="field-group mb-15">
						<div class="field">
							{{ form_label(form.departureAgencyBranch) }}
							{{ form_widget(form.departureAgencyBranch) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.departureAgencyBranch) }}</div>
						</div>
						<div class="field">
							{{ form_label(form.arrivalAgencyBranch) }}
							{{ form_widget(form.arrivalAgencyBranch) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.arrivalAgencyBranch) }}</div>
						</div>
					</div>

					<div class="field-group mb-15">
						<div class="field">
							{{ form_label(form.departureStop) }}
							{{ form_widget(form.departureStop) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.departureStop) }}</div>
						</div>
						<div class="field">
							{{ form_label(form.arrivalStop) }}
							{{ form_widget(form.arrivalStop) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.arrivalStop) }}</div>
						</div>
					</div>
				</div>

				<div class="card mb-20">
					<h2><i class="fa-solid fa-id-card"></i> Acteurs du Fret</h2>

					<div class="field-group mb-15">
						<div class="field">
							{{ form_label(form.senderName) }}
							{{ form_widget(form.senderName) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.senderName) }}</div>
						</div>
						<div class="field">
							{{ form_label(form.senderPhone) }}
							{{ form_widget(form.senderPhone) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.senderPhone) }}</div>
						</div>
					</div>

					<hr class="summary-divider mb-15">

					<div class="field-group">
						<div class="field">
							{{ form_label(form.receiverName) }}
							{{ form_widget(form.receiverName) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.receiverName) }}</div>
						</div>
						<div class="field">
							{{ form_label(form.receiverPhone) }}
							{{ form_widget(form.receiverPhone) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.receiverPhone) }}</div>
						</div>
					</div>
				</div>

				<div class="card">
					<h2><i class="fa-solid fa-boxes-stacked"></i> Caractéristiques & Nature Logistique</h2>

					<div class="field mb-15">
						{{ form_label(form.description) }}
						{{ form_widget(form.description) }}
						<div class="text-danger text-size-12 mt-5">{{ form_errors(form.description) }}</div>
					</div>

					<div class="field-group mb-15">
						<div class="field">
							{{ form_label(form.nature) }}
							{{ form_widget(form.nature) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.nature) }}</div>
						</div>
						<div class="field">
							{{ form_label(form.billingType) }}
							{{ form_widget(form.billingType) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.billingType) }}</div>
						</div>
					</div>

					<div class="field-group">
						<div class="field" id="weight-input-block">
							{{ form_label(form.weight) }}
							<div class="input-unit-wrapper">
								{{ form_widget(form.weight) }}
								<span class="unit-badge">Kg</span>
							</div>
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.weight) }}</div>
						</div>

						<div class="field-group is-hidden flex-double" id="unit-manual-block">
							<div class="field">
								{{ form_label(form.priceManual) }}
								{{ form_widget(form.priceManual) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.priceManual) }}</div>
							</div>
							<div class="field flex-narrow">
								{{ form_label(form.currencyManual) }}
								{{ form_widget(form.currencyManual) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.currencyManual) }}</div>
							</div>
						</div>
					</div>
				</div>

			</div>

			{# COLONNE DROITE #}
			<aside class="summary">
				<div class="card summary-sticky-card">
					<h2>Ticket d'enregistrement</h2>

					<div class="reservation-notice-zone mb-20">
						<p class="notice-title">
							<i class="fa-solid fa-boxes-packing"></i> Statut initial : Pending
						</p>
						<p class="notice-text">Le colis est enregistré avec le statut <strong>Pending</strong>. Le paiement devra être acquitté au guichet pour validation du chargement.</p>
					</div>

					<hr class="summary-divider mb-15">

					<ul class="billing-details-list">
						<li>
							<span class="billing-item-label">Type Facturation :</span>
							<strong id="summary-billing-mode">Au Kg</strong>
						</li>
						<li>
							<span class="billing-item-label">Tarif unitaire :</span>
							<strong id="summary-unit-fare">0.00</strong>
						</li>
					</ul>

					<div class="total-fret-box mt-15">
						<span class="total-label">Prix Total :</span>
						<strong id="summary-total-price" class="total-amount-display">0.00 {{ base_currency }}</strong>
					</div>

					<button type="submit" class="btn btn-primary btn-full mt-20">
						<i class="fa-solid fa-file-shield"></i>
						Générer l'Expédition
					</button>
				</div>
			</aside>

		</div>

		{{ form_end(form) }}
	</div>
	
{% endblock %}
