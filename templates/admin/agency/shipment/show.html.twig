{# templates/admin/agency/shipment/show.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div class="admin-shipment-show-scope container">

		{% for message in app.flashes('success') %}
			<div class="notice-box-info mt-20"><p><i class="fa-solid fa-circle-check"></i> {{ message }}</p></div>
		{% endfor %}

		{% for message in app.flashes('error') %}
			<div class="notice-box-danger-dashboard mt-20"><p><i class="fa-solid fa-triangle-exclamation"></i> {{ message }}</p></div>
		{% endfor %}

		{# --- EN-TÊTE DE LA PAGE --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_shipment_index') }}" class="agency-back-action" title="Retour au registre">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<h2>Bordereau d'Expédition N° {{ shipment.reference }}</h2>
					<div class="mt-5 sub-header-flex">
						{% if shipment.status == 'delivered' %}
							<span class="badge badge-success-status">{{ shipment.statusLabel }}</span>
						{% elseif shipment.status == 'ready_for_pickup' %}
							<span class="badge-shipment ready">{{ shipment.statusLabel }}</span>
						{% elseif shipment.status == 'in_transit' %}
							<span class="badge-shipment transit">{{ shipment.statusLabel }}</span>
						{% elseif shipment.status == 'pending' %}
							<span class="badge-status-pending">{{ shipment.statusLabel }}</span>
						{% else %}
							<span class="badge badge-danger-status">{{ shipment.statusLabel }}</span>
						{% endif %}
						<span class="text-gray text-size-13">Enregistré par : {{ shipment.issuerLabel }}</span>
					</div>
				</div>
			</div>
			<div class="admin-action-zone">
				<a href="{{ path('admin_agency_shipment_print', {'reference': shipment.reference}) }}" class="btn-refined btn-dark-gradient text-center" target="_blank">
					<i class="fa-solid fa-tag"></i>
					Imprimer les Pièces Fret
				</a>
			</div>
		</header>

		{# --- LAYOUT DEUX COLONNES RESPONSIVE --- #}
		<div class="shipment-details-layout">

			{# COLONNE GAUCHE #}
			<div class="layout-main-panel">

				<div class="detail-card-box mb-20">
					<h3 class="box-title">
						<i class="fa-solid fa-people-arrows"></i>
						Acteurs du Transit
					</h3>
					<div class="info-grid-details">
						<div class="info-item">
							<span class="info-label">Expéditeur (Sender)</span>
							<p class="info-value">{{ shipment.senderName }}</p>
							<span class="sub-meta-text">{{ shipment.senderPhone }}</span>
						</div>
						<div class="info-item">
							<span class="info-label">Destinataire (Receiver)</span>
							<p class="info-value">{{ shipment.receiverName }}</p>
							<span class="sub-meta-text">{{ shipment.receiverPhone }}</span>
						</div>
					</div>
				</div>

				<div class="detail-card-box">
					<h3 class="box-title">
						<i class="fa-solid fa-box-open"></i>
						Spécifications Fret
					</h3>
					<div class="info-grid-details">
						<div class="info-item">
							<span class="info-label">Contenu déclaré</span>
							<p class="info-value">{{ shipment.description }}</p>
						</div>
						<div class="info-item">
							<span class="info-label">Nature de la marchandise</span>
							<p class="info-value">{{ shipment.nature }}</p>
						</div>
						<div class="info-item">
							<span class="info-label">Poids Facturé</span>
							<p class="info-value">{{ shipment.weight }} Kg</p>
						</div>
						<div class="info-item">
							<span class="info-label">Bus de transport</span>
							<p class="info-value">{{ shipment.tripLabel }}</p>
						</div>
						<div class="info-item">
							<span class="info-label">Trajet & Gares</span>
							<p class="info-value">{{ shipment.route }} ({{ shipment.departureBranch }} → {{ shipment.arrivalBranch }})</p>
						</div>
						{% if shipment.receiverIdCardNumber %}
							<div class="info-item">
								<span class="info-label">Décharge / Pièce d'identité</span>
								<p class="info-value text-success">{{ shipment.receiverIdCardNumber }}</p>
							</div>
						{% endif %}
					</div>
				</div>

			</div>

			{# COLONNE DROITE #}
			<aside class="layout-sidebar-panel">

				<div class="detail-card-box text-center mb-20 highlight-finance-box">
					<span class="info-label">MONTANT DU FRET</span>
					<div class="price-badge-display">{{ shipment.price|number_format(2, ',', ' ') }} {{ shipment.currency }}</div>
					{% if shipment.isPaid %}
						<span class="payment-status-label paid">ACQUITTÉ</span>
					{% else %}
						<span class="payment-status-label unpaid">NON ACQUITTÉ</span>
					{% endif %}
				</div>

				<div class="detail-card-box action-routing-box">
					<h3 class="box-title">
						<i class="fa-solid fa-cash-register"></i>
						Actions Logistiques
					</h3>

					<div class="sidebar-action-button">
						{% if not shipment.isPaid %}
							<a href="#" class="btn-refined btn-primary-gradient btn-full my-4">
								<i class="fa-solid fa-money-bill-transfer"></i>
								Encaisser le Fret
							</a>
						{% endif %}

						{# Bouton dans .sidebar-action-buttons #}
						{% if shipment.status in ['pending', 'in_transit'] %}
							<button type="button" class="btn-refined btn-success-gradient btn-full my-4" id="open-ready-shipment-modal">
								<i class="fa-solid fa-warehouse"></i>
								Réceptionner en Magasin
							</button>
						{% endif %}

						{# Bouton dans .sidebar-action-buttons #}
						{% if is_granted('shipment.write') and shipment.status == 'pending' %}
							<button type="button" class="btn-refined btn-danger-gradient btn-full my-4" id="open-cancel-shipment-modal">
								<i class="fa-solid fa-trash-can"></i>
								Annuler l'enregistrement
							</button>
						{% endif %}

						{% if is_granted('shipment.write') and shipment.status in ['in_transit', 'ready_for_pickup'] and shipment.isPaid %}
							<a href="{{ path('admin_agency_shipment_pickup', {'reference': shipment.reference}) }}" class="btn-refined btn-success-gradient btn-full my-4 ">
								<i class="fa-solid fa-box-open"></i>
								Livrer au Destinataire
							</a>
						{% endif %}
					</div>
				</div>

			</aside>

		</div>
	</div>

	{% if is_granted('shipment.write') and shipment.status == 'pending' %}
		<div id="cancel-shipment-modal" class="mdt-modal-backdrop" aria-hidden="true">
			<div class="mdt-modal-card" role="dialog" aria-modal="true" aria-labelledby="cancel-shipment-title">
				<div class="mdt-modal-header">
					<div class="mdt-modal-icon-danger">
						<i class="fa-solid fa-triangle-exclamation"></i>
					</div>
					<div>
						<h3 id="cancel-shipment-title">Annuler le colis {{ shipment.reference }}</h3>
						<p class="text-gray text-size-12">Cette action est irréversible et sera tracée dans le journal d'audit.</p>
					</div>
				</div>

				<form method="POST" action="{{ path('admin_agency_shipment_cancel', {'reference': shipment.reference}) }}">
					<input type="hidden" name="_token" value="{{ csrf_token('cancel_shipment_' ~ shipment.reference) }}">

					<div class="mdt-modal-body">
						<div class="field">
							<label for="shipment_cancel_reason" class="admin-bus-layout-add-label">Motif de l'annulation *</label>
							<textarea
							id="shipment_cancel_reason"
							name="cancel_reason"
							rows="3"
							class="admin-bus-layout-add-input"
							placeholder="Ex : Erreur de saisie, désistement de l'expéditeur..."
							required
						></textarea>
						</div>
					</div>

					<div class="mdt-modal-footer">
						<button type="button" class="btn-refined btn-gray-gradient" id="close-cancel-shipment-modal">
							Conserver le colis
						</button>
						<button type="submit" class="btn-refined btn-danger-gradient">
							<i class="fa-solid fa-ban"></i>
							Confirmer l'annulation
						</button>
					</div>
				</form>
			</div>
		</div>

		<style>
			.mdt-modal-backdrop {
				position: fixed;
				inset: 0;
				background: rgba(12, 50, 109, 0.55);
				backdrop-filter: blur(3px);
				display: none;
				align-items: center;
				justify-content: center;
				z-index: 9999;
				padding: 16px;
			}
			.mdt-modal-backdrop.is-open {
				display: flex;
			}
			.mdt-modal-card {
				background: #ffffff;
				border-radius: 12px;
				width: 100%;
				max-width: 480px;
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
				border-top: 4px solid #d94516;
				overflow: hidden;
			}
			.mdt-modal-header {
				display: flex;
				align-items: center;
				gap: 14px;
				padding: 20px 24px 14px;
				border-bottom: 1px solid #e5e7eb;
			}
			.mdt-modal-header h3 {
				margin: 0;
				font-size: 16px;
				color: #0c326d;
			}
			.mdt-modal-icon-danger {
				width: 42px;
				height: 42px;
				border-radius: 50%;
				background: rgba(217, 69, 22, 0.12);
				color: #d94516;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 18px;
				flex-shrink: 0;
			}
			.mdt-modal-body {
				padding: 18px 24px;
			}
			.mdt-modal-footer {
				display: flex;
				justify-content: flex-end;
				gap: 10px;
				padding: 14px 24px 20px;
				background: #f9fafb;
				border-top: 1px solid #e5e7eb;
			}
		</style>

		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const modal = document.getElementById("cancel-shipment-modal");
				const openBtn = document.getElementById("open-cancel-shipment-modal");
				const closeBtn = document.getElementById("close-cancel-shipment-modal");
				if (!modal || !openBtn) return;

				openBtn.addEventListener("click", () => {
					modal.classList.add("is-open");
					modal.setAttribute("aria-hidden", "false");
					modal.querySelector("textarea")?.focus();
				});

				const closeModal = () => {
					modal.classList.remove("is-open");
					modal.setAttribute("aria-hidden", "true");
				};

				closeBtn?.addEventListener("click", closeModal);
				modal.addEventListener("click", (e) => {
					if (e.target === modal) closeModal();
				});
				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && modal.classList.contains("is-open"))
						closeModal();
				});
			});
		</script>
	{% endif %}




	{% if is_granted('shipment.write') and shipment.status in ['pending', 'in_transit'] %}
		<div id="ready-shipment-modal" class="mdt-modal-backdrop" aria-hidden="true">
			<div class="mdt-modal-card" style="border-top-color: #1684c5;" role="dialog" aria-modal="true" aria-labelledby="ready-shipment-title">
				<div class="mdt-modal-header">
					<div class="mdt-modal-icon-danger" style="background: rgba(22, 132, 197, 0.12); color: #1684c5;">
						<i class="fa-solid fa-warehouse"></i>
					</div>
					<div>
						<h3 id="ready-shipment-title">Réception en Magasin — {{ shipment.reference }}</h3>
						<p class="text-gray text-size-12">Transfert de responsabilité vers la gare de <strong>{{ shipment.arrivalBranch }}</strong>.</p>
					</div>
				</div>

				<form method="POST" action="{{ path('admin_agency_shipment_ready', {'reference': shipment.reference}) }}">
					<input type="hidden" name="_token" value="{{ csrf_token('ready_shipment_' ~ shipment.reference) }}">

					<div class="mdt-modal-body">
						<div class="field mb-15">
							<label for="reception_observation" class="admin-bus-layout-add-label">État du colis à la réception (Optionnel)</label>
							<input
								type="text"
								id="reception_observation"
								name="reception_observation"
								class="admin-bus-layout-add-input"
								placeholder="Ex : Colis intact, emballage scellé..."
								autocomplete="off"
							>
						</div>

						<div class="field">
							<label for="agent_reception_password" class="admin-bus-layout-add-label">Votre mot de passe agent (Signature) *</label>
							<input
								type="password"
								id="agent_reception_password"
								name="agent_password"
								class="admin-bus-layout-add-input"
								placeholder="Saisissez votre mot de passe pour confirmer"
								required
								autocomplete="current-password"
							>
						</div>
					</div>

					<div class="mdt-modal-footer">
						<button type="button" class="btn-refined btn-gray-gradient" id="close-ready-shipment-modal">
							Annuler
						</button>
						<button type="submit" class="btn-refined btn-primary-gradient">
							<i class="fa-solid fa-signature"></i>
							Confirmer la réception
						</button>
					</div>
				</form>
			</div>
		</div>

		<style>
			.mdt-modal-backdrop {
				position: fixed;
				inset: 0;
				background: rgba(12, 50, 109, 0.55);
				backdrop-filter: blur(3px);
				display: none;
				align-items: center;
				justify-content: center;
				z-index: 9999;
				padding: 16px;
			}
			.mdt-modal-backdrop.is-open {
				display: flex;
			}
			.mdt-modal-card {
				background: #ffffff;
				border-radius: 12px;
				width: 100%;
				max-width: 480px;
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
				border-top: 4px solid #d94516;
				overflow: hidden;
			}
			.mdt-modal-header {
				display: flex;
				align-items: center;
				gap: 14px;
				padding: 20px 24px 14px;
				border-bottom: 1px solid #e5e7eb;
			}
			.mdt-modal-header h3 {
				margin: 0;
				font-size: 16px;
				color: #0c326d;
			}
			.mdt-modal-icon-danger {
				width: 42px;
				height: 42px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 18px;
				flex-shrink: 0;
			}
			.mdt-modal-body {
				padding: 18px 24px;
			}
			.mdt-modal-footer {
				display: flex;
				justify-content: flex-end;
				gap: 10px;
				padding: 14px 24px 20px;
				background: #f9fafb;
				border-top: 1px solid #e5e7eb;
			}
		</style>

		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const modal = document.getElementById("ready-shipment-modal");
				const openBtn = document.getElementById("open-ready-shipment-modal");
				const closeBtn = document.getElementById("close-ready-shipment-modal");
				if (!modal || !openBtn) return;

				openBtn.addEventListener("click", () => {
					modal.classList.add("is-open");
					modal.setAttribute("aria-hidden", "false");
					modal.querySelector('input[type="password"]')?.focus();
				});

				const closeModal = () => {
					modal.classList.remove("is-open");
					modal.setAttribute("aria-hidden", "true");
				};

				closeBtn?.addEventListener("click", closeModal);
				modal.addEventListener("click", (e) => {
					if (e.target === modal) closeModal();
				});
				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && modal.classList.contains("is-open"))
						closeModal();
				});
			});
		</script>
	{% endif %}


{% endblock %}
