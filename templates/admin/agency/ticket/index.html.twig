{# templates/admin/agency/ticketing/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
{{ parent() }}
<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
<div class="admin-agency-ticketing-index-scope container">
    {# --- HEADER ÉPURÉ --- #}
    <header class="header-refined mb-30">
        <div class="header-left">
            <div class="breadcrumb-mini">
                <span>Opérations</span>
                <i class="fa-solid fa-chevron-right"></i>
                <strong>Billetterie</strong>
            </div>
            <h1>Registre des Billets</h1>
            <p class="subtitle">Gestion et traçabilité des titres de transport émis.</p>
        </div>
        <div class="header-right">
            <a href="{{ path('admin_agency_ticket_scan') }}" class="btn-refined btn-primary-gradient">
                <i class="fa-solid fa-qrcode"></i>
                <span>Scanner un ticket</span>
            </a>
        </div>
    </header>

    <div class="ticketing-main-content">

        {# FILTRES #}
        <div class="card-refined ">
            <h3 class="side-title">
                <i class="fa-solid fa-sliders"></i>
                Filtrage
            </h3>
            <div class="p-20">
                <form action="">
                    <div class="field-group">
                        <div class="field">
                            <label>Statut du billet</label>
                            <select class="input-refined">
                                <option value="valid">Valide</option>
                                <option value="used">Utilisé</option>
                                <option value="cancelled">Annulé</option>
                            </select>
                        </div>
                        <div class="field">
                            <label>Période</label>
                            <input type="date" class="input-refined">
                        </div>
                        <div class="field mb-20">
                            <label>#Ticket</label>
                            <input type="text" class="input-refined" placeholder="#TK-0826-0001">
                        </div>
                    </div>
                    <div class="field-button-right">
                        <button class="btn-refined btn-success-gradient">Mettre à jour la vue</button>
                    </div>
                </form>
            </div>
        </div>


        {# LISTE #}
        <div class="main-content-panel">
            <div class="table-responsive-wrapper">
                <table class="table table-scrollable table-striped js-datatable">
                    <thead>
                        <tr>
                            <th>Référence & Date</th>
                            <th>Passager</th>
                            <th>Voyage / Siège</th>
                            <th class="text-center">Statut Billet</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ticket in tickets %}
                        <tr class="matrix-row">
                            <td>
                                <div class="ticket-ref">#{{ ticket.reference }}</div>
                                <small class="text-muted">Émis le
                                    {{ ticket.createdAt|date('d/m/y') }}</small>
                            </td>
                            <td>
                                <strong>{{ ticket.passengerName }}</strong><br>
                                <small>{{ ticket.passengerPhone }}</small>
                            </td>
                            <td>
                                <span class="route-badge">{{ ticket.tripCode }}</span><br>
                                <strong>Siège n°{{ ticket.seatNumber }}</strong>
                            </td>
                            <td class="text-center">
                                <span class="badge-status {{ ticket.status }}">
                                    {{ ticket.status|upper }}
                                </span>
                            </td>
                            <td class="text-right action-cell">
                                <div class="action-buttons-group">
                                    <a href="#" class="action-link" title="Imprimer / Télécharger">
                                        <i class="fa-solid fa-print"></i>
                                    </a>
                                    <a href="#" class="action-link refund" title="Annuler / Rembourser">
                                        <i class="fa-solid fa-rotate-left"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>



    </div>
</div>
{% endblock %}