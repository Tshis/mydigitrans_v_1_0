{# templates/admin/agency/report/financial/show.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div
		class="admin-agency-report-financial-show-scope container">
		{# --- HEADER --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_report_financial_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Registre Comptable</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Audit des Écritures</span>
					</div>
					<h1 class="mt-5">Détail des flux :
						{{ selected_date|date('d/m/Y') }}</h1>
				</div>
			</div>
		</header>

		{# --- TABLEAU TEXTUEL DES TRANSACTIONS DÉTAILLÉES --- #}
		<div class="table-responsive-wrapper">
			<h2 class="card-title-fix text-size-16 py-10">
				<i class="fa-solid fa-receipt text-primary"></i>
				Journal Journalier des Ventes & Opérations de Caisse - #{{ current_branch }}
			</h2>
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Heure</th>
						<th>Référence Réf</th>
						<th>Type de Flux</th>
						<th>Désignation / Client</th>
						<th>Caissier (updatedBy)</th>
						<th class="text-right">Montant Encaissé</th>
					</tr>
				</thead>
				<tbody>
					{% for tx in transactions %}
						<tr>
							<td>{{ tx.time }}</td>
							<td class="monospace">
								<strong>{{ tx.reference }}</strong>
							</td>
							<td>
								<span class="pill-type-flux {{ tx.type }}">
									{{ tx.type == 'ticket' ? 'BILLETTERIE' : 'FRET/COLIS' }}
								</span>
							</td>
							<td>
								<div>
									<strong>{{ tx.label }}</strong>
								</div>
								<small class="text-gray">{{ tx.details }}</small>
							</td>
							<td>
								<i class="fa-solid fa-user-tie text-gray"></i>
								{{ tx.cashier }}
							</td>
							<td class="text-right font-bold {% if tx.type == 'cargo' %}text-success-mode{% else %}text-primary-mode{% endif %}">
								{{ tx.amount|number_format(0, ',', ' ') }}
								<small>{{ tx.currency }}</small>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-gray italic padding-20">
								Aucune transaction détaillée pour cette journée.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
