{# templates/admin/agency/report/financial/cashier_show.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div
		class="admin-agency-report-scope container">
		{# --- HEADER --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_report_cashier_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Audit Comptable</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Fiche Agent</span>
					</div>
					<h1 class="mt-5">Journal des Sessions :
						{{ cashier.name }}</h1>
				</div>
			</div>
		</header>

		{# --- COMMENCEMENT DE LA ZONE DE FILTRES ALIGNÉS PAR LE BAS --- #}
		<div class="trip-filters-card mb-20">
			<form action="#" method="GET" class="field-group">
				<div class="field">
					<label class="admin-bus-layout-add-label">Période du</label>
					<input type="date" name="date_from" class="admin-bus-layout-add-input" value="{{ date_from }}">
				</div>
				<div class="field">
					<label class="admin-bus-layout-add-label">Au</label>
					<input type="date" name="date_to" class="admin-bus-layout-add-input" value="{{ date_to }}">
				</div>

				<div class="field-actions">
					<button type="submit" class="btn-refined btn-primary-gradient">
						<i class="fa-solid fa-chart-line"></i>
						Filtrer les flux
					</button>
				</div>
			</form>
		</div>

		{# --- COMPOSANT STRICT DU TABLEAU REPRISE --- #}
		<div class="table-responsive-wrapper">
			<h2 class="card-title-fix text-size-16 py-10">
				<i class="fa-solid fa-vault text-primary"></i>
				Historique des Clôtures et Versements de Caisse Multi-Devises
			</h2>
			<table class="table table-scrollable table-striped js-datatable js-datatable-export">
				<thead>
					<tr>
						<th>Session Réf</th>
						<th>Ouverture / Clôture</th>
						<th class="text-right">Attendu (Système)</th>
						<th class="text-right">Encaissé (Réel)</th>
						<th class="text-right">Écart / Balance</th>
						<th class="text-center">Statut Coffre</th>
					</tr>
				</thead>
				<tbody>
					{% for session in cashier.sessions %}
						<tr>
							<td class="monospace">
								<strong>#{{ session.id }}
									-
									{{session.currency}}</strong>
							</td>
							<td>
								<div class="mb-10">
									<small>Ouv:</small>
									{{ session.openedAt|date('d/m/Y H:i') }}</div>
								<div>
									<small>Ferm:</small>
									{{ session.closedAt ? session.closedAt|date('d/m/Y H:i') : 'En cours' }}</div>
							</td>

							<td class="text-right">
								<div class="amount_revenue font-bold">{{ session.expected|number_format(0, ',', ' ') }}
									<small>{{session.currency}}</small>
								</div>
							</td>
							<td class="text-right">
								<div class="font-bold text-success-mode">{{ session.received|number_format(0, ',', ' ') }}
									<small>{{session.currency}}</small>
								</div>
							</td>
							<!-- Calcul dynamique de l'écart -->
							<td class="text-right">
								{% set diff = session.received - session.expected %}

								<div class="font-bold {% if diff < 0 %}text-danger{% else %}text-success{% endif %}">
									{{ diff|number_format(0, ',', ' ') }}
									<small>{{session.currency}}</small>
								</div>
							</td>
							<td class="text-center">
								<span class="pill-report-audit {{ session.status }}">
									{{ session.statusLabel }}
								</span>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
