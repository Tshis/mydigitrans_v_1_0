{# templates/admin/agency/report/document/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div
		class="admin-agency-report-financial-index-scope container">
		{# --- HEADER --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_report_center') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Logistique Automobile</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Audit Restrictif</span>
					</div>
					<h1 class="mt-5">Conformité Pièces Légales</h1>
				</div>
			</div>
		</header>

		{# --- FILTRES DE SÉCURITÉ --- #}
		<div class="trip-filters-card mb-20">
			<form action="#" method="GET" class="field-group">
				<div class="field">
					<label class="admin-bus-layout-add-label">Type de pièce</label>
					<select name="type" class="admin-bus-layout-add-select">
						<option value="">-- Tous les documents --</option>
						<option value="Assurance">Assurance Obligatoire (SONAS)</option>
						<option value="contrôle technique">Contrôle Technique</option>
						<option value="Carte Rose">Carte Rose</option>
					</select>
				</div>
				<div class="field">
					<label class="admin-bus-layout-add-label">Statut Légal [MCD 10]</label>
					<select name="status" class="admin-bus-layout-add-select">
						<option value="">-- Tous les états --</option>
						<option value="valid">Valid (En règle)</option>
						<option value="expired">Expired (Caduque)</option>
					</select>
				</div>
				<div class="field-actions">
					<button type="submit" class="btn-refined btn-success-gradient">
						<i class="fa-solid fa-filter"></i>
						Filtrer les pièces
					</button>
				</div>
			</form>
		</div>

		{# --- TA STRUCTURE DE TABLEAU INTERNE --- #}
		<div class="table-responsive-wrapper">
			<h2 class="card-title-fix text-size-16 py-10">
				<i class="fa-solid fa-file-shield text-primary"></i>
				Registre de Validité de la Flotte Administrative
			</h2>
			<table class="table table-scrollable table-striped js-datatable-export">
				<thead>
					<tr>
						<th>Véhicule</th>
						<th>Type de Document</th>
						<th>Numéro de Réf</th>
						<th>Délivré le (issuedAt)</th>
						<th>Expire le (expiredAt)</th>
						<th>Agent (updatedBy)</th>
						<th class="text-center">Statut</th>
					</tr>
				</thead>
				<tbody>
					{% for doc in documents %}
						<tr>
							<td>
								<div class="font-bold">{{ doc.busBrand }}
									{{ doc.busModel }}</div>
								<small class="value-badge-plate">{{ doc.busPlate }}</small>
							</td>
							<td>
								<strong>{{ doc.type }}</strong>
							</td>
							<td class="monospace">{{ doc.referenceNumber|default('N/A') }}</td>
							<td>{{ doc.issuedAt|date('d/m/Y') }}</td>
							<td class="font-bold {% if doc.status == 'expired' %}text-danger-mode{% endif %}">
								{{ doc.expiredAt|date('d/m/Y') }}
							</td>
							<td>
								<small>{{ doc.updatedBy }}</small>
							</td>
							<td class="text-center">
								<span class="pill-report-audit {{ doc.status }}">
									{{ doc.status == 'valid' ? 'Valide' : 'EXPIRED' }}
								</span>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
