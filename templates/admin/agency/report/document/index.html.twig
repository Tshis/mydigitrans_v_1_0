{# templates/admin/agency/report/document/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
	<script src="/js/admin/csv_export.js" defer></script>
{% endblock %}

{% block body %}
	<div
		class="admin-agency-report-scope container">
		{# --- HEADER --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_report_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Logistique Automobile</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Registre Documentaire</span>
					</div>
					<h1 class="mt-5">Audit de Conformité Flotte</h1>
				</div>
			</div>
			<div class="header-actions">
				<button type="button" class="btn-refined btn-primary-gradient" onclick="executeAdvancedExport('{{ current_type }}');">
					<i class="fa-solid fa-file-excel"></i>
					<span>Exporter le registre</span>
				</button>
			</div>
		</header>

		{# --- FILTRES ALIGNÉS PAR LE BAS --- #}
		<div class="trip-filters-card mb-20">
			<form action="#" method="GET" class="field-group">
				<div class="field">
					<label class="admin-bus-layout-add-label">Nature de la pièce</label>
					<select name="doc_type" class="admin-bus-layout-add-select">
						<option value="">-- Tous les documents --</option>
						<option value="Assurance" {% if current_doc_type == 'Assurance' %} selected {% endif %}>Assurance Obligatoire (SONAS)</option>
						<option value="contrôle technique" {% if current_doc_type == 'contrôle technique' %} selected {% endif %}>Contrôle Technique (Feuille Jaune)</option>
						<option value="Carte Rose" {% if current_doc_type == 'Carte Rose' %} selected {% endif %}>Carte Rose / Certificat</option>
					</select>
				</div>
				<div class="field">
					<label class="admin-bus-layout-add-label">État Légal</label>
					<select name="status" class="admin-bus-layout-add-select">
						<option value="">-- Tous les états --</option>
						<option value="valid" {% if current_status == 'valid' %} selected {% endif %}>Valid (En règle)</option>
						<option value="expired" {% if current_status == 'expired' %} selected {% endif %}>Expired (Caduque / Alerte)</option>
					</select>
				</div>
				<div class="field-actions">
					<button type="submit" class="btn-refined btn-success-gradient">
						<i class="fa-solid fa-filter"></i>
						Filtrer le portefeuille
					</button>
				</div>
			</form>
		</div>

		{# --- TABLEAU TEXTUEL STRICTEMENT PRÉSERVÉ --- #}
		<div class="table-responsive-wrapper">
			<h2 class="card-title-fix text-size-16 py-10">
				<i class="fa-solid fa-file-shield text-primary"></i>
				Statut des Pièces Obligatoires & Échéancier Multi-Devises
			</h2>
			<table class="table table-scrollable table-striped js-datatable js-datatable-export">
				<thead>
					<tr>
						<th>Véhicule Flotte</th>
						<th>Type de Document</th>
						<th>Numéro de Réf</th>
						<th>Date d'Émission</th>
						<th>Date d'Expiration</th>
						<th class="text-center">Statut</th>
						<th class="text-center">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for doc in documents %}
						<tr>
							<td>
								<strong>{{ doc.busBrand }}
									{{ doc.busModel }}</strong>
								<div class="mt-5">
									<span class="value-badge-plate">{{ doc.busPlate }}</span>
								</div>
							</td>
							<td>
								<strong>{{ doc.type }}</strong>
							</td>
							<td class="monospace">{{ doc.referenceNumber|default('Non spécifié') }}</td>
							<td>{{ doc.issuedAt|date('d/m/Y') }}</td>
							<td class="font-bold {{date(doc.expiredAt) > date(" now") ? 'text-success' : 'text-danger' }}">
								{{ doc.expiredAt|date('d/m/Y') }}
							</td>

							<td class="text-center">
								<span class="pill-report-audit {% if date(doc.expiredAt) > date(" now") %}opened{% else %}closed{% endif %}">
									{{ date(doc.expiredAt) > date(" now") ? 'VALIDE' : 'EXPIRE' }}
								</span>
							</td>
							<td class="text-center">
								<div class="action-group-refined">
									<a href="{{ path('admin_agency_report_document_show', {id: doc.id}) }}" class="action-link edit" title="Consulter l'historique d'audit">
										<i class="fa-solid fa-eye"></i>
									</a>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="8" class="text-center text-gray italic padding-20">Aucun document ne correspond aux filtres de conformité actuels.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
