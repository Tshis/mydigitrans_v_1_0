{# templates/admin/agency/report/cargo/show.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-agency-report-scope container">
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_report_shipment_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Analyse Messagerie</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Journal de Soute</span>
					</div>
					<h1 class="mt-5">Registre des Marchandises : #{{ branch_code }}</h1>
				</div>
			</div>
		</header>

		{# --- FILTRES DE LA PORTÉE --- #}
		<div class="trip-filters-card mb-20">
			<form action="#" method="GET" class="field-group">
				<div class="field">
					<label class="admin-bus-layout-add-label">Période du</label>
					<input type="date" name="date_from" class="admin-bus-layout-add-input" value="{{ date_from }}">
				</div>
				<div class="field">
					<label class="admin-bus-layout-add-label">Au</label>
					<input type="date" name="date_to" class="admin-bus-layout-add-input" value="{{ date_to }}">
				</div>
				<div class="field-actions">
					<button type="submit" class="btn-refined btn-primary-gradient">
						<i class="fa-solid fa-calculator"></i>
						Filtrer le fret
					</button>
				</div>
			</form>
		</div>

		<div class="table-responsive-wrapper">
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Date de Creation</th>
						<th>Code Colis</th>
						<th>Expéditeur & Destinataire</th>
						<th>Nature du Colis</th>
						<th class="text-right">Poids</th>
						<th>Type Paiement</th>
						<th class="text-right">Taxe Perçue</th>
					</tr>
				</thead>
				<tbody>
					{% for colis in items %}
						<tr>
							<td class="monospace">
								<strong>{{ colis.createdAt|date('d-m-Y')  }}</strong>
							</td>
							<td class="monospace">
								<strong>{{ colis.code }}</strong>
							</td>
							<td>
								<div>
									<small>Exp:</small>
									{{ colis.sender }}</div>
								<div>
									<small>Dest:</small>
									{{ colis.receiver }}</div>
							</td>
							<td>
								<strong>{{ colis.label }}</strong>
							</td>
							<td class="text-right">{{ colis.weight }}
								Kg</td>
							<td>
								<span class="pill-payment-type {{ colis.paymentMethod }}">
									{{ colis.paymentMethod == 'prepaid' ? 'PAYÉ AU DÉPART' : 'À DESTINATION' }}
								</span>
							</td>
							<td class="text-right font-bold text-primary-mode">
								{{ colis.price|number_format(0, ',', ' ') }}
								<small>{{ colis.currency }}</small>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
