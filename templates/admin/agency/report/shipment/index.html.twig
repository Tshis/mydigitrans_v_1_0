{# templates/admin/agency/report/cargo/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-agency-report-scope container">
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_report_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Logistique & Fret</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Analyse Messagerie</span>
					</div>
					<h1 class="mt-5">Rapport d'Activité Fret & Colis</h1>
				</div>
			</div>
		</header>

		{# --- FILTRES DE LA PORTÉE --- #}
		<div class="trip-filters-card mb-20">
			<form action="#" method="GET" class="field-group">
				<div class="field">
					<label class="admin-bus-layout-add-label">Période du</label>
					<input type="date" name="date_from" class="admin-bus-layout-add-input" value="{{ date_from }}">
				</div>
				<div class="field">
					<label class="admin-bus-layout-add-label">Au</label>
					<input type="date" name="date_to" class="admin-bus-layout-add-input" value="{{ date_to }}">
				</div>
				<div class="field-actions">
					<button type="submit" class="btn-refined btn-primary-gradient">
						<i class="fa-solid fa-calculator"></i>
						Filtrer le fret
					</button>
				</div>
			</form>
		</div>

		{# --- TABLEAU STRICT --- #}
		<div class="table-responsive-wrapper">
			<h2 class="card-title-fix text-size-16 py-10">
				<i class="fa-solid fa-boxes-packing text-primary"></i>
				Volume de Messagerie et Recettes Soute par Gare
			</h2>
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Succursale</th>
						<th class="text-right">Colis Traités</th>
						<th class="text-right">Poids Total (Kg)</th>
						<th class="text-right">Encaissé au Départ</th>
						<th class="text-right">Dû à Destination</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for row in shipment_matrix%}
						<tr>
							<td>
								<strong>{{ row.branchName }}</strong>
								<small class="text-muted">#{{ row.branchCode }}</small>
							</td>
							<td class="text-right font-bold">{{ row.totalColis }}</td>
							<td class="text-right font-bold">{{ row.totalWeight|number_format(0, ',', ' ') }}
								Kg</td>
							<td class="text-right font-bold">{{ row.prepaidRevenue|number_format(0, ',', ' ') }}
								<small>{{ row.currency }}</small>
							</td>
							<td class="text-right font-bold text-success-mode">{{ row.postpaidRevenue|number_format(0, ',', ' ') }}
								<small>{{ row.currency }}</small>
							</td>
							<td class="text-right">
								<div class="action-group-refined">
									<a href="{{ path('admin_agency_report_shipment_show', {branch_code: row.branchCode}) }}" class="action-link edit" title="Voir le registre des colis">
										<i class="fa-solid fa-eye"></i>
									</a>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-gray italic padding-20">Aucun flux de fret enregistré.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
