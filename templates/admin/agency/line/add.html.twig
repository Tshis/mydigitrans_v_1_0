{# templates/admin/agency/line/add.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/admin/route_add.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-route-creation-scope container">
		<header class="header mb-25">
			<a href="{{ path('admin_agency_line_index') }}" class="agency-back-action">
				<i class="fa-solid fa-arrow-left"></i>
			</a>
			<div class="title">
				<h2>Configuration de l'Itinéraire</h2>
				<p>Axe principal et gestion des escales</p>
			</div>
		</header>

		{{ form_start(form, {'attr': {'id': 'route-creation-form', 'class': 'reservation-form', 'novalidate': 'novalidate'}}) }}

			<div class="route-create-container">
				<div class="layout-main-panel">

					{{ form_errors(form) }}

					{# SECTION 1 : AXE PRINCIPAL #}
					<div class="card mb-20">
						<h2>
							<i class="fa-solid fa-map-location-dot"></i>
							Informations de la Route
						</h2>
						<div class="main-route-header-grid">
							<div class="field">
								{{ form_label(form.name) }}
								{{ form_widget(form.name, {'id': 'route-name-input'}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.name) }}</div>
							</div>
							<div class="field">
								{{ form_label(form.code) }}
								{{ form_widget(form.code) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.code) }}</div>
							</div>
						</div>
					</div>

					{# SECTION 2 : ROUTESTOPS (Timeline Dynamique) #}
					<div class="card mb-20">
						<div class="card-header-row mb-15">
							<h2>
								<i class="fa-solid fa-list-ol"></i>
								Tracé des Arrêts
							</h2>
						</div>

						<div class="route-stops-timeline-container" id="stops-dynamic-container">
							{# DÉPART #}
							<div class="stop-node-row" data-order="1">
								<div class="stop-badge-marker start">Départ</div>
								<div class="stop-fields-stack">
									<div class="field-row">
										<div class="field">
											{{ form_label(form.departureCity) }}
											{{ form_widget(form.departureCity) }}
											<div class="text-danger text-size-12 mt-5">{{ form_errors(form.departureCity) }}</div>
										</div>
										<div class="field">
											{{ form_label(form.departureCountry) }}
											{{ form_widget(form.departureCountry) }}
											<div class="text-danger text-size-12 mt-5">{{ form_errors(form.departureCountry) }}</div>
										</div>
									</div>
								</div>
							</div>

							{# ZONE D'INJECTION DES ARRÊTS INTERMÉDIAIRES #}
							<div id="js-stops-wrapper" data-index="{{ form.stops|length }}">
								{% for stopForm in form.stops %}
									<div class="stop-node-row intermediate">
										<div class="stop-id-indicator">#{{ loop.index }}</div>
										<div class="stop-badge-marker intermediate">Arrêt</div>
										<div class="stop-fields-stack">
											<div class="field-row">
												<div class="field">
													{{ form_label(stopForm.city) }}
													{{ form_widget(stopForm.city) }}
													<div class="text-danger text-size-12 mt-5">{{ form_errors(stopForm.city) }}</div>
												</div>
												<div class="field">
													{{ form_label(stopForm.country) }}
													{{ form_widget(stopForm.country) }}
													<div class="text-danger text-size-12 mt-5">{{ form_errors(stopForm.country) }}</div>
												</div>
											</div>
											<div class="field-row">
												<div class="field">
													{{ form_label(stopForm.distance) }}
													{{ form_widget(stopForm.distance) }}
													<div class="text-danger text-size-12 mt-5">{{ form_errors(stopForm.distance) }}</div>
												</div>
												<div class="field">
													{{ form_label(stopForm.duration) }}
													{{ form_widget(stopForm.duration) }}
													<div class="text-danger text-size-12 mt-5">{{ form_errors(stopForm.duration) }}</div>
												</div>
												<button type="button" class="btn-remove-row js-remove-row">
													<i class="fa-solid fa-trash-can"></i>
												</button>
											</div>
										</div>
									</div>
								{% endfor %}
							</div>

							{# ZONE D'ACTION : BOUTON AJOUTER #}
							<div class="stop-action-row-on-timeline">
								<div class="timeline-line-connector"></div>
								<button type="button" class="btn-add-on-timeline" id="js-add-stop-row">
									<i class="fa-solid fa-circle-plus"></i>
									Ajouter une escale
								</button>
							</div>

							{# TERMINUS #}
							<div class="stop-node-row last" id="js-terminus-row">
								<div class="stop-badge-marker end">Fin</div>
								<div class="stop-fields-stack">
									<div class="field-row">
										<div class="field">
											{{ form_label(form.terminusCity) }}
											{{ form_widget(form.terminusCity) }}
											<div class="text-danger text-size-12 mt-5">{{ form_errors(form.terminusCity) }}</div>
										</div>
										<div class="field">
											{{ form_label(form.terminusCountry) }}
											{{ form_widget(form.terminusCountry) }}
											<div class="text-danger text-size-12 mt-5">{{ form_errors(form.terminusCountry) }}</div>
										</div>
									</div>
									<div class="field-row">
										<div class="field">
											{{ form_label(form.distance) }}
											{{ form_widget(form.distance) }}
											<div class="text-danger text-size-12 mt-5">{{ form_errors(form.distance) }}</div>
										</div>
										<div class="field">
											{{ form_label(form.duration) }}
											{{ form_widget(form.duration) }}
											<div class="text-danger text-size-12 mt-5">{{ form_errors(form.duration) }}</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					{# SECTION 3 : TARIFICATION FRET #}
					<div class="card">
						<h2>
							<i class="fa-solid fa-hand-holding-dollar"></i>
							Fret & Tarification
						</h2>
						<div class="main-route-header-grid">
							<div class="field">
								{{ form_label(form.pricePerKg) }}
								{{ form_widget(form.pricePerKg) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.pricePerKg) }}</div>
							</div>
							<div class="field">
								{{ form_label(form.currencyCode) }}
								{{ form_widget(form.currencyCode) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.currencyCode) }}</div>
							</div>
						</div>
					</div>
				</div>

				<aside class="summary">
					<div class="card summary-sticky-card">
						<h2>
							<i class="fa-solid fa-globe"></i>
							Publication
						</h2>
						<div class="field mb-20">
							{{ form_label(form.reservationExpirationDelay) }}
							{{ form_widget(form.reservationExpirationDelay) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.reservationExpirationDelay) }}</div>
						</div>
						<div class="field mb-20">
							{{ form_label(form.isAvailable) }}
							{{ form_widget(form.isAvailable) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.isAvailable) }}</div>
						</div>
						<button type="submit" class="btn btn-primary btn-full">
							<i class="fa-solid fa-map-pin"></i>
							Enregistrer la Route
						</button>
					</div>
				</aside>
			</div>

			{# Empêche le rendu automatique en double du prototype vide de form.stops #}
			{% do form.stops.setRendered %}

		{{ form_end(form) }}
	</div>

	{# TEMPLATE JS AVEC PROTOTYPE SYMFONY (__name__) #}
	{% set proto = form.stops.vars.prototype %}
	<template id="stop-row-template">
		<div class="stop-node-row intermediate">
			<div class="stop-id-indicator">#</div>
			<div class="stop-badge-marker intermediate">Arrêt</div>
			<div class="stop-fields-stack">
				<div class="field-row">
					<div class="field">
						{{ form_label(proto.city) }}
						{{ form_widget(proto.city) }}
					</div>
					<div class="field">
						{{ form_label(proto.country) }}
						{{ form_widget(proto.country) }}
					</div>
				</div>
				<div class="field-row">
					<div class="field">
						{{ form_label(proto.distance) }}
						{{ form_widget(proto.distance) }}
					</div>
					<div class="field">
						{{ form_label(proto.duration) }}
						{{ form_widget(proto.duration) }}
					</div>
					<button type="button" class="btn-remove-row js-remove-row">
						<i class="fa-solid fa-trash-can"></i>
					</button>
				</div>
			</div>
		</div>
	</template>
{% endblock %}
