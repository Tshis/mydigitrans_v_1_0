{# templates/admin/agency/route/new.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/admin/route_add.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-route-creation-scope container">
		<header class="header mb-25">
			<a href="{{ path('admin_agency_line_index') }}" class="agency-back-action">
				<i class="fa-solid fa-arrow-left"></i>
			</a>
			<div class="title">
				<h2>Configuration de l'Itinéraire</h2>
				<p>Axe principal et gestion des escales</p>
			</div>
		</header>

		<form action="#" method="POST" id="route-creation-form" class="reservation-form">
			<div class="route-create-container">
				<div
					class="layout-main-panel">

					{# SECTION 1 : AXE PRINCIPAL (Alignement Nom/Code Fixé) #}
					<div class="card mb-20">
						<h2>
							<i class="fa-solid fa-map-location-dot"></i>
							Informations de la Route</h2>
						<div class="main-route-header-grid">
							<div class="field">
								<label>Nom Commercial de la Ligne *</label>
								<input type="text" name="name" id="route-name-input" placeholder="Ex : Kinshasa - Muanda" required>
							</div>
							<div class="field">
								<label>Code Ligne (Unique) *</label>
								<input type="text" name="code" placeholder="Ex : KIN-MUA" required>
							</div>
						</div>
					</div>

					{# SECTION 2 : ROUTESTOPS (Timeline Dynamique) #}
					<div class="card mb-20">
						<div class="card-header-row mb-15">
							<h2>
								<i class="fa-solid fa-list-ol"></i>
								Tracé des Arrêts</h2>
						</div>

						<div
							class="route-stops-timeline-container" id="stops-dynamic-container">
							{# DEPART FIXE #}
							<div class="stop-node-row" data-order="1">
								<div class="stop-badge-marker start">Départ</div>
								<div class="stop-fields-stack">
									<div class="field-row">
										<div class="field">
											<label>Ville d'Origine</label><input type="text" value="Kinshasa" readonly></div>
										<div class="field">
											<label>Pays</label><input type="text" value="RDC" readonly></div>
									</div>
								</div>
							</div>

							{# ZONE D'INJECTION DES ARRÊTS INTERMÉDIAIRES #}
							<div id="js-stops-wrapper"></div>

							{# ZONE D'ACTION : BOUTON AJOUTER (Placé avant le terminus) #}
							<div class="stop-action-row-on-timeline">
								<div class="timeline-line-connector"></div>
								<button type="button" class="btn-add-on-timeline" id="js-add-stop-row">
									<i class="fa-solid fa-circle-plus"></i>
									Ajouter une escale
								</button>
							</div>

							{# TERMINUS FIXE #}
							<div class="stop-node-row last" id="js-terminus-row">
								<div class="stop-badge-marker end">Fin</div>
								<div class="stop-fields-stack">
									<div class="field-row">
										<div class="field">
											<label>Ville Terminus</label><input type="text" name="terminus_city" placeholder="Ville..." required></div>
										<div class="field">
											<label>Pays</label><input type="text" name="terminus_country" value="RDC" required></div>
									</div>
									<div class="field-row">
										<div class="field">
											<label>Distance Totale (Km)</label><input type="number" name="distance" placeholder="650" required></div>
										<div class="field">
											<label>Durée Totale</label><input type="text" name="duration" placeholder="11h00" required></div>
									</div>
								</div>
							</div>
						</div>
					</div>

					{# SECTION 3 : TARIFICATION #}
					<div class="card">
						<h2>
							<i class="fa-solid fa-hand-holding-dollar"></i>
							Fret & Tarification</h2>
						<div class="main-route-header-grid">
							<div class="field">
								<label>Prix par Kilo *</label>
								<input type="number" name="price_per_kg" step="0.01" required>
							</div>
							<div class="field">
								<label>Devise *</label>
								<select name="route_currency">
									<option value="CDF">CDF (Franc Congolais)</option>
									<option value="USD">USD (Dollar)</option>
								</select>
							</div>
						</div>
					</div>
				</div>

				<aside class="summary">
					<div class="card summary-sticky-card">
						<h2>
							<i class="fa-solid fa-globe"></i>
							Publication</h2>
						<div class="field mb-20">
							<label>Statut de la ligne</label>
							<select name="isAvailable">
								<option value="1">Disponible / Actif</option>
								<option value="0">Désactivé</option>
							</select>
						</div>
						<button type="submit" class="btn btn-primary btn-full">
							<i class="fa-solid fa-map-pin"></i>
							Enregistrer la Route
						</button>
					</div>
				</aside>
			</div>
		</form>
	</div>

	{# TEMPLATE JS #}
	<template id="stop-row-template">
		<div class="stop-node-row intermediate">
			<div class="stop-id-indicator">#</div>
			<div class="stop-badge-marker intermediate">Arrêt</div>
			<div class="stop-fields-stack">
				<div class="field-row">
					<div class="field">
						<label>Ville d'Escale</label><input type="text" name="stops[__][city]" placeholder="Ex: Mbanza-Ngungu" required></div>
					<div class="field">
						<label>Pays</label><input type="text" name="stops[__][country]" value="RDC" required>
					</div>
				</div>
				<div class="field-row">
					<div class="field">
						<label>Distance (Km)</label><input type="number" name="stops[__][distance]" placeholder="150" required></div>
					<div class="field">
						<label>Durée</label><input type="text" name="stops[__][duration]" placeholder="2h15" required></div>
					<button type="button" class="btn-remove-row js-remove-row">
						<i class="fa-solid fa-trash-can"></i>
					</button>
				</div>
			</div>
		</div>
	</template>
{% endblock %}
