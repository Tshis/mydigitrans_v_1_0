{# templates/admin/agency/line/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/table-responsive.js" defer></script>
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-lines-wrapper container">

		{# --- EN-TÊTE DE LA PAGE --- #}
		<header class="header-refined my-30">
			<div class="header-main-info">
				<div class="title">
					<h1>
						<i class="fa-solid fa-route"></i>
						Gestion des Trajets / Lignes
					</h1>
					<p class="subtitle">Gérez les itinéraires, les distances et les tarifs de base du réseau.</p>
				</div>
			</div>
			{% if is_granted('route.write') %}
				<div class="admin-bus-layout-add-action-zone">
					<a href="{{ path('admin_agency_line_add') }}" class="btn-refined btn-success-gradient text-size-12">
						<i class="fa-solid fa-plus"></i>
						Créer une nouvelle ligne
					</a>
				</div>
			{% endif %}
		</header>

		{# --- COMPOSANT DE STATISTIQUES (CARDS) --- #}
		<div class="stats-overview-grid">
			<div class="stat-card">
				<div class="stat-icon stat-icon--primary">
					<i class="fa-solid fa-route"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Total des lignes</span>
					<strong class="stat-value">{{ stats.total }}</strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--success">
					<i class="fa-solid fa-circle-check"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Lignes Actives / Opérationnelles</span>
					<strong class="stat-value">{{ stats.active }}</strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--danger">
					<i class="fa-solid fa-circle-xmark"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Lignes Suspendues</span>
					<strong class="stat-value">{{ stats.suspended }}</strong>
				</div>
			</div>
		</div>

		{# --- COMPOSANT DE DONNÉES DATATABLE --- #}
		<div class="card mb-20">
			<div class="table-responsive-wrapper">
				<table class="table table-responsive table-stripped js-datatable">
					<thead>
						<tr>
							<th>Code</th>
							<th>Itinéraire (Départ → Arrivée)</th>
							<th>Distance</th>
							<th>Durée</th>
							<th>Tarif de Base</th>
							<th>Statut</th>
							<th class="text-right">Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for line in lines %}
							<tr class="table-row">
								<td class="monospace font-bold text-primary-mode">{{ line.code }}</td>
								<td class="table-meta-cell">
									<strong>
										<span class="main-text">{{ line.departureCity }}</span>
										<i class="fa-solid fa-arrow-right-long"></i>
										<span>{{ line.arrivalCity }}</span>
									</strong>
									<div class="text-gray text-size-11">{{ line.name }} ({{ line.stopsCount }} arrêts)</div>
								</td>
								<td>{{ line.distance|number_format(0, ',', ' ') }} Km</td>
								<td>{{ line.duration }}</td>
								<td>
									{% if line.baseFareLabel %}
										<strong>{{ line.baseFareLabel }}</strong>
									{% else %}
										<span class="text-gray italic text-size-12">Non tarifé</span>
									{% endif %}
								</td>
								<td>
									{% if line.isAvailable %}
										<span class="badge badge-success px-5 py-2 text-white border-radius-5">Opérationnelle</span>
									{% else %}
										<span class="badge badge-danger px-5 py-2 text-white border-radius-5">Suspendue</span>
									{% endif %}
								</td>
								<td class="actions">
									<a href="{{ path('admin_agency_line_show', {'slug': line.slug}) }}" class="table-action-trigger validate" title="Détails">
										<i class="fa-solid fa-eye"></i>
									</a>
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="7" class="text-center text-gray italic padding-20">
									Aucune ligne configurée dans votre agence pour le moment.
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

	</div>
{% endblock %}
