{# templates/admin/agency/trip/manifest_pdf.html.twig #}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>Manifeste Voyage {{ trip.tripNumber }}</title>
    
        <style>
            /* IMPORTATION SÉCURISÉE DES ICÔNES POUR DOMPDF */
            @import url("https://cloudflare.com");

            /* CONFIGURATION DE TA NOUVELLE PALETTE COULEURS D'USINE [MNS] */
            body {
                font-family: "Helvetica", "Arial", sans-serif;
                color: #000000;
                font-size: 11px;
                line-height: 1.4;
                background: #ffffff;
                padding: 0;
                margin: 0;
            }
            .manifest-sheet-paper {
                padding: 10px;
                position: relative;
            }

            /* Layout En-tête */
            .table-layout-header {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 25px;
                border-bottom: 2px solid #0c326d;
                padding-bottom: 12px;
            }
            .agency-logo-text {
                font-size: 20px;
                font-weight: 900;
                color: #ef6e17;
                letter-spacing: -0.5px;
                margin: 0;
                text-transform: uppercase;
            }
            .agency-sub-legal {
                font-size: 10px;
                font-weight: bold;
                color: #4b5563;
                margin: 2px 0 0 0;
            }
            .manifest-main-title {
                font-size: 22px;
                font-weight: 900;
                text-align: right;
                margin: 0;
                color: #0c326d;
            }
            .trip-number-badge {
                background: #afd3e7;
                color: #0c326d;
                padding: 4px 12px;
                border-radius: 4px;
                font-weight: bold;
                font-size: 12px;
                margin-top: 6px;
                display: inline-block;
                font-family: monospace;
            }
            .route-sub-text {
                font-size: 11px;
                color: #4b5563;
                font-weight: bold;
                text-align: right;
                margin-top: 5px;
            }

            /* Fiche Technique Logistique */
            .table-layout-logistics {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 25px;
            }
            .logistics-box-td {
                width: 31%;
                padding: 12px;
                background: #ffffff;
                border: 1px solid #afd3e7;
                border-radius: 6px;
                vertical-align: top;
            }
            .table-spacer-td {
                width: 3.5%;
            }
            .section-micro-label {
                font-size: 8.5px;
                font-weight: bold;
                color: #ef6e17;
                text-transform: uppercase;
                margin-bottom: 6px;
                display: block;
                letter-spacing: 0.5px;
            }
            .info-text {
                font-size: 11px;
                margin: 4px 0;
                color: #000000;
            }
            .info-text strong {
                color: #0c326d;
            }

            /* Tableau du Manifeste des Passagers */
            .table-print-manifest-spec {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 25px;
            }
            .table-print-manifest-spec th {
                background: rgba(12, 50, 109, 0.05);
                border-bottom: 2px solid #0c326d;
                padding: 10px 12px;
                font-size: 9.5px;
                text-transform: uppercase;
                text-align: left;
                color: #0c326d;
                font-weight: bold;
            }
            .table-print-manifest-spec td {
                padding: 10px 12px;
                border-bottom: 1px solid #afd3e7;
                font-size: 11.5px;
                color: #000000;
                vertical-align: middle;
            }

            /* Alignements & Typographies */
            .text-center {
                text-align: center;
            }
            .text-right {
                text-align: right;
            }
            .monospace {
                font-family: monospace;
                font-size: 11px;
            }
            .font-bold {
                font-weight: bold;
            }
            .sub-meta-text {
                color: #4b5563;
                font-size: 10px;
                font-weight: normal;
            }

            /* Statuts passagers sémantiques */
            .badge-status {
                padding: 3px 8px;
                border-radius: 4px;
                font-size: 9px;
                font-weight: bold;
                text-transform: uppercase;
                display: inline-block;
            }
            .status-confirmed {
                background: rgba(22, 132, 197, 0.08);
                color: #1684c5;
                border: 1px solid rgba(22, 132, 197, 0.2);
            }
            .status-pending {
                background: rgba(217, 69, 22, 0.08);
                color: #d94516;
                border: 1px solid rgba(217, 69, 22, 0.2);
            }

            /* Clôture de sécurité */
            .manifest-print-footer-legal {
                border-top: 1px dashed #afd3e7;
                padding-top: 15px;
                font-size: 9px;
                color: #4b5563;
                text-align: center;
                margin-top: 30px;
            }
            .total-summary-count {
                float: left;
                font-size: 11px;
                font-weight: bold;
                color: #ffffff;
                background: #0c326d;
                padding: 6px 14px;
                border-radius: 4px;
            }
            .clear-fix {
                clear: both;
            }
        </style>
    </head>
    <body>

        <div class="manifest-sheet-paper">
    
            {# 1. EN-TÊTE COMPAGNIE ET VOYAGE #}
            <table class="table-layout-header">
                <tr>
                    <td style="width: 55%; vertical-align: top;">
                        <h2 class="agency-logo-text"><i class="fa-solid fa-bus"></i> {{ agency_name|default('Compagnie Partenaire') }}</h2>
                        <p class="agency-sub-legal">Réseau National d'Exploitation Voyageurs</p>
                    </td>
                    <td style="width: 45%; text-align: right; vertical-align: top;">
                        <h1 class="manifest-main-title">MANIFESTE DE BORD</h1>
                        <div class="trip-number-badge">{{ trip.tripNumber }}</div>
                        <div class="route-sub-text"><i class="fa-solid fa-route"></i> Ligne : {{ trip.route }}</div>
                    </td>
                </tr>
            </table>

            {# 2. CONFIGURATION LOGISTIQUE #}
            <table class="table-layout-logistics">
                <tr>
                    <td class="logistics-box-td">
                        <span class="section-micro-label"><i class="fa-solid fa-clock"></i> Planification Horaire</span>
                        <p class="info-text"><strong>Date :</strong> {{ trip.departureDate|date('d/m/Y') }}</p>
                        <p class="info-text"><strong>Départ :</strong> {{ trip.departureTime }}</p>
                        <p class="info-text"><strong>Arrivée Est. :</strong> {{ trip.arrivalTime }}</p>
                    </td>
                    <td class="table-spacer-td"></td>
                    <td class="logistics-box-td">
                        <span class="section-micro-label"><i class="fa-solid fa-truck-monster"></i> Affectation Matérielle</span>
                        <p class="info-text"><strong>Bus :</strong> {{ trip.bus }}</p>
                        <p class="info-text"><strong>Plaque :</strong> <span class="monospace font-bold">{{ trip.plate }}</span></p>
                        <p class="info-text"><strong>Capacité :</strong> {{ trip.capacity }} Sièges</p>
                    </td>
                    <td class="table-spacer-td"></td>
                    <td class="logistics-box-td">
                        <span class="section-micro-label"><i class="fa-solid fa-user-shield"></i> Équipage en Mission</span>
                        <p class="info-text"><strong>Chauffeur :</strong> {{ trip.driver }}</p>
                        <p class="info-text"><strong>Co-Chauffeur :</strong> {{ trip.coDriver }}</p>
                        <p class="info-text"><strong>Statut :</strong> {{ trip.statusLabel }}</p>
                    </td>
                </tr>
            </table>

            {# 3. REGISTRE NOMINATIF DES PASSAGERS #}
            <table class="table-print-manifest-spec">
                <thead>
                    <tr>
                        <th style="width: 15%;"><i class="fa-solid fa-chair"></i> N° Siège</th>
                        <th style="width: 33%;"><i class="fa-solid fa-user"></i> Nom complet du Passager</th>
                        <th style="width: 25%;"><i class="fa-solid fa-arrows-left-right"></i> Segment</th>
                        <th style="width: 17%;"><i class="fa-solid fa-phone"></i> Téléphone</th>
                        <th class="text-right" style="width: 10%;">État</th>
                    </tr>
                </thead>
                <tbody>
                    {% for passenger in passengers_list %}
                        <tr>
                            <td class="monospace font-bold">
                                {{ passenger.seat }} 
                                <span class="sub-meta-text">({{ passenger.category }})</span>
                            </td>
                            <td><span class="font-bold">{{ passenger.name }}</span></td>
                            <td>{{ passenger.route_segment }}</td>
                            <td class="monospace">{{ passenger.phone }}</td>
                            <td class="text-right">
                                <span class="badge-status {% if passenger.status == 'confirmed' %}status-confirmed{% else %}status-pending{% endif %}">
                                    <i class="fa-solid {% if passenger.status == 'confirmed' %}fa-circle-check{% else %}fa-clock{% endif %}"></i>
                                    {{ passenger.status == 'confirmed' ? 'Confirmé' : 'Réservé' }}
                                </span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-gray italic" style="padding: 20px;">Aucun voyageur enrôlé sur cette feuille de route.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {# 4. RÉCAPITULATIF #}
            <div style="margin-top: 15px;">
                <div class="total-summary-count">
                    <i class="fa-solid fa-users-line"></i> Total Passagers Embarqués : {{ passengers_list|length }} / {{ trip.capacity }}
                </div>
                <div class="clear-fix"></div>
            </div>

            <div class="manifest-print-footer-legal">
                <p>
                    Feuille de route officielle émise par l'agence d'exploitation MyDigitrans. 
                    Ce manifeste doit obligatoirement être certifié par le chef de gare et remis aux forces de l'ordre lors des contrôles routiers.
                </p>
            </div>

        </div>

    </body>
</html>
