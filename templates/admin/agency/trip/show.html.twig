{# templates/admin/agency/trip/show.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-agency-trip-show-scope container">

		{# --- EN-TÊTE DE LA PAGE DÉTAILS --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_trip_index') }}" class="agency-back-action" title="Retour à la liste">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<h2>Voyage N° {{ trip.tripNumber }}</h2>
					<div class="mt-5 sub-header-flex">
						<span class="badge {{ trip.badgeClass }}">{{ trip.statusLabel }}</span>
						<span class="text-gray text-size-13">
							Ligne : {{ trip.route }}
							{% if trip.via %}via {{ trip.via }}{% endif %}
						</span>
					</div>
				</div>
			</div>

			{# --- ZONE D'ACTION BILLETTERIE & MANIFESTE --- #}
			<div class="admin-action-zone ticket-booking-actions">
				{% if trip.status in ['scheduled', 'boarding'] %}
					{% if is_granted('ticket.write') %}
						<a href="{{ path('admin_agency_trip_direct_purchase', {'code': trip.code}) }}" class="btn-refined btn-success-gradient">
							<i class="fa-solid fa-cart-shopping"></i>
							Achat Direct (Billet)
						</a>
					{% endif %}

					{% if is_granted('reservation.write') %}
						<a href="{{ path('admin_agency_reservation_add', {'code': trip.code}) }}" class="btn-refined btn-primary-gradient">
							<i class="fa-solid fa-file-invoice"></i>
							Faire une Réservation
						</a>
					{% endif %}
				{% endif %}

				<a href="{{ path('admin_agency_trip_manifest_pdf', {'code': trip.code}) }}" class="btn-refined btn-dark-gradient" target="_blank">
					<i class="fa-solid fa-print"></i>
					Imprimer le Manifeste
				</a>
			</div>
		</header>

		{# --- BARRE DE PILOTAGE DU STATUT (WORKFLOW) --- #}
		{% set stepOrder = {'scheduled': 1, 'boarding': 2, 'departed': 3, 'arrived': 4, 'cancelled': 0} %}
		{% set currentStep = stepOrder[trip.status]|default(0) %}

		<div class="trip-workflow-card mb-25">
			<div class="workflow-steps-indicator">
				<div class="step-item {{ currentStep > 1 ? 'step-item--passed' : (currentStep == 1 ? 'step-item--active' : '') }}">
					<span class="step-badge">1</span>
					<span class="step-label">Planifié</span>
				</div>
				<i class="fa-solid fa-chevron-right arrow-divider"></i>

				<div class="step-item {{ currentStep > 2 ? 'step-item--passed' : (currentStep == 2 ? 'step-item--active' : '') }}">
					<span class="step-badge">2</span>
					<span class="step-label">Embarquement</span>
				</div>
				<i class="fa-solid fa-chevron-right arrow-divider"></i>

				<div class="step-item {{ currentStep > 3 ? 'step-item--passed' : (currentStep == 3 ? 'step-item--active' : '') }}">
					<span class="step-badge">3</span>
					<span class="step-label">En Route</span>
				</div>
				<i class="fa-solid fa-chevron-right arrow-divider"></i>

				<div class="step-item {{ currentStep == 4 ? 'step-item--active' : '' }}">
					<span class="step-badge">4</span>
					<span class="step-label">Arrivé</span>
				</div>
			</div>

			{% if is_granted('trip.write') and trip.status not in ['arrived', 'cancelled'] %}
				<div class="workflow-actions-buttons">
					{% if trip.status == 'scheduled' %}
						<form method="POST" action="{{ path('admin_agency_trip_status', {'code': trip.code}) }}" style="display:inline;">
							<input type="hidden" name="_token" value="{{ csrf_token('trip_status_' ~ trip.code) }}">
							<input type="hidden" name="target_status" value="boarding">
							<button type="submit" class="btn btn-success-action">
								<i class="fa-solid fa-door-open"></i>
								Ouvrir l'Embarquement
							</button>
						</form>
					{% elseif trip.status == 'boarding' %}
						<form method="POST" action="{{ path('admin_agency_trip_status', {'code': trip.code}) }}" style="display:inline;">
							<input type="hidden" name="_token" value="{{ csrf_token('trip_status_' ~ trip.code) }}">
							<input type="hidden" name="target_status" value="departed">
							<button type="submit" class="btn btn-success-action">
								<i class="fa-solid fa-bus"></i>
								Clôturer & Faire partir
							</button>
						</form>
					{% elseif trip.status == 'departed' %}
						<form method="POST" action="{{ path('admin_agency_trip_status', {'code': trip.code}) }}" style="display:inline;">
							<input type="hidden" name="_token" value="{{ csrf_token('trip_status_' ~ trip.code) }}">
							<input type="hidden" name="target_status" value="arrived">
							<button type="submit" class="btn btn-success-action">
								<i class="fa-solid fa-flag-checkered"></i>
								Confirmer l'Arrivée
							</button>
						</form>
					{% endif %}

					{% if trip.status in ['scheduled', 'boarding'] %}
						<button type="button" class="btn btn-danger-action" id="open-cancel-trip-modal">
							<i class="fa-solid fa-rectangle-xmark"></i>
							Annuler
						</button>
					{% endif %}

				</div>
			{% endif %}
		</div>

		{# --- LAYOUT DEUX COLONNES --- #}
		<div class="trip-dashboard-layout">

			{# BLOC LOGISTIQUE #}
			<div class="layout-sidebar-card">
				<div class="card-inner-box">
					<h3 class="box-title">
						<i class="fa-solid fa-circle-info"></i>
						Détails Logistiques
					</h3>
					<div class="info-section-row">
						<label class="section-micro-label">PLANIFICATION HORAIRE</label>
						<p class="info-text">
							<strong>Départ :</strong>
							{{ trip.departureDate|date('d/m/Y') }} à {{ trip.departureTime }}
						</p>
						<p class="info-text">
							<strong>Embarquement :</strong>
							{{ trip.departureBranch }}
						</p>
						<p class="info-text">
							<strong>Arrivée estimée :</strong>
							{{ trip.arrivalDate|date('d/m/Y') }} à {{ trip.arrivalTime }}
						</p>
						<p class="info-text">
							<strong>Débarquement :</strong>
							{{ trip.arrivalBranch }}
						</p>
					</div>

					
					<div class="info-section-row bordered-divider">
						<label class="section-micro-label">AFFECTATION MATÉRIELLE</label>
						<p class="info-text">
							<strong>Bus :</strong>
							{{ trip.bus }}
						</p>
						<p class="info-text">
							<strong>Immatriculation :</strong>
							<span class="monospace font-bold">{{ trip.plate }}</span>
						</p>
						<p class="info-text">
							<strong>Capacité :</strong>
							{{ trip.capacity }} Sièges vendables
						</p>
					</div>
					<div class="info-section-row bordered-divider">
						<label class="section-micro-label">ÉQUIPAGE EN MISSION</label>
						<p class="info-text">
							<strong>Chauffeur :</strong>
							{{ trip.driver }}
						</p>
						<p class="info-text">
							<strong>Co-Chauffeur :</strong>
							{{ trip.coDriver }}
						</p>
					</div>
				</div>
			</div>

			{# BLOC MANIFESTE #}
			<div class="layout-main-card">
				<div class="card-inner-box">
					<div class="box-header-title mb-15">
						<h3 class="box-title">
							<i class="fa-solid fa-users"></i>
							Manifeste des Voyageurs ({{ passengers_list|length }} / {{ trip.capacity }})
						</h3>
						<p class="text-gray text-size-12">Liste nominative des passagers enregistrés sur ce départ.</p>
					</div>

					<table class="table table-scrollable table-striped js-datatable">
						<thead>
							<tr>
								<th>N° Siège</th>
								<th>Nom du passager</th>
								<th>Segment (Trajet)</th>
								<th>Téléphone</th>
								<th class="text-right">Statut</th>
							</tr>
						</thead>
						<tbody>
							{% for passenger in passengers_list %}
								<tr>
									<td>
										<strong>{{ passenger.seat }}</strong>
										<span class="sub-meta-text">({{ passenger.category }})</span>
									</td>
									<td>
										<strong>{{ passenger.name }}</strong>
									</td>
									<td>{{ passenger.route_segment }}</td>
									<td>{{ passenger.phone }}</td>
									<td class="text-right">
										{% if passenger.status == 'confirmed' %}
											<span class="badge-status-confirmed">Confirmé</span>
										{% else %}
											<span class="badge-status-pending">Réservé</span>
										{% endif %}
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="5" class="text-center text-gray italic padding-20">
										Aucun voyageur enregistré sur ce départ pour le moment.
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>

		</div>
	</div>

	{# MODAL SPECIAL  #}
	{% if is_granted('trip.write') and trip.status in ['scheduled', 'boarding'] %}
		<div id="cancel-trip-modal" class="mdt-modal-backdrop" aria-hidden="true">
			<div class="mdt-modal-card" role="dialog" aria-modal="true" aria-labelledby="cancel-trip-title">
				<div class="mdt-modal-header">
					<div class="mdt-modal-icon-danger">
						<i class="fa-solid fa-triangle-exclamation"></i>
					</div>
					<div>
						<h3 id="cancel-trip-title">Annuler le voyage {{ trip.tripNumber }}</h3>
						<p class="text-gray text-size-12">Cette action est irréversible et sera tracée dans le journal d'audit.</p>
					</div>
				</div>

				<form method="POST" action="{{ path('admin_agency_trip_status', {'code': trip.code}) }}">
					<input type="hidden" name="_token" value="{{ csrf_token('trip_status_' ~ trip.code) }}">
					<input type="hidden" name="target_status" value="cancelled">

					<div class="mdt-modal-body">
						<p class="mb-15 text-size-13">
							Vous êtes sur le point d'annuler le départ <strong>{{ trip.route }}</strong> prévu le
							<strong>{{ trip.departureDate|date('d/m/Y') }} à {{ trip.departureTime }}</strong>.
						</p>

						<div class="field">
							<label for="trip_cancel_reason" class="admin-bus-layout-add-label">Motif de l'annulation *</label>
							<textarea
							id="trip_cancel_reason"
							name="cancel_reason"
							rows="3"
							class="admin-bus-layout-add-input"
							placeholder="Ex : Panne mécanique imprévue, force majeure, fusion de départ..."
							required
						></textarea>
						</div>
					</div>

					<div class="mdt-modal-footer">
						<button type="button" class="btn-refined btn-gray-gradient" id="close-cancel-trip-modal">
							Conserver le voyage
						</button>
						<button type="submit" class="btn-refined btn-danger-gradient">
							<i class="fa-solid fa-ban"></i>
							Confirmer l'annulation
						</button>
					</div>
				</form>
			</div>
		</div>

		<style>
			.mdt-modal-backdrop {
				position: fixed;
				inset: 0;
				background: rgba(12, 50, 109, 0.55);
				backdrop-filter: blur(3px);
				display: none;
				align-items: center;
				justify-content: center;
				z-index: 9999;
				padding: 16px;
			}
			.mdt-modal-backdrop.is-open {
				display: flex;
			}
			.mdt-modal-card {
				background: #ffffff;
				border-radius: 12px;
				width: 100%;
				max-width: 480px;
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
				border-top: 4px solid #d94516;
				overflow: hidden;
				animation: mdtModalPop 0.18s ease-out;
			}
			@keyframes mdtModalPop {
				from {
					opacity: 0;
					transform: scale(0.95);
				}
				to {
					opacity: 1;
					transform: scale(1);
				}
			}
			.mdt-modal-header {
				display: flex;
				align-items: center;
				gap: 14px;
				padding: 20px 24px 14px;
				border-bottom: 1px solid #e5e7eb;
			}
			.mdt-modal-header h3 {
				margin: 0;
				font-size: 16px;
				color: #0c326d;
			}
			.mdt-modal-icon-danger {
				width: 42px;
				height: 42px;
				border-radius: 50%;
				background: rgba(217, 69, 22, 0.12);
				color: #d94516;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 18px;
				flex-shrink: 0;
			}
			.mdt-modal-body {
				padding: 18px 24px;
			}
			.mdt-modal-footer {
				display: flex;
				justify-content: flex-end;
				gap: 10px;
				padding: 14px 24px 20px;
				background: #f9fafb;
				border-top: 1px solid #e5e7eb;
			}
		</style>

		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const modal = document.getElementById("cancel-trip-modal");
				const openBtn = document.getElementById("open-cancel-trip-modal");
				const closeBtn = document.getElementById("close-cancel-trip-modal");

				if (!modal || !openBtn) return;

				openBtn.addEventListener("click", () => {
					modal.classList.add("is-open");
					modal.setAttribute("aria-hidden", "false");
					modal.querySelector("textarea")?.focus();
				});

				const closeModal = () => {
					modal.classList.remove("is-open");
					modal.setAttribute("aria-hidden", "true");
				};

				closeBtn?.addEventListener("click", closeModal);
				modal.addEventListener("click", (e) => {
					if (e.target === modal) closeModal();
				});
				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && modal.classList.contains("is-open"))
						closeModal();
				});
			});
		</script>
	{% endif %}

{% endblock %}
