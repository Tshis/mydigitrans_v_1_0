{# templates/admin/agency/trip/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div
		class="admin-trip-wrapper container"
	>

		{% for message in app.flashes('success') %}
			<div class="notice-box-info mt-20"><p><i class="fa-solid fa-circle-check"></i> {{ message }}</p></div>
		{% endfor %}

		{# --- EN-TÊTE DE LA PAGE --- #}
		<header class="header-refined my-30">
			<div class="header-left">
				<div class="breadcrumb-mini">
					<span>Logistique</span>
					<i class="fa-solid fa-chevron-right"></i>
					<strong>Plan de voyage</strong>
				</div>
				<h1>
					<i class="fa-solid fa-calendar-days"></i>
					Gestion des Voyages / Départs
				</h1>
				<p class="subtitle">Planifiez les départs et suivez les embarquements en temps réel.</p>
			</div>

			<div class="header-right">
				<a href="{{ path('admin_agency_trip_add') }}" class="btn-refined btn-success-gradient text-size-12">
					<i class="fa-solid fa-plus"></i>
					Planifier un voyage
				</a>
			</div>
		</header>

		{# --- CARTES DE STATISTIQUES --- #}
		<div class="stats-overview-grid">
			<div class="stat-card">
				<div class="stat-icon stat-icon--primary">
					<i class="fa-solid fa-calendar-days"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Voyages du jour</span>
					<strong class="stat-value">{{ stats.today }}</strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--success">
					<i class="fa-solid fa-bus"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">En Embarquement</span>
					<strong class="stat-value">{{ stats.boarding }}</strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--danger">
					<i class="fa-solid fa-circle-check"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Voyages Terminés</span>
					<strong class="stat-value">{{ stats.completed }}</strong>
				</div>
			</div>
		</div>

		{# --- ZONE DE RECHERCHE ET DE FILTRE AVANCÉ (3 CHAMPS CORRIGÉ) --- #}
		<div class="trip-filters-card mb-20">
			<form action="{{ path('admin_agency_trip_index') }}" method="GET">
				<div
					class="field-group"
				>
					{# Champ 1 : Date #}
					<div class="field">
						<label class="admin-bus-layout-add-label">Rechercher par date exacte</label>
						<input type="date" name="filter_date" class="admin-bus-layout-add-input" value="{{ filters.date }}">
					</div>

					{# NOUVEAU - Champ 2 : Ligne Commerciale / Itinéraire #}
					<div class="field">
						<label class="admin-bus-layout-add-label">Filtrer par Ligne / Itinéraire</label>
						<select name="filter_route" class="admin-bus-layout-add-select">
							<option value="">-- Toutes les lignes commerciales --</option>
							{% for r in route_options %}
								<option value="{{ r.id }}" {{ filters.route == r.id ? 'selected' : '' }}>{{ r.label }}</option>
							{% endfor %}
						</select>
					</div>

					{# Champ 3 : État opérationnel #}
					<div class="field">
						<label class="admin-bus-layout-add-label">Filtrer par état opérationnel</label>
						<select name="filter_status" class="admin-bus-layout-add-select">
							<option value="">-- Tous les états --</option>
							<option value="scheduled" {{ filters.status == 'scheduled' ? 'selected' : '' }}>Planifiés (Futurs)</option>
							<option value="boarding" {{ filters.status == 'boarding' ? 'selected' : '' }}>En Embarquement</option>
							<option value="departed" {{ filters.status == 'departed' ? 'selected' : '' }}>En route</option>
							<option value="completed" {{ filters.status == 'completed' ? 'selected' : '' }}>Terminés (Passés)</option>
							<option value="cancelled" {{ filters.status == 'cancelled' ? 'selected' : '' }}>Annulés</option>
						</select>
					</div>
				</div>
				<div class="field-button-right mt-10">
					<button type="submit" class="btn-refined btn-dark-gradient">
						<i class="fa-solid fa-magnifying-glass"></i>
						Rechercher...
					</button>
				</div>
			</form>
		</div>

		{# --- TABLEAU DES DONNÉES DATATABLE AVEC SCROLL RESPONSIVE --- #}
		<div class="table-responsive-wrapper">
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Date & Départ</th>
						<th>Ligne / Itinéraire</th>
						<th>Véhicule / Équipage</th>
						<th>Remplissage</th>
						<th>Statut</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for trip in trips %}
						<tr>
							<td>
								<strong>{{ trip.date|date('d/m/Y') }}</strong>
								<span class="sub-meta-text">À {{ trip.time }}</span>
							</td>
							<td>
								<strong>{{ trip.route }}</strong>
								{% if trip.via %}
									<span class="sub-meta-text">via {{ trip.via }}</span>
								{% endif %}
							</td>
							<td>
								<strong>{{ trip.bus }}</strong>
								{% if trip.bus_model %}({{ trip.bus_model }}){% endif %}
								<span class="sub-meta-text">Chauffeur : {{ trip.driver }}</span>
							</td>
							<td>
								<strong>{{ trip.taken }} / {{ trip.capacity }}</strong>
								places
								<span class="sub-meta-text">({{ trip.percent }}%)</span>
							</td>
							<td>
								<span class="{{ trip.badge }}">{{ trip.status_label }}</span>
							</td>
							<td class="text-right">
								<div class="action-group-refined">
									<a href="{{ path('admin_agency_trip_direct_purchase', {'code': trip.code}) }}" class="action-link config" title="Vente directe">
										<i class="fa-regular fa-money-bill-1"></i>
									</a>
									<a href="{{ path('admin_agency_reservation_add', {'code': trip.code}) }}" class="action-link config" title="Réserver">
										<i class="fa-solid fa-file-circle-plus"></i>
									</a>
									<a href="{{ path('admin_agency_trip_show', {'code': trip.code}) }}" class="action-link config" title="Détails du voyage">
										<i class="fa-solid fa-eye"></i>
									</a>
								</div>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

	</div>
{% endblock %}
