{# templates/admin/agency/trip/add.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/admin/trip-add.js" defer></script>
{% endblock %}

{% block body %}
	<div
		class="admin-agency-trip-add-scope container">
		{# --- HEADER DE LA CONSOLE OPERATIONNELLE --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_trip_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">MyDigitrans Opérations</span>
						<span class="arrow-divider">•</span>
						<span class="text-gray text-size-13 text-highlight">Planification</span>
					</div>
					<h1 class="mt-5">Programmer un Voyage</h1>
				</div>
			</div>

		</header>

		{# --- LAYOUT A DEUX COLONNES STANDARDISÉ --- #}
		<form id="trip-plan-form" action="#" method="POST" class="agency-trip-add-form">
			<div
				class="agency-trip-add-container">

				{# COLONNE GAUCHE : FORMULAIRE DE SAISIE #}
				<div
					class="layout-main-panel">

					{# COMPOSANT 1 : AFFECTATION DU MATÉRIEL #}
					<div class="card control-card mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-bus text-primary"></i>
							Affectation du Matériel &
							                        Trajet</h2>

						<div class="direct-pricing-row">
							<div class="field">
								<label class="admin-bus-layout-add-label">Ligne / Route Réseau</label>
								<select name="route_id" class="admin-bus-layout-add-select" required>
									<option value="">-- Choisir la ligne --</option>
									{% for r in routes %}
										<option value="{{ r.id }}">{{ r.code }}
											:
											{{ r.name }}</option>
									{% endfor %}
								</select>
							</div>

							<div class="field">
								<label class="admin-bus-layout-add-label">Bus Assigné</label>
								<select name="bus_id" class="admin-bus-layout-add-select" required>
									<option value="">-- Choisir un véhicule --</option>
									{% for b in buses %}
										<option value="{{ b.id }}">{{ b.plate }}
											—
											{{ b.model }}</option>
									{% endfor %}
								</select>
							</div>
						</div>
					</div>

					{# COMPOSANT 2 : ÉQUIPAGE DE BORD #}
					<div class="card control-card mb-20 success-accent">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-id-card text-success"></i>
							Équipage de Bord</h2>

						<div class="direct-pricing-row">
							<div class="field">
								<label class="admin-bus-layout-add-label">Chauffeur Titulaire</label>
								<select name="driver_id" class="admin-bus-layout-add-select" required>
									<option value="">-- Sélectionner le conducteur --</option>
									{% for d in drivers %}
										<option value="{{ d.id }}">{{ d.name }}</option>
									{% endfor %}
								</select>
							</div>

							<div class="field">
								<label class="admin-bus-layout-add-label">Convoyeur / Co-Chauffeur</label>
								<select name="codriver_id" class="admin-bus-layout-add-select">
									<option value="">-- Aucun convoyeur --</option>
									{% for d in drivers %}
										<option value="{{ d.id }}">{{ d.name }}</option>
									{% endfor %}
								</select>
							</div>
						</div>
					</div>

					{# COMPOSANT 3 : CALENDRIER ET HORAIRES #}
					<div class="card control-card mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-clock text-warning"></i>
							Calendrier et Horaires
						</h2>

						<div class="direct-pricing-row mb-20">
							<div class="field">
								<label class="admin-bus-layout-add-label">Date de Départ</label>
								<input type="date" name="departureDate" class="matrix-input" value="{{ " now"|date("Y-m-d") }}" required>
							</div>
							<div class="field">
								<label class="admin-bus-layout-add-label">Heure de Départ</label>
								<input type="time" name="departureTime" class="matrix-input" value="06:00" required>
							</div>
						</div>

						<div class="direct-pricing-row">
							<div class="field">
								<label class="admin-bus-layout-add-label">Date d'Arrivée Estimée</label>
								<input type="date" name="arrivalDate" class="matrix-input" value="{{ " now"|date("Y-m-d") }}" required>
							</div>
							<div class="field">
								<label class="admin-bus-layout-add-label">Heure d'Arrivée Estimée</label>
								<input type="time" name="arrivalTime" class="matrix-input" value="18:00" required>
							</div>
						</div>
					</div>
				</div>

				{# COLONNE DROITE : RÉSUMÉ & AUTOMATISMES SAAS #}
				<aside class="summary">
					<div class="card summary-sticky-card">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-gears"></i>
							Traitement Réseau</h2>

						<div class="notice-box mb-15">
							<p>
								<strong>
									<i class="fa-solid fa-bolt"></i>
									Génération en cascade :</strong>
								La validation va
								                            créer automatiquement l'ensemble des enregistrements de la table **14. TripSeat**
								                            correspondants au gabarit du bus.</p>
						</div>

						<div class="notice-box mb-20">
							<p>
								<strong>
									<i class="fa-solid fa-shield-halved"></i>
									Protection Caisse :</strong>
								La contrainte
								                            d'unicité sur les couples sièges empêchera tout doublon lors des ventes simultanées.</p>
						</div>

						<hr class="summary-divider">

						<button type="submit" class="btn btn-success btn-full py-12 mt-20">
							<i class="fa-solid fa-calendar-check"></i>
							Planifier le Départ
						</button>
					</div>
				</aside>

			</div>
		</form>
	</div>
{% endblock %}
