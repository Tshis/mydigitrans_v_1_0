{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/admin/fare_line_add.js" defer></script>
{% endblock %}

{% block body %}

	<div
		class="admin-fare-matrix-scope container">
		{# --- HEADER STICKY --- #}
		<header class="header header-sticky mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_line_show', {'slug': route.slug}) }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Console MyDigitrans</span>
						<span class="arrow-divider">•</span>
						<span class="text-gray text-size-13 text-highlight">Configuration des Prix</span>
					</div>
					<h1>Gestion Tarifaire</h1>
				</div>
			</div>
			<div class="header-actions">
				<button type="submit" form="bulk-fare-form" class="btn btn-success btn-save-main">
					<i class="fa-solid fa-cloud-arrow-up"></i>
					Enregistrer les tarifs
				</button>
			</div>
		</header>

		<form
			id="bulk-fare-form" action="#" method="POST">
			{# --- ZONE DE CONTRÔLE SUPÉRIEURE (Alignement parfait) --- #}
			<div class="matrix-top-control-grid mb-25">
				<div class="card control-card">
					<div class="field">
						<label class="admin-bus-layout-add-label">
							<i class="fa-solid fa-map-location-dot"></i>
							Choisir un itinéraire :</label>
						<select id="js-master-route-picker" class="admin-bus-layout-add-select">
							{% for r in all_routes %}
								<option value="{{ r.slug }}" {% if r.slug==route.slug %} selected {% endif %}>{{ r.code }}
									:
									{{ r.name }}</option>
							{% endfor %}
						</select>
					</div>
				</div>

				<div class="card control-card success-accent">
					<div class="direct-pricing-row">
						<div class="field">
							<label>Prix Billet Direct
								<small>({{ route.start_city }}
									➔
									{{ route.end_city }})</small>
							</label>
							<input type="number" name="direct_amount" class="matrix-input main-price" value="{{ route.direct_amount }}">
						</div>
						<div class="field">
							<label>Prix Fret / Kg</label>
							<input type="number" name="direct_fret" class="matrix-input main-price" value="{{ route.price_per_kg }}">
						</div>
						<div class="field currency-field">
							<label>Devise</label>
							<select name="matrix_currency" class="matrix-select">
								{% for curr in active_currencies %}
									<option value="{{ curr.code }}" {% if route.currency==curr.code %} selected {% endif %}>{{
                                curr.code }}</option>
								{% endfor %}
							</select>
						</div>
					</div>
				</div>
			</div>

			{# --- GRILLE DES TRONÇONS (Design en boîtes avec scroll responsive) --- #}
			<div class="matrix-table-wrapper">
				<div class="matrix-toolbar">
					<h3>
						<i class="fa-solid fa-route"></i>
						Découpage des Tronçons Intermédiaires
					</h3>
				</div>

				<div class="responsive-scroll-container">
					<table class="table-fare-matrix">
						<thead>
							<tr>
								<th>Tronçon de Voyage</th>
								<th>Distance</th>
								<th>Prix du Billet</th>
								<th>Prix Fret / Kg</th>
								<th class="text-center">Statut</th>
							</tr>
						</thead>
						<tbody>
							{% for segment in segments %}
								<tr class="matrix-row">
									<td class="segment-cell">
										<div class="segment-path">
											<span class="city">{{ segment.from_city|default(route.start_city) }}</span>
											<i class="fa-solid fa-arrow-right"></i>
											<span class="city">{{ segment.to_city }}</span>
										</div>
										<input type="hidden" name="fares[{{ loop.index }}][to_id]" value="{{ segment.to_id }}">
									</td>
									<td class="dist-cell">
										<strong>{{ segment.distance }}</strong>
										<small>Km</small>
									</td>
									<td>
										<div class="input-with-icon">
											<input type="number" name="fares[{{ loop.index }}][amount]" class="matrix-input" value="{{ segment.current_amount }}" step="0.01">
										</div>
									</td>
									<td>
										<div class="input-with-icon">
											<input type="number" name="fares[{{ loop.index }}][price_per_kg]" class="matrix-input" value="{{ segment.current_fret }}" step="0.01">
										</div>
									</td>
									<td class="text-center">
										<label class="switch-ios">
											<input type="checkbox" name="fares[{{ loop.index }}][is_active]" checked>
											<span class="slider"></span>
										</label>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		</form>
	</div>


{% endblock %}
