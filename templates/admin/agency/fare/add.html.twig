{# templates/admin/agency/fare/add.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/admin/fare_line_add.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-fare-matrix-scope container">
		{# --- HEADER STICKY --- #}
		<header class="header header-sticky mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_line_show', {'slug': route.slug}) }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Console MyDigitrans</span>
						<span class="arrow-divider">•</span>
						<span class="text-gray text-size-13 text-highlight">Configuration des Prix</span>
					</div>
					<h1>Gestion Tarifaire</h1>
				</div>
			</div>
			<div class="header-actions">
				<button type="submit" form="bulk-fare-form" class="btn btn-success btn-save-main">
					<i class="fa-solid fa-cloud-arrow-up"></i>
					Enregistrer les tarifs
				</button>
			</div>
		</header>

		{# --- FORMULAIRE SYMFONY LIÉ AU DTO FareMatrixData --- #}
		{{ form_start(form, {'attr': {'id': 'bulk-fare-form', 'novalidate': 'novalidate'}}) }}

			{{ form_errors(form) }}

			{# --- ZONE DE CONTRÔLE SUPÉRIEURE --- #}
			<div class="matrix-top-control-grid mb-25">
				<div class="card control-card">
					<div class="field mb-15">
						<label class="admin-bus-layout-add-label">
							<i class="fa-solid fa-map-location-dot"></i>
							Choisir un itinéraire :
						</label>
						<select
							id="js-master-route-picker"
							class="admin-bus-layout-add-select"
							onchange="window.location.href = '{{ path('admin_agency_fare_line_add', {'slug': '__SLUG__'}) }}'.replace('__SLUG__', this.value);"
						>
							{% for r in all_routes %}
								<option value="{{ r.slug }}" {% if r.slug == route.slug %}selected{% endif %}>
									{{ r.code }} : {{ r.name }}
								</option>
							{% endfor %}
						</select>
					</div>

					<div class="field">
						{{ form_label(form.fareType, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
						{{ form_widget(form.fareType, {
							'attr': {
								'class': 'admin-bus-layout-add-select',
								'onchange': "window.location.href = '" ~ path('admin_agency_fare_line_add', {'slug': route.slug}) ~ "?fareType=' + this.value;"
							}
						}) }}
						<div class="text-danger text-size-12 mt-5">{{ form_errors(form.fareType) }}</div>
					</div>
				</div>

				<div class="card control-card success-accent">
					<div class="direct-pricing-row">
						<div class="field">
							<label>
								Prix Billet Direct
								<small>({{ route.start_city }} ➔ {{ route.end_city }})</small>
							</label>
							{{ form_widget(form.directAmount) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.directAmount) }}</div>
						</div>
						<div class="field">
							<label>Prix Fret / Kg</label>
							{{ form_widget(form.directFret) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.directFret) }}</div>
						</div>
						<div class="field currency-field">
							<label>Devise</label>
							{{ form_widget(form.currencyCode) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.currencyCode) }}</div>
						</div>
					</div>
				</div>
			</div>

			{# --- GRILLE DES TRONÇONS --- #}
			<div class="matrix-table-wrapper">
				<div class="matrix-toolbar">
					<h3>
						<i class="fa-solid fa-route"></i>
						Découpage des Tronçons Intermédiaires
					</h3>
				</div>

				<div class="responsive-scroll-container">
					<table class="table-fare-matrix">
						<thead>
							<tr>
								<th>Tronçon de Voyage</th>
								<th>Distance</th>
								<th>Prix du Billet</th>
								<th>Prix Fret / Kg</th>
								<th class="text-center">Statut</th>
							</tr>
						</thead>
						<tbody>
							{% for segmentForm in form.segments %}
								{% set segData = segmentForm.vars.data %}
								<tr class="matrix-row">
									<td class="segment-cell">
										<div class="segment-path">
											<span class="city">{{ segData.fromCity }}</span>
											<i class="fa-solid fa-arrow-right"></i>
											<span class="city">{{ segData.toCity }}</span>
										</div>
										{{ form_widget(segmentForm.fromStopId) }}
										{{ form_widget(segmentForm.toStopId) }}
									</td>
									<td class="dist-cell">
										<strong>{{ segData.distance|number_format(0, ',', ' ') }}</strong>
										<small>Km</small>
									</td>
									<td>
										<div class="input-with-icon">
											{{ form_widget(segmentForm.amount) }}
										</div>
										<div class="text-danger text-size-11 mt-5">{{ form_errors(segmentForm.amount) }}</div>
									</td>
									<td>
										<div class="input-with-icon">
											{{ form_widget(segmentForm.pricePerKg) }}
										</div>
										<div class="text-danger text-size-11 mt-5">{{ form_errors(segmentForm.pricePerKg) }}</div>
									</td>
									<td class="text-center">
										<label class="switch-ios">
											{{ form_widget(segmentForm.isActive) }}
											<span class="slider"></span>
										</label>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="5" class="text-center text-gray italic padding-20">
										Cette ligne est un trajet direct sans escales intermédiaires. Configurez uniquement le tarif direct ci-dessus.
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>

			{% do form.segments.setRendered %}

		{{ form_end(form) }}
	</div>
{% endblock %}
