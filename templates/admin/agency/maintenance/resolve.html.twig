{# templates/admin/agency/maintenance/resolve.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
    <div class="admin-agency-maintenance-resolve-scope container">
        {# --- HEADER --- #}
        <header class="header mb-25">
            <a href="{{ path('admin_agency_maintenance_index') }}" class="agency-back-action" title="Retour à l'atelier">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div class="title">
                <div class="sub-header-flex">
                    <span class="text-gray text-size-13">Logistique & Atelier</span>
                    <span class="arrow-divider">•</span>
                    <span class="text-success text-size-13 font-bold">Clôture d'Intervention</span>
                </div>
                <h1 class="mt-5">Résoudre la Panne & Remettre en Service</h1>
            </div>
        </header>

        {# --- FORMULAIRE SYMFONY LIÉ AU DTO BusMaintenanceResolveData --- #}
        {{ form_start(form, {'attr': {'class': 'maintenance-form-layout', 'novalidate': 'novalidate'}}) }}

            <div class="maintenance-container-grid">
                {# COLONNE GAUCHE : RAPPEL INCIDENT + RAPPORT DE RÉPARATION #}
                <div class="main-form-panel">

                    {{ form_errors(form) }}

                    {# CARD 1 : FICHE DE L'INCIDENT EN COURS #}
                    <div class="card control-card error-accent mb-20">
                        <h2 class="card-title-fix">
                            <i class="fa-solid fa-triangle-exclamation text-danger"></i>
                            Diagnostic & Avarie Signalée
                        </h2>

                        <div class="direct-pricing-row mb-20">
                            <div class="field">
                                <label>Véhicule immobilisé</label>
                                <p class="info-value font-bold">
                                    <i class="fa-solid fa-bus text-danger"></i>
                                    {{ bus.brand }} {{ bus.model }} ({{ bus.code }})
                                </p>
                                <span class="text-gray text-size-12">Plaque : {{ bus.plateNumber }} • {{ bus.mileage|number_format(0, ',', ' ') }} km</span>
                            </div>

                            <div class="field">
                                <label>Gravité & Date de constatation</label>
                                <p class="info-value font-bold">
                                    Niveau : {{ log.severity.value|upper }}
                                </p>
                                <span class="text-gray text-size-12">Signalé le {{ log.reportedAt|date('d/m/Y à H\\hi') }}</span>
                            </div>
                        </div>

                        <div class="direct-pricing-row">
                            <div class="field">
                                <label>Description initiale de la panne</label>
                                <div class="matrix-textarea" style="height: auto; min-height: 60px; white-space: pre-line;">{{ log.solution|default('Aucun détail renseigné') }}</div>
                            </div>
                        </div>
                    </div>

                    {# CARD 2 : RAPPORT DE RÉPARATION #}
                    <div class="card control-card success-accent">
                        <h2 class="card-title-fix">
                            <i class="fa-solid fa-circle-check text-success"></i>
                            Rapport d'Intervention Technique
                        </h2>

                        <div class="direct-pricing-row mb-20">
                            <div class="field">
                                {{ form_label(form.resolvedAt) }}
                                {{ form_widget(form.resolvedAt, {'attr': {'class': 'admin-bus-layout-add-input'}}) }}
                                <div class="text-danger text-size-12 mt-5">{{ form_errors(form.resolvedAt) }}</div>
                            </div>
                            <div class="field">
                                <label>Agent Validateur</label>
                                <input type="text" class="admin-bus-layout-add-input text-disabled" value="{{ app.user.fullName|default(app.user.email) }}" readonly>
                            </div>
                        </div>

                        <div class="direct-pricing-row mb-20">
                            <div class="field">
                                {{ form_label(form.solutionDescription) }}
                                {{ form_widget(form.solutionDescription, {'attr': {'class': 'matrix-textarea'}}) }}
                                <div class="text-danger text-size-12 mt-5">{{ form_errors(form.solutionDescription) }}</div>
                            </div>
                        </div>

                        <hr class="section-divider mb-15">
                        <div class="field-button-right">
                            <a href="{{ path('admin_agency_maintenance_index') }}" class="btn-refined btn-gray-gradient mr-10">Annuler</a>
                            <button type="submit" class="btn-refined btn-success-gradient">
                                <i class="fa-solid fa-circle-check"></i>
                                Valider la sortie du garage
                            </button>
                        </div>
                    </div>
                </div>

                {# COLONNE DROITE : IMPACT REMISE EN SERVICE #}
                <aside class="sidebar-action-panel">
                    <div class="card control-card success-accent sticky-aside-card">
                        <h2 class="card-title-fix">
                            <i class="fa-solid fa-shield-halved text-success"></i>
                            Remise en Service
                        </h2>
                        <div class="notice-box mb-15">
                            <p>
                                <i class="fa-solid fa-bus"></i>
                                La validation de ce rapport clôture le ticket de maintenance et fait repasser automatiquement le véhicule au statut <strong class="text-success-mode">En Service</strong>.
                            </p>
                        </div>
                        <div class="notice-box">
                            <p>
                                <i class="fa-solid fa-calendar-check"></i>
                                Le véhicule redeviendra immédiatement sélectionnable lors de la planification des prochains départs.
                            </p>
                        </div>
                    </div>
                </aside>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
