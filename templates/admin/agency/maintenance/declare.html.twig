{# templates/admin/agency/maintenance/declare.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div class="admin-agency-fleet-document-add-scope container">
		{# --- HEADER --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_maintenance_index') }}" class="agency-back-action" title="Retour à l'atelier">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Logistique & Atelier</span>
						<span class="arrow-divider">•</span>
						<span class="text-danger text-size-13 text-highlight">Immobilisation Technique</span>
					</div>
					<h1 class="mt-5">Déclarer une Panne</h1>
				</div>
			</div>
		</header>

		{# --- FORMULAIRE SYMFONY LIÉ AU DTO BusMaintenanceDeclareData --- #}
		{{ form_start(form, {'attr': {'class': 'document-form-layout', 'novalidate': 'novalidate'}}) }}

			<div class="document-container-grid">
				{# COLONNE GAUCHE : FORMULAIRE DE SIGNALEMENT #}
				<div class="main-form-panel">

					{{ form_errors(form) }}

					<div class="card control-card mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-bus text-danger"></i>
							Identification du Véhicule & Gravité
						</h2>

						<div class="direct-pricing-row mb-20">
							<div class="field">
								{{ form_label(form.busCode, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
								{{ form_widget(form.busCode, {'attr': {'class': 'admin-bus-layout-add-select'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.busCode) }}</div>
							</div>
							<div class="field">
								{{ form_label(form.severity, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
								{{ form_widget(form.severity, {'attr': {'class': 'admin-bus-layout-add-select'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.severity) }}</div>
							</div>
						</div>

						<div class="direct-pricing-row mb-20">
							<div class="field">
								{{ form_label(form.issuedAt, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
								{{ form_widget(form.issuedAt, {'attr': {'class': 'admin-bus-layout-add-input'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.issuedAt) }}</div>
							</div>
							<div class="field">
								{{ form_label(form.mileage, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
								{{ form_widget(form.mileage, {'attr': {'class': 'admin-bus-layout-add-input'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.mileage) }}</div>
							</div>
						</div>

						<div class="field mb-20">
							{{ form_label(form.issueDescription, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
							{{ form_widget(form.issueDescription, {'attr': {'class': 'admin-bus-layout-add-input'}}) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.issueDescription) }}</div>
						</div>

						<div class="field mb-15">
							<label class="admin-bus-layout-add-label">Agent déclarant</label>
							<input type="text" class="admin-bus-layout-add-input text-disabled" value="{{ app.user.fullName|default(app.user.email) }}" readonly>
						</div>

						<hr class="section-divider mb-15">
						<div class="field-button-right">
							<a href="{{ path('admin_agency_maintenance_index') }}" class="btn-refined btn-gray-gradient mr-10">Annuler</a>
							<button type="submit" class="btn-refined btn-danger-gradient" {{ form.busCode.vars.choices is empty ? 'disabled' : '' }}>
								<i class="fa-solid fa-triangle-exclamation"></i>
								Enregistrer la panne et envoyer au garage
							</button>
						</div>
					</div>
				</div>

				{# COLONNE DROITE : IMPACT OPÉRATIONNEL #}
				<aside class="sidebar-action-panel">
					<div class="card sticky-aside-card">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-circle-info text-primary"></i>
							Impact Flotte
						</h2>
						<div class="notice-box-info">
							<p>
								<i class="fa-solid fa-wrench"></i>
								Dès la validation, ce bus passera automatiquement au statut <strong>Au Garage</strong> et ne pourra plus être affecté à de nouveaux départs tant que la panne ne sera pas résolue.
							</p>
						</div>
					</div>
				</aside>
			</div>
		{{ form_end(form) }}
	</div>
{% endblock %}
