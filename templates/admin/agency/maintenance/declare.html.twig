{# templates/admin/agency/maintenance/declare.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div class="admin-agency-maintenance-add-scope container">
		{# --- HEADER --- #}
		<header class="header-refined mb-25">

			<div class="header-main-info">
				<a href="{{ path('admin_agency_maintenance_index') }}" class="agency-back-action" title="Retour à l'atelier">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="breadcrumb-mini">
						<span>Logistique & Atelier</span>
						<i class="fa-solid fa-chevron-right"></i>
						<strong>Immobilisation Technique</strong>
					</div>
					<h1>Déclarer une Panne</h1>
					<p class="subtitle">Enregistrez une avarie mécanique ou électrique pour immobiliser le véhicule à l'atelier.</p>
				</div>
			</div>
		</header>

		{# --- FORMULAIRE SYMFONY LIÉ AU DTO BusMaintenanceDeclareData --- #}
		{{ form_start(form, {'attr': {'class': 'maintenance-form-layout', 'novalidate': 'novalidate'}}) }}

			<div class="maintenance-container-grid">
				{# COLONNE GAUCHE : FORMULAIRE DE SIGNALEMENT #}
				<div class="main-form-panel">

					{{ form_errors(form) }}

					<div class="card control-card danger-accent mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-bus text-danger"></i>
							Identification du Véhicule & Gravité
						</h2>

						<div class="fields-row mb-20">
							<div class="field">
								{{ form_label(form.busCode) }}
								{{ form_widget(form.busCode, {'attr': {'class': 'matrix-select'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.busCode) }}</div>
							</div>
							<div class="field">
								{{ form_label(form.severity) }}
								{{ form_widget(form.severity, {'attr': {'class': 'matrix-select'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.severity) }}</div>
							</div>
						</div>

						<div class="fields-row mb-20">
							<div class="field">
								{{ form_label(form.issuedAt) }}
								{{ form_widget(form.issuedAt, {'attr': {'class': 'matrix-input'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.issuedAt) }}</div>
							</div>
							<div class="field">
								{{ form_label(form.mileage) }}
								{{ form_widget(form.mileage, {'attr': {'class': 'matrix-input'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.mileage) }}</div>
							</div>
						</div>

						<div class="fields-row mb-20">
							<div class="field">
								{{ form_label(form.issueDescription) }}
								{{ form_widget(form.issueDescription, {'attr': {'class': 'matrix-textarea'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.issueDescription) }}</div>
							</div>
						</div>

						<div class="fields-row mb-15">
							<div class="field">
								<label>Agent déclarant</label>
								<input type="text" class="matrix-input text-disabled" value="{{ app.user.fullName|default(app.user.email) }}" readonly>
							</div>
						</div>

						<hr class="section-divider mb-15">
						<div class="field-button-right">
							<a href="{{ path('admin_agency_maintenance_index') }}" class="btn-refined btn-gray-gradient mr-10">Annuler</a>
							<button type="submit" class="btn-refined btn-danger-gradient" {{ form.busCode.vars.choices is empty ? 'disabled' : '' }}>
								<i class="fa-solid fa-triangle-exclamation"></i>
								Enregistrer la panne et envoyer au garage
							</button>
						</div>
					</div>
				</div>

				{# COLONNE DROITE : IMPACT OPÉRATIONNEL #}
				<aside class="sidebar-action-panel">
					<div class="sticky-aside-card">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-circle-info text-primary"></i>
							Impact Flotte
						</h2>
						<div class="notice-box-info">
							<p>
								<i class="fa-solid fa-wrench"></i>
								Dès la validation, ce bus passera automatiquement au statut <strong>Au Garage</strong> et ne pourra plus être affecté à de nouveaux départs tant que la panne ne sera pas résolue.
							</p>
						</div>
					</div>
				</aside>
			</div>
		{{ form_end(form) }}
	</div>
{% endblock %}
