{# templates/admin/agency/cashier/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div
		class="admin-cashier-dashboard-scope container">

		{# --- EN-TÊTE DE LA PAGE (Fidèle à votre modèle de voyage) --- #}
		<header class="header mb-20">
			<div class="title">
				<h2>
					<i class="fa-solid fa-cash-register"></i>
					Gestion des Caisses & Sessions [MCD 19]
				</h2>
				<p>Supervisez les terminaux de vente, contrôlez les dotations matinales et validez les clôtures de fin de service.</p>
			</div>
			<div class="admin-bus-layout-add-action-zone">
				<a href="#" class="btn btn-success text-size-12" onclick="alert('Action statique : Configuration d\'un nouveau guichet physique');">
					<i class="fa-solid fa-plus"></i>
					Nouveau guichet physique
				</a>
			</div>
		</header>

		{# --- CARTES DE STATISTIQUES COMPTABLES --- #}
		<div class="stats-overview-grid mb-20">
			<div class="stat-card">
				<div class="stat-icon stat-icon--success">
					<i class="fa-solid fa-door-open"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Sessions Actives</span>
					<strong class="stat-value">3 Guichets</strong>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--primary">
					<i class="fa-solid fa-vault"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Total Espèces Estimé</span>
					<strong class="stat-value text-success">1 875 000 FC</strong>
					<span class="sub-meta-text">+ 450.00 USD</span>
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon stat-icon--danger">
					<i class="fa-solid fa-triangle-exclamation"></i>
				</div>
				<div class="stat-details">
					<span class="stat-label">Alertes Écarts Clôture</span>
					<strong class="stat-value text-danger">1 En Attente</strong>
				</div>
			</div>
		</div>

		{# --- ZONE DE FILTRE AVANCÉ (3 CHAMPS DU MODÈLE) --- #}
		<div class="trip-filters-card mb-20">
			<form action="#">
				<div
					class="field-group">
					{# Filtre 1 : Succursale #}
					<div class="field">
						<label class="admin-bus-layout-add-label">Filtrer par Succursale</label>
						<select name="filter_branch" class="admin-bus-layout-add-select">
							<option value="">-- Toutes les succursales --</option>
							<option value="1">Kinshasa Centre (Gare Centrale)</option>
							<option value="2">Succursale Goma</option>
							<option value="3">Succursale Matadi</option>
						</select>
					</div>

					{# Filtre 2 : Statut de la Session #}
					<div class="field">
						<label class="admin-bus-layout-add-label">État de la session (status)</label>
						<select name="filter_status" class="admin-bus-layout-add-select">
							<option value="">-- Tous les états --</option>
							<option value="open">open (Session active au guichet)</option>
							<option value="closed">closed (Fermée, en attente du gérant)</option>
							<option value="validated">validated (Comptabilité close et déchargée)</option>
						</select>
					</div>

					{# Filtre 3 : Recherche Agent #}
					<div class="field">
						<label class="admin-bus-layout-add-label">Rechercher par Caissier</label>
						<input type="text" name="filter_agent" class="admin-bus-layout-add-input" placeholder="Nom du guichetier...">
					</div>
				</div>
				<div class="field-button-right mt-10">
					<button type="submit" class="btn btn-dark">
						<i class="fa-solid fa-magnifying-glass"></i>
						Filtrer les sessions...
					</button>
				</div>
			</form>
		</div>

		{# --- TABLEAU DES SESSIONS DE CAISSE (DATATABLE) --- #}
		<div class="table-responsive-wrapper">
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Guichet / Code</th>
						<th>Succursale</th>
						<th>Caissier Assigné</th>
						<th>Dotation → Attendu</th>
						<th>Statut BDD</th>
						<th>Actions Comptables</th>
					</tr>
				</thead>
				<tbody>
					{# Ligne 1 : Session validée et archivée (Terminée) #}
					<tr>
						<td>
							<strong>Guichet Billetterie Principal</strong>
							<span class="sub-meta-text">Code : CSH-KIN-01</span>
						</td>
						<td>Kinshasa Centre</td>
						<td>
							<strong>Jean Mukendi</strong>
							<span class="sub-meta-text">Clôturé le 13/08 à 18h30</span>
						</td>
						<td>
							<strong>50 000 FC</strong>
							→
							<span class="text-success-mode font-bold">1 470 000 FC</span>
							<span class="sub-meta-text">Équivalence : 450.00 USD</span>
						</td>
						<td>
							<span class="badge-status-validated">validated</span>
						</td>
						<td class="actions">
							<a href="#" class="table-action-btn bg-mute" title="Consulter l'archive d'inventaire">
								<i class="fa-solid fa-eye"></i>
							</a>
						</td>
					</tr>

					{# Ligne 2 : Session FERMÉE par le caissier, ATTENTE validation gérant (Cas d'école avec écart) #}
					<tr>
						<td>
							<strong>Guichet Fret & Colis</strong>
							<span class="sub-meta-text">Code : CSH-KIN-02</span>
						</td>
						<td>Kinshasa Centre</td>
						<td>
							<strong>Marie Kabedi</strong>
							<span class="sub-meta-text">Fermé ce jour à 18h00</span>
						</td>
						<td>
							<strong>0 USD</strong>
							→
							<span class="text-danger-mode font-bold">435.00 USD</span>
							<span class="sub-meta-text" style="color:#d94516; font-weight:700;">Écart constaté : -15.00 USD</span>
						</td>
						<td>
							<span class="badge-status-closed">closed</span>
						</td>
						<td
							class="actions">
							{# LE BOUTON CLÉ : Ordonne le passage vers l'arbitrage #}
							<a href="" class="table-action-btn btn-gavel-arbitrate" title="Ouvrir l'inventaire contradictoire et signer la décharge">
								<i class="fa-solid fa-gavel"></i>
								Arbitrer & Valider
							</a>
						</td>
					</tr>

					{# Ligne 3 : Session en cours (Guichet actif) #}
					<tr>
						<td>
							<strong>Guichet Transit Standard</strong>
							<span class="sub-meta-text">Code : CSH-GOM-01</span>
						</td>
						<td>Succursale Goma</td>
						<td>
							<strong>Marie-Jeanne Nzuzi</strong>
							<span class="sub-meta-text">Ouvert ce matin à 07h15</span>
						</td>
						<td>
							<strong>30 000 FC</strong>
							→
							<span class="text-success-mode font-bold">420 000 FC</span>
							<span class="sub-meta-text">Flux en direct (Session ouverte)</span>
						</td>
						<td>
							<span class="badge-status-open">open</span>
						</td>
						<td class="actions">
							<a href="#" class="table-action-btn bg-mute" title="Voir le journal des ventes en direct">
								<i class="fa-solid fa-chart-line"></i>
							</a>
						</td>
					</tr>
				</tbody>
			</table>
		</div>

	</div>
{% endblock %}
