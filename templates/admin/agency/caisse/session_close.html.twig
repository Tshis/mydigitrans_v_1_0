{# templates/admin/agency/cashier/close.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
{{ parent() }}
<script src="/js/cashier-close.js" defer></script>
{% endblock %}

{% block body %}
<div class="admin-cashier-session-scope container">

	{# --- EN-TÊTE DE LA PAGE --- #}
	<header class="header mb-25">
		<div class="title">
			<h2>
				<i class="fa-solid fa-lock"></i>
				Clôture et Verrouillage de la Session
			</h2>
			<p>Fin de service : comptez vos espèces physiques et validez votre versement pour générer le bilan d'audit.
			</p>
		</div>
	</header>

	{# --- CONFIGURATION DES DEUX COLONNES --- #}
	<div class="session-init-container">

		{# GAUCHE : FORMULAIRE DE COMPTAGE DE FIN DE SERVICE #}
		<div class="card">
			<h2><i class="fa-solid fa-calculator"></i> Déclaration des espèces physiques en main</h2>
			<form action="#" method="POST" id="session-close-form">

				{# Saisie physique par le caissier #}
				<div class="field-group mb-15 flex-gap-15">
					<div class="field flex-full">
						<label class="session-micro-label">Total physique compté en CDF *</label>
						<input type="number" name="closing_cdf" id="closing-cdf" class="input-session-field"
							placeholder="0" min="0" required>
						<span class="sub-meta-text">Somme totale des billets en Francs Congolais à remettre au
							gérant.</span>
					</div>
					<div class="field flex-full">
						<label class="session-micro-label">Total physique compté en USD *</label>
						<input type="number" name="closing_usd" id="closing-usd" class="input-session-field"
							placeholder="0" min="0" required>
						<span class="sub-meta-text">Somme totale des billets en Dollars à remettre au gérant.</span>
					</div>
				</div>

				<div class="field mb-15">
					<label class="session-micro-label">Rapport de passation / Notes de clôture</label>
					<textarea class="input-session-field text-area-fixed"
						placeholder="Mentionnez les incidents de paiement, les billets suspects refusés ou les détails des décaissements effectués..."></textarea>
				</div>

				<div class="block-action-wrapper">
					<button type="submit" class="btn-submit-open btn-danger-close">
						<i class="fa-solid fa-vault"></i> Soumettre le rapport & Verrouiller le guichet
					</button>
				</div>
			</form>
		</div>

		{# DROITE : ARRET DE COMPTE THÉORIQUE (Généré par les flux de votre MCD) #}
		<aside class="summary">
			<div class="card summary-sticky-card alert-session-box alert-close-box">
				<h2><i class="fa-solid fa-chart-pie"></i> Solde Théorique Attendu</h2>

				<div class="meta-item mb-15">
					<span class="session-micro-label">Session ID</span>
					<strong class="text-dark">SESS-2026-0814</strong>
					<span class="sub-meta-text">Agent : Jean Mukendi (Guichet 01)</span>
				</div>

				{# Calculs cumulés de la journée issus de la BDD #}
				<div class="meta-item prev-session-audit-box">
					<span class="session-micro-label text-highlight">Espèces attendues en CDF</span>
					<p class="dotation-values-display" id="expected-cdf-display" data-expected="1470000">1 470 000 CDF
					</p>
					<span class="sub-meta-text">(Dotation : 50 000 FC + Ventes : 1 420 000 FC)</span>
				</div>

				<div class="meta-item prev-session-audit-box mt-10">
					<span class="session-micro-label text-highlight" style="color: #1684c5;">Espèces attendues en
						USD</span>
					<p class="dotation-values-display font-usd" id="expected-usd-display" data-expected="450">450 USD
					</p>
					<span class="sub-meta-text">(Dotation : 0 $ + Ventes : 450 $)</span>
				</div>

				<hr class="summary-divider mb-15">

				<div class="meta-item">
					<span class="sub-meta-text"><i class="fa-solid fa-triangle-exclamation"></i> Règle de
						versement</span>
					<span class="sub-meta-text" style="margin-top: 5px;">Votre déclaration doit correspondre à ces
						montants. Tout écart (manquant ou surplus) sera consigné pour arbitrage managérial.</span>
				</div>
			</div>
		</aside>

	</div>

</div>


<script>
	/**
* Mydigitrans SaaS - Module Caisse
* Interception et calcul des écarts de clôture comptable
*/
	document.addEventListener('DOMContentLoaded', () => {
		const closeForm = document.getElementById('session-close-form');
		const inputCdf = document.getElementById('closing-cdf');
		const inputUsd = document.getElementById('closing-usd');

		// Récupération des attendus techniques injectés dans les attributs HTML data-
		const expectedCdf = parseFloat(document.getElementById('expected-cdf-display').getAttribute('data-expected')) || 0;
		const expectedUsd = parseFloat(document.getElementById('expected-usd-display').getAttribute('data-expected')) || 0;

		if (closeForm) {
			closeForm.addEventListener('submit', (e) => {
				const declaredCdf = parseFloat(inputCdf.value) || 0;
				const declaredUsd = parseFloat(inputUsd.value) || 0;

				const diffCdf = declaredCdf - expectedCdf;
				const diffUsd = declaredUsd - expectedUsd;

				// Détection d'un écart (Manquant ou Surplus)
				if (diffCdf !== 0 || diffUsd !== 0) {
					e.preventDefault(); // Suspend l'envoi immédiat

					let alertMessage = `⚠️ ALERT : ÉCART DE CAISSE DÉTECTÉ EN FIN DE SERVICE\n\n`;

					if (diffCdf < 0) alertMessage += `• Manquant CDF : ${Math.abs(diffCdf)} CDF (Argent manquant physiquement)\n`;
					if (diffCdf > 0) alertMessage += `• Surplus CDF : +${diffCdf} CDF (Excédent non répertorié)\n`;

					if (diffUsd < 0) alertMessage += `• Manquant USD : -${Math.abs(diffUsd)} USD\n`;
					if (diffUsd > 0) alertMessage += `• Surplus USD : +${diffUsd} USD\n`;

					alertMessage += `\nVotre session va être verrouillée avec ce bilan d'écart. Ce rapport sera transmis au gérant de succursale pour inventaire contradictoire. Souhaitez-vous confirmer ?`;

					if (confirm(alertMessage)) {
						alert('Session close. Le guichet est désormais verrouillé.');
						// Le formulaire se soumettra et Doctrine enregistrera la valeur de diffCdf/diffUsd dans le champ `difference`
					}
				} else {
					alert('Félicitations ! Caisse parfaitement équilibrée. Session close.');
				}
			});
		}
	});

</script>
{% endblock %}