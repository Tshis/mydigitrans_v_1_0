{# templates/admin/agency/user/form.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div
		class="admin-agency-user-form-scope container">
		{# --- HEADER DYNAMIQUE --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_user_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Administration</span>
						<span class="arrow-divider">•</span>
						<span class="text-gray text-size-13 text-highlight">
							{{ isEdit ? 'Habilitations RBAC [MCD 3]' : 'Nouveau Collaborateur [MCD 3]' }}
						</span>
					</div>
					<h1 class="mt-5">{{ isEdit ? 'Modifier le Compte Agent' : 'Créer un Nouvel Utilisateur' }}</h1>
				</div>
			</div>
			<div class="header-actions">
				<button type="submit" form="user-master-form" class="btn btn-success">
					<i class="fa-solid {{ isEdit ? 'fa-user-check' : 'fa-user-plus' }}"></i>
					<span>{{ isEdit ? 'Enregistrer les modifications' : 'Déployer le compte' }}</span>
				</button>
			</div>
		</header>

		{# --- FORMULAIRE UNIQUE MULTI-RÔLES --- #}
		<form id="user-master-form" action="#" method="POST" class="user-form-layout">
			<div
				class="user-container-grid">

				{# COLONNE GAUCHE : IDENTITÉ & RATTACEMENT #}
				<div
					class="main-form-panel">

					{# CARD 1 : IDENTITÉ DE L'AGENT (MCD 3) #}
					<div class="card control-card mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-id-card text-primary"></i>
							Identité Civile de l'Agent</h2>

						<div class="direct-pricing-row mb-20">
							<div class="field">
								<label class="admin-bus-layout-add-label">Prénom (firstname) *</label>
								<input type="text" name="firstname" class="admin-bus-layout-add-input" value="{{ isEdit ? agent.firstname : '' }}" placeholder="Ex: Antoinette" required>
							</div>
							<div class="field">
								<label class="admin-bus-layout-add-label">Nom de famille (lastname) *</label>
								<input type="text" name="lastname" class="admin-bus-layout-add-input" value="{{ isEdit ? agent.lastname : '' }}" placeholder="Ex: Mputu" required>
							</div>
						</div>

						<div class="direct-pricing-row">
							<div class="field">
								<label class="admin-bus-layout-add-label">Adresse Email Professionnelle *</label>
								<input type="email" name="email" class="admin-bus-layout-add-input" value="{{ isEdit ? agent.email : '' }}" placeholder="Ex: a.mputu@mydigitrans.cd" required>
							</div>
							<div class="field">
								<label class="admin-bus-layout-add-label">Numéro de Téléphone mobile *</label>
								<input type="text" name="phone" class="admin-bus-layout-add-input font-bold" value="{{ isEdit ? agent.phone : '' }}" placeholder="Ex: +243 897 112 233" required>
							</div>
						</div>

						{# Le mot de passe n'est requis qu'à la création #}
						{% if not isEdit %}
							<div class="direct-pricing-row mt-20">
								<div class="field">
									<label class="admin-bus-layout-add-label">Mot de passe initial *</label>
									<input type="password" name="password" class="admin-bus-layout-add-input" placeholder="••••••••" required>
								</div>
							</div>
						{% endif %}
					</div>

					{# CARD 2 : PIVOT RATTACEMENT MULTI-TENANT (MCD 3 & 5) #}
					<div class="card control-card success-accent">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-circle-nodes text-success"></i>
							Périmètre d'Affectation Réseau</h2>

						<div class="direct-pricing-row">
							<div class="field">
								<label class="admin-bus-layout-add-label">Type d'utilisateur (userType) *</label>
								<select name="user_type" class="admin-bus-layout-add-select" required>
									<option value="agency" {% if isEdit and agent.userType == 'agency' %} selected {% endif %}>Personnel Interne Agence (Standard)</option>
									<option value="partner" {% if isEdit and agent.userType == 'partner' %} selected {% endif %}>Partenaire / Sous-traitant Logistique</option>
								</select>
							</div>
							<div class="field">
								<label class="admin-bus-layout-add-label">Succursale d'affectation (branch) *</label>
								<select name="branch_code" class="admin-bus-layout-add-select">
									<option value="">-- Siège Central (Accès Général) --</option>
									{% for branch in branches %}
										<option value="{{ branch.code }}" {% if isEdit and agent.branchCode == branch.code %} selected {% endif %}>{{ branch.name }}
											(#{{ branch.code }})</option>
									{% endfor %}
								</select>
							</div>
						</div>
					</div>
				</div>

				{# COLONNE DROITE : ATTRIBUTION DES RÔLES & STATUT DU COMPTE #}
				<aside
					class="sidebar-action-panel">

					{# COMPOSANT RBAC : SÉLECTION DES RÔLES (MCD 4 & 5) #}
					<div class="card control-card mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-user-shield text-primary"></i>
							Rôles & Habilitations (RBAC)</h2>
						<div class="field">
							<label class="admin-bus-layout-add-label">Attribuer un Rôle Système *</label>
							<select name="role_code" class="admin-bus-layout-add-select" required>
								<option value="">-- Choisir un profil de droits --</option>
								{% for role in available_roles %}
									<option value="{{ role.code }}" {% if isEdit and agent.currentRoleCode == role.code %} selected {% endif %} title="{{ role.description }}">{{ role.name }}
										({{ role.code }})</option>
								{% endfor %}
							</select>
						</div>
					</div>

					{# BLOC ACTIVATION COMPTE (MCD 3) #}
					<div class="card sticky-aside-card">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-sliders text-gray"></i>
							État du Compte</h2>
						<div class="field mb-20">
							<label class="admin-bus-layout-add-label">Autoriser la connexion</label>
							<select name="is_active" class="admin-bus-layout-add-select" required>
								<option value="1" {% if not isEdit or agent.isActive %} selected {% endif %}>Compte Actif (Accès autorisé)</option>
								<option value="0" {% if isEdit and not agent.isActive %} selected {% endif %}>Compte Bloqué (Connexion interdite)</option>
							</select>
						</div>
						<hr class="section-divider my-15">
						<div class="notice-box-info">
							<p>
								<i class="fa-solid fa-bolt"></i>
								Les permissions (<strong>Permission</strong>) associées à ce rôle s'appliqueront automatiquement à l'agent lors de sa prochaine authentification.</p>
						</div>
					</div>
				</aside>

			</div>
		</form>
	</div>
{% endblock %}
