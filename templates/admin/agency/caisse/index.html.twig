{# templates/admin/agency/report/financial/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div
		class="admin-agency-report-financial-index-scope container">
		{# --- HEADER --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_reports_center') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Finance</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Registre Comptable</span>
					</div>
					<h1 class="mt-5">Rapport Financier Global</h1>
				</div>
			</div>
		</header>

		{# --- ZONE DE FILTRES ALIGNÉS PAR LE BAS --- #}
		<div class="trip-filters-card mb-20">
			<form action="#" method="GET" class="field-group">
				<div class="field">
					<label class="admin-bus-layout-add-label">Période du</label>
					<input type="date" name="date_from" class="admin-bus-layout-add-input" value="{{ date_from }}">
				</div>
				<div class="field">
					<label class="admin-bus-layout-add-label">Au</label>
					<input type="date" name="date_to" class="admin-bus-layout-add-input" value="{{ date_to }}">
				</div>
				<div class="field">
					<label class="admin-bus-layout-add-label">Succursale</label>
					<select name="branch_code" class="admin-bus-layout-add-select">
						<option value="">-- Toutes les succursales --</option>
						{% for branch in branches_list %}
							<option value="{{ branch.code }}" {% if current_branch == branch.code %} selected {% endif %}>{{ branch.name }}</option>
						{% endfor %}
					</select>
				</div>
				<div class="field-actions">
					<button type="submit" class="btn-refined btn-success-gradient">
						<i class="fa-solid fa-chart-line"></i>
						Filtrer les flux
					</button>
				</div>
			</form>
		</div>

		{# --- STRUCTURE TEXTUELLE DU TABLEAU INTERNE --- #}
		<div class="table-responsive-wrapper">
			<h2 class="card-title-fix text-size-16 py-10">
				<i class="fa-solid fa-money-bill-transfer text-primary"></i>
				Ventilation Financière par Point d'Émission
			</h2>
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Date comptable</th>
						<th>Succursale</th>
						<th class="text-right">Recettes Billetterie</th>
						<th class="text-right">Recettes Colis</th>
						<th class="text-right">Total Brut</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for row in report_matrix %}
						<tr>
							<td>
								<strong>{{ row.date|date('d/m/Y') }}</strong>
							</td>
							<td>
								<span class="branch-code-badge-inline">#{{ row.branchCode }}</span>
								{{ row.branchName }}
							</td>
							<td class="text-right font-bold">
								{{ row.ticketRevenue|number_format(0, ',', ' ') }}
								<small>{{ row.currency }}</small>
							</td>
							<td class="text-right font-bold text-success-mode">
								{{ row.cargoRevenue|number_format(0, ',', ' ') }}
								<small>{{ row.currency }}</small>
							</td>
							<td class="text-right font-bold text-primary-mode">
								{{ (row.ticketRevenue + row.cargoRevenue)|number_format(0, ',', ' ') }}
								<small>{{ row.currency }}</small>
							</td>
							<td class="text-right">
								<div class="action-group-refined">
									<a href="{{ path('admin_agency_report_financial_show', {date: row.date|date('Y-m-d'), branch_code: row.branchCode}) }}" class="action-link edit" title="Voir le détail de cette journée">
										<i class="fa-solid fa-eye"></i>
									</a>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-gray italic padding-20">
								Aucun flux de caisse répertorié.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
