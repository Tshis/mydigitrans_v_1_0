{# templates/admin/agency/trip/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
<div class="admin-agency-trip-index-scope container">
    {# --- HEADER DE CONSOLE --- #}
    <header class="header mb-25">
        <div class="header-main-info">
            <div class="title">
                <div class="sub-header-flex">
                    <span class="text-gray text-size-13">MyDigitrans Opérations</span>
                    <span class="arrow-divider">•</span>
                    <span class="text-gray text-size-13 text-highlight">Planification [MCD 13]</span>
                </div>
                <h1 class="mt-5">Tableau de Bord des Voyages</h1>
            </div>
        </div>
        <div class="header-actions">
            <a href="{{ path('admin_agency_trip_add') }}" class="btn btn-primary">
                <i class="fa-solid fa-calendar-plus"></i> Programmer un voyage
            </a>
        </div>
    </header>

    {# --- CONTENEUR DES DEUX COLONNES ISOLÉ --- #}
    <div class="trip-index-grid-layout">

        {# COLONNE GAUCHE : LISTE DES VOYAGES ET STATISTIQUES #}
        <div class="main-content-panel">

            {# MINI COMPOSANT : KPI STATS QUICK VIEW #}
            <div class="stats-overview-grid mb-20">
                <div class="card stat-mini-card">
                    <div class="icon-box"><i class="fa-solid fa-bus text-primary"></i></div>
                    <div class="stat-info">
                        <span class="label">Actifs aujourd'hui</span>
                        <strong class="value">12 départs</strong>
                    </div>
                </div>
                <div class="card stat-mini-card success-accent">
                    <div class="icon-box"><i class="fa-solid fa-user-check text-success"></i></div>
                    <div class="stat-info">
                        <span class="label">Remplissage Moyen</span>
                        <strong class="value">84 %</strong>
                    </div>
                </div>
            </div>

            {# LA TABLE DES VOYAGES (RESPONSIVE SCROLL) #}
            <div class="card matrix-card">
                <div class="matrix-toolbar">
                    <h3><i class="fa-solid fa-list-check"></i> Manifestes et Plannings de Départ</h3>
                </div>

                <div class="table-responsive-scroll">
                    <table class="table-trip-matrix">
                        <thead>
                            <tr>
                                <th>Code & Itinéraire</th>
                                <th>Équipage de Bord</th>
                                <th>Horaires Réseau</th>
                                <th class="text-center">Occupation</th>
                                <th class="text-center">Statut</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for trip in trips %}
                            <tr class="matrix-row">
                                <td class="trip-main-cell">
                                    <div class="trip-code">#{{ trip.code }}</div>
                                    <div class="route-label">
                                        <strong>{{ trip.route_name }}</strong>
                                    </div>
                                </td>

                                <td class="crew-cel">
                                    <div class="driver"><i class="fa-solid fa-user-tie text-gray"></i> {{
                                        trip.driver_name }}</div>
                                    {% if trip.co_driver_name %}
                                    <div class="codriver"><i class="fa-solid fa-user-shield text-muted"></i> {{
                                        trip.co_driver_name }}</div>
                                    {% endif %}
                                </td>
                                <td class="time-cel">
                                    <div class="date"><i class="fa-solid fa-calendar-day"></i> {{
                                        trip.departure_date|date('d/m/Y') }}</div>
                                    <div class="hours text-muted">Départ à : <strong>{{ trip.departure_time }}</strong>
                                    </div>
                                </td>
                                <td class="text-center fill-cel">
                                    <div class="seats-counter">
                                        <strong>{{ trip.seats_total - trip.seats_available }}</strong> / <span
                                            class="total">{{ trip.seats_total }}</span>
                                    </div>
                                    <small class="text-muted">sièges occupés</small>
                                </td>
                                <td class="text-center">
                                    {# Badges de statut configurables selon tes styles #}
                                    <span class="badge-status {{ trip.status }}">
                                        {{ trip.status|upper }}
                                    </span>
                                </td>
                                <td class="text-right action-cell">
                                    <div class="action-buttons-group">
                                        <a href="#" class="btn-action-view" title="Manifeste passagers"><i
                                                class="fa-solid fa-users-viewfinder"></i></a>
                                        <a href="#" class="btn-action-edit" title="Modifier le voyage"><i
                                                class="fa-solid fa-pen-to-square"></i></a>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# COLONNE DROITE : BARRE DE FILTRES AUTONOME #}
        <aside class="sidebar-filters-panel">
            <div class="card sticky-filter-card">
                <h2 class="card-title-fix"><i class="fa-solid fa-filter text-primary"></i> Filtres de Recherche</h2>

                <div class="filter-field-group">
                    <div class="field">
                        <label>Date de Recherche</label>
                        <input type="date" class="matrix-input" value="{{ " now"|date("Y-m-d") }}">
                    </div>

                    <div class="field">
                        <label>Statut du Voyage</label>
                        <select class="matrix-select">
                            <option value="">-- Tous les statuts --</option>
                            <option value="scheduled">Scheduled (Planifié)</option>
                            <option value="boarding">Boarding (Embarquement)</option>
                            <option value="departed">Departed (En route)</option>
                            <option value="arrived">Arrived (Terminé)</option>
                            <option value="cancelled">Cancelled (Annulé)</option>
                        </select>
                    </div>

                    <div class="field">
                        <label>Véhicule / Bus</label>
                        <input type="text" class="matrix-input" placeholder="Ex: Plaque d'immatriculation">
                    </div>

                    <hr class="filter-divider">

                    <button type="button" class="btn btn-success btn-full py-12">
                        <i class="fa-solid fa-magnifying-glass"></i> Filtrer la Grille
                    </button>
                </div>
            </div>
        </aside>

    </div>
</div>
{% endblock %}