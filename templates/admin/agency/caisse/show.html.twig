{# templates/admin/agency/fleet/show.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div
		class="admin-agency-fleet-show-scope container">
		{# --- EN-TÊTE --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_bus_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Logistique</span>
						<span class="arrow-divider">•</span>
						<span class="text-gray text-size-13 text-highlight">Fiche Véhicule</span>
					</div>
					<h1 class="mt-5">{{ bus.brand }}
						{{ bus.model }}</h1>
				</div>
			</div>
		</header>

		<div
			class="fleet-show-layout">
			{# COLONNE GAUCHE : TECHNIQUE & CARNET DE SANTÉ #}
			<div
				class="main-info-panel">

				{# Fiche technique existante #}
				<div class="card control-card mb-20">
					<h2 class="card-title-fix">
						<i class="fa-solid fa-calculator text-primary"></i>
						Identité Technique & Métriques</h2>
					<div class="fields-display-row">
						<div class="info-block">
							<span class="label">Plaque Immatriculation</span>
							<div class="value-badge-plate">{{ bus.plateNumber }}</div>
						</div>
						<div class="info-block">
							<span class="label">Capacité Commerciale</span>
							<div class="value">
								<strong>{{ bus.capacity }}
									Places</strong>
							</div>
						</div>
						<div class="info-block">
							<span class="label">Kilométrage</span>
							<div class="value">
								<strong>{{ bus.mileage|number_format(0, ',', ' ') }}
									Km</strong>
							</div>
						</div>
					</div>
				</div>

				{# --- NOUVEAU : CARNET DE MAINTENANCE & HISTORIQUE DES PANNES --- #}
				<div class="card control-card storage-card">


					<div class="table-responsive-scroll">
						<table class="table-maintenance-logs">
							<thead>
								<tr>
									<th>Date & Code</th>
									<th>Description de la Panne</th>
									<th>Intervention / Solution</th>
									<th class="text-right">Coût Réparation</th>
									<th class="text-center">Statut</th>
								</tr>
							</thead>
							<tbody>
								{% for log in bus.maintenance_history %}
									<tr class="log-row">
										<td>
											<span class="log-date">{{ log.date|date('d/m/Y') }}</span>
											<div class="log-code">#{{ log.id }}</div>
										</td>
										<td>
											<div class="issue-text">
												<strong>{{ log.issue }}</strong>
											</div>
											<small class="text-gray">Signalé au km
												{{ log.reported_mileage|number_format(0, ',', ' ') }}</small>
										</td>
										<td>
											<div class="solution-text">{{ log.solution|default('En attente de diagnostic...') }}</div>
											{% if log.mechanic %}
												<small class="text-primary">
													<i class="fa-solid fa-wrench"></i>
													{{ log.mechanic }}</small>
											{% endif %}
										</td>
										<td class="text-right amount-cell">
											<strong>{{ log.cost|number_format(0, ',', ' ') }}</strong>
											<small>{{ bus.currency }}</small>
										</td>
										<td class="text-center">
											<span class="pill-maintenance {{ log.status }}">
												{{ log.statusLabel }}
											</span>
										</td>
									</tr>
								{% else %}
									<tr>
										<td colspan="5" class="text-center text-gray italic padding-20">
											Aucun incident technique signalé sur ce véhicule. Excellent état.
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</div>

			{# COLONNE DROITE : CONSOLE DE COMMANDE (Inchangée) #}
			<aside
				class="sidebar-action-panel">{# ... Votre bloc de changement d'état précédent ... #}
			</aside>
		</div>
	</div>
{% endblock %}
