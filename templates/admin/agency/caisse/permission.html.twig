{# templates/admin/agency/permissions/agent_fine_tuning.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div
		class="agency-agent-permission-wrapper container">

		{# --- EN-TÊTE DU PROFIL AGENT --- #}
		<header class="agency-permission-header">
			<div class="agency-profile-block">
				<a href="{{ path('admin_agency_agent_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="agency-profile-meta">
					<h2 class="agency-profile-name">{{ agent.firstname }}
						{{ agent.lastname }}</h2>
					<div class="agency-profile-badge-row">
						<span class="agency-badge-role">{{ agent.roleLabel }}</span>
					</div>
				</div>
			</div>

			<div class="agency-action-bar">
				<button type="submit" form="js-form-permissions" class="agency-btn-control btn btn-success">
					<i class="fa-solid fa-floppy-disk"></i>
					Enregistrer les droits
				</button>
			</div>
		</header>

		{# --- AVERTISSEMENT SÉCURITÉ --- #}
		<div class="agency-security-notice">
			<i class="fa-solid fa-shield-halved"></i>
			<p>
				<strong>Rappel de sécurité :</strong>
				Le mode
				<em>"Écriture seule"</em>
				permet à l'agent de soumettre ou modifier des données à l'aveugle sans pouvoir consulter l'historique ou les listes existantes.
			</p>
		</div>

		{# --- MATRICE DES DROITS GRANULAIRES --- #}
		<div class="agency-permission-card">
			<div class="agency-card-topbar">
				<div>
					<h3 class="agency-card-heading">Permissions Granulaires : Gestion des flux</h3>
					<p class="agency-card-subheading">Ajustez les privilèges d'exécution de l'agent sur chaque segment métier de la succursale.</p>
				</div>
			</div>

			{# Zone de défilement horizontal sécurisé #}
			<div class="responsive-permission-table">
				<form id="js-form-permissions" action="#" method="POST">
					<table class="agency-permission-table">
						<thead>
							<tr>
								<th>Module du Menu & Droits Métiers</th>
								<th class="column-radio-center">Aucun Accès</th>
								<th class="column-radio-center">Lecture Seule</th>
								<th class="column-radio-center">Écriture Seule</th>
								<th class="column-radio-center">Lecture / Écriture</th>
							</tr>
						</thead>
						<tbody>
							{% for module in modules %}
								<tr class="agency-permission-row">
									<td>
										<div class="agency-feature-description">
											<span class="module-icon-inline">
												<i class="fa-solid {{ module.icon }}"></i>
											</span>
											<strong>{{ module.label }}</strong>
											<p>{{ module.description }}</p>
										</div>
									</td>
									<td class="column-radio-center">
										<input type="radio" name="perms[{{ module.key }}]" value="none" class="agency-custom-radio" {% if module.value == 'none' %} checked {% endif %}>
									</td>
									<td class="column-radio-center">
										<input type="radio" name="perms[{{ module.key }}]" value="read" class="agency-custom-radio" {% if module.value == 'read' %} checked {% endif %}>
									</td>
									<td class="column-radio-center">
										<input type="radio" name="perms[{{ module.key }}]" value="write" class="agency-custom-radio" {% if module.value == 'write' %} checked {% endif %}>
									</td>
									<td class="column-radio-center">
										<input type="radio" name="perms[{{ module.key }}]" value="read_write" class="agency-custom-radio" {% if module.value == 'read_write' %} checked {% endif %}>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</form>
			</div>
		</div>
	</div>
{% endblock %}
