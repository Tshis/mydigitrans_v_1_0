{# templates/admin/agency/cashier/journal_caissier.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-agency-cashier-journal-scope container">

		<header class="header-refined my-30">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_cashier_dashboard_branch') }}" class="agency-back-action" title="Retour au tableau de bord manager">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="info">
					<h1>{{ session.openedBy.fullName }}</h1>
					<p class="sub-header-flex">
						<span class="text-gray text-size-13">{{ session.cashRegister.name }} ({{ session.cashRegister.branch.name }})</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Journal de Caisse — {{ sessionCode }}</span>
					</p>
				</div>
			</div>
		</header>

		<div class="layout-main-card">
			<div class="card-inner-box">

				<div class="finance-hero-banner mb-25">
					<div class="hero-amount-zone">
						<span class="audit-label">Fonds physiques en direct dans le tiroir</span>
						<div class="live-currency-grid">
							<div class="live-currency-grid">
								<div class="live-currency-item text-success">
									<h1 class="hero-main-amount">{{ theoretical.consolidatedFormatted }}</h1>
									<span class="currency-tag">{{ theoretical.baseCode }}</span>
								</div>
							</div>

						</div>
					</div>

					<div class="hero-status-zone">
						<span class="audit-label">État du guichet</span>
						<span class="badge-status-live">
							<span class="live-dot"></span>
							{{ session.status.value }}
						</span>
					</div>
				</div>

				<hr class="finance-divider mb-25">

				<h3 class="box-title mb-15">
					<i class="fa-solid fa-cash-register"></i>
					Informations sur la Session
				</h3>

				<div class="audit-details-grid mb-25">
					<div class="audit-item">
						<span class="audit-label">Caissier surveillé</span>
						<p class="audit-value">{{ session.openedBy.fullName }} </p>
					</div>

					<div class="audit-item">
						<span class="audit-label">N° Session (CashSession)</span>
						<p class="audit-value monospace-code">{{ sessionCode }}</p>
					</div>

					<div class="audit-item">
						<span class="audit-label">Ouverture</span>
						<p class="audit-value">Le {{ session.openedAt|date('d/m/Y à H\\hi') }}</p>
					</div>

					<div class="audit-item">
						<span class="audit-label">Dotation initiale (Fonds de roulement)</span>
						<div class="initial-balances-inline">
							{% for bal in theoretical.byCurrency %}
								<span class="balance-tag">{{ bal.opening|number_format(2, ',', ' ') }} {{ bal.code }}</span>
							{% endfor %}
						</div>

					</div>

					<div class="audit-item">
						<span class="audit-label">Validation / Arbitrage</span>
						<p class="audit-value">
							{% if session.closedBy %}
								Validée par <strong>{{ session.closedBy.fullName }}</strong>
								<br>
								<small>
									{% if session.closedAt %} le {{ session.closedAt|date('d/m/Y à H\\hi') }}{% endif %}
								</small>
							{% elseif session.status.value == 'closing_pending' %}
								<span class="text-danger">En attente d'arbitrage manager</span>
							{% else %}
								<span class="text-primary">Session non clôturée</span>
							{% endif %}
						</p>
					</div>

				</div>

				<hr class="finance-divider mb-25">

				<h3 class="box-title mb-15">
					<i class="fa-solid fa-list-ol"></i>
					Grand Livre des Mouvements (FinancialOperation)
				</h3>

				<div class="table-responsive-wrapper">
					<table class="table table-scrollable table-striped js-datatable">
						<thead>
							<tr>
								<th>Heure / Réf Op</th>
								<th>Flux</th>
								<th>Nature / Libellé du mouvement</th>
								<th>Opérateur</th>
								<th class="text-right">Montant & Devise</th>
							</tr>
						</thead>
						<tbody>
							{% for op in operations %}
								<tr>
									<td>
										<strong>{{ op.time }}</strong>
										<span class="sub-meta-text">{{ op.reference }}</span>
									</td>
									<td>
										<span class="cash-badge {{ op.isIn ? 'badge-entry' : 'badge-exit' }}">{{ op.direction }}</span>
									</td>
									<td>
										<strong>{{ op.label }}</strong>
									</td>
									<td>
										<strong>{{ op.subLabel }}</strong>
									</td>
									<td class="text-right {{ op.isIn ? 'text-success-mode' : 'text-danger-mode' }} font-bold">
										{{ op.isIn ? '+' : '-' }} {{ op.amount }} {{ op.currency }}
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="5" class="text-center text-muted py-15">Aucun mouvement enregistré sur cette session.</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

			</div>
		</div>

	</div>
{% endblock %}
