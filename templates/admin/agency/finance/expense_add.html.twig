{# templates/admin/agency/finance/expense_add.html.twig #}
{% extends "admin/base.html.twig" %}

{% block ux_assets %}{{ importmap('app') }}{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/admin/cashier-expense-add.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-finance-expense-add-scope container">

		{% for message in app.flashes('error') %}
			<div class="notice-box-danger-dashboard mt-20"><p><i class="fa-solid fa-triangle-exclamation"></i> {{ message }}</p></div>
		{% endfor %}

		{# --- EN-TÊTE DE LA PAGE --- #}
		<header class="header-refined my-30">
			<div class="info">
				<h1>
					<i class="fa-solid fa-receipt"></i>
					Enregistrer une Dépense / Décaissement
				</h1>
				<p class="subtitle">Saisie des frais opérationnels et des abonnements de la plateforme.</p>
			</div>
			<div class="right">
				<a href="{{ path('admin_agency_finance_index') }}" class="btn-refined btn-success-gradient text-size-12">
					<i class="fa-solid fa-arrow-left"></i>
					Retour aux flux
				</a>
			</div>
		</header>

		{# --- FORMULAIRE DÉPENSE --- #}
		<div class="card trip-filters-card mb-20">
			{{ form_start(form, {attr: {id: 'expense-creation-form', 'data-turbo': 'false'}}) }}

				{% if form.vars.errors|length > 0 %}
					<div class="notice-box-danger-dashboard mb-20">{{ form_errors(form) }}</div>
				{% endif %}

				<div class="field-group mb-20">
					<div class="field">
						{{ form_label(form.type) }}
						{{ form_widget(form.type) }}
						<div class="text-danger text-size-12">{{ form_errors(form.type) }}</div>
					</div>

					<div class="field" id="branch-field-wrapper">
						{{ form_label(form.branch) }}
						{{ form_widget(form.branch) }}
						<div class="text-danger text-size-12">{{ form_errors(form.branch) }}</div>
					</div>
				</div>

				<div class="field mb-20 flex-double">
					{{ form_label(form.name) }}
					{{ form_widget(form.name) }}
					<div class="text-danger text-size-12">{{ form_errors(form.name) }}</div>
				</div>

				<div class="field-group mb-20">
					<div class="field">
						{{ form_label(form.amount) }}
						{{ form_widget(form.amount) }}
						<div class="text-danger text-size-12">{{ form_errors(form.amount) }}</div>
					</div>

					<div class="field">
						{{ form_label(form.currency) }}
						{{ form_widget(form.currency) }}
						<div class="text-danger text-size-12">{{ form_errors(form.currency) }}</div>
					</div>
				</div>

				<div class="field-group mb-20 is-hidden" id="subscription-dates-wrapper">
					<div class="field">
						{{ form_label(form.validFrom) }}
						{{ form_widget(form.validFrom) }}
						<div class="text-danger text-size-12">{{ form_errors(form.validFrom) }}</div>
					</div>
					<div class="field">
						{{ form_label(form.validUntil) }}
						{{ form_widget(form.validUntil) }}
						<div class="text-danger text-size-12">{{ form_errors(form.validUntil) }}</div>
					</div>
				</div>

				<div class="field mb-20" id="funding-source-wrapper">
					{{ form_label(form.fundingSource) }}
					{{ form_widget(form.fundingSource) }}
					<div class="text-danger text-size-12">{{ form_errors(form.fundingSource) }}</div>
				</div>

				<div class="field mb-20 is-hidden" id="cash-session-field-wrapper">
					{{ form_label(form.cashRegister) }}
					{{ form_widget(form.cashRegister) }}
					<div class="text-danger text-size-12">{{ form_errors(form.cashRegister) }}</div>
					<span class="sub-meta-text danger-hint">
						<i class="fa-solid fa-triangle-exclamation"></i>
						Attention : Cela générera un ordre de décaissement en attente sur ce guichet.
					</span>
				</div>

				<div class="field mb-20">
					{{ form_label(form.description) }}
					{{ form_widget(form.description) }}
					<div class="text-danger text-size-12">{{ form_errors(form.description) }}</div>
				</div>

				<div class="field-button-right mt-15">
					<button type="submit" class="btn-refined btn-success-gradient">
						<i class="fa-solid fa-check"></i>
						Enregistrer la dépense
					</button>
				</div>

			{{ form_end(form) }}
		</div>

	</div>
{% endblock %}
