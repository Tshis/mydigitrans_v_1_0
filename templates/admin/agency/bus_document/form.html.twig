{# templates/admin/agency/bus_document/form.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div class="admin-agency-fleet-document-add-scope container">
		{# --- HEADER DE LA CONSOLE --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				{% if bus_code %}
					<a href="{{ path('admin_agency_bus_show', {'code': bus_code}) }}" class="agency-back-action" title="Retour au bus">
						<i class="fa-solid fa-arrow-left"></i>
					</a>
				{% else %}
					<a href="{{ path('admin_agency_bus_document_index') }}" class="agency-back-action" title="Retour aux documents">
						<i class="fa-solid fa-arrow-left"></i>
					</a>
				{% endif %}

				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Logistique</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Portefeuille Documentaire</span>
					</div>
					<h1 class="mt-5">{{ title }} un document du véhicule</h1>
				</div>
			</div>
		</header>

		{# --- FORMULAIRE SYMFONY LIÉ AU DTO BusDocumentData --- #}
		{{ form_start(form, {'attr': {'id': 'document-registration-form', 'class': 'document-form-layout', 'novalidate': 'novalidate'}}) }}

			<div class="document-container-grid">

				{# COLONNE GAUCHE : FORMULAIRE DE CONFIGURATION #}
				<div class="main-form-panel">

					{{ form_errors(form) }}

					{# CARD 1 : LIEN VÉHICULE & NATURE DU DOCUMENT #}
					<div class="card control-card mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-passport text-primary"></i>
							Spécifications Administratives
						</h2>

						<div class="direct-pricing-row mb-20">
							<div class="field">
								{% if not isEdit and form.busCode is defined %}
									{{ form_label(form.busCode, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
									{{ form_widget(form.busCode, {'attr': {'class': 'admin-bus-layout-add-select'}}) }}
									<div class="text-danger text-size-12 mt-5">{{ form_errors(form.busCode) }}</div>
								{% elseif document and document.bus %}
									<label class="admin-bus-layout-add-label">Véhicule associé</label>
									<input
										type="text"
										class="admin-bus-layout-add-input text-disabled"
										value="{{ document.bus.brand }} {{ document.bus.model }} ({{ document.bus.plateNumber }})"
										disabled
									>
								{% endif %}
							</div>

							<div class="field">
								{{ form_label(form.type, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
								{{ form_widget(form.type, {'attr': {'class': 'admin-bus-layout-add-input'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.type) }}</div>
							</div>
						</div>

						<div class="direct-pricing-row">
							<div class="field">
								{{ form_label(form.referenceNumber, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
								{{ form_widget(form.referenceNumber, {'attr': {'class': 'admin-bus-layout-add-input'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.referenceNumber) }}</div>
							</div>
						</div>
					</div>

					{# CARD 2 : CYCLE DE VALIDITÉ #}
					<div class="card control-card success-accent">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-calendar-days text-success"></i>
							Dates de Validité & Statut Légal
						</h2>

						<div class="direct-pricing-row">
							<div class="field">
								{{ form_label(form.issuedAt, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
								{{ form_widget(form.issuedAt, {'attr': {'class': 'admin-bus-layout-add-input'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.issuedAt) }}</div>
							</div>
							<div class="field">
								{{ form_label(form.expiredAt, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
								{{ form_widget(form.expiredAt, {'attr': {'class': 'admin-bus-layout-add-input'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.expiredAt) }}</div>
							</div>
						</div>

						<h2 class="card-title-fix my-20">
							<i class="fa-solid fa-user-shield text-success"></i>
							Audit Système
						</h2>
						<div class="field mb-15">
							<label class="admin-bus-layout-add-label">Agent Inspecteur</label>
							<input type="text" class="admin-bus-layout-add-input text-disabled" value="{{ app.user.fullName|default(app.user.email) }}" readonly>
						</div>

						<hr class="section-divider mb-15">
						<div class="field-button-right">
							<button type="submit" class="btn-refined btn-success-gradient">
								<i class="fa-solid fa-file-circle-check"></i>
								{{ isEdit ? 'Enregistrer les modifications' : 'Enregistrer le document' }}
							</button>
						</div>
					</div>
				</div>

				{# COLONNE DROITE : TÉLÉVERSEMENT NUMÉRIQUE & TRAÇABILITÉ #}
				<aside class="sidebar-action-panel">
					<div class="card control-card mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-cloud-arrow-up text-primary"></i>
							Scan du Document
						</h2>
						{% if isEdit and document and document.url %}
							<div class="mb-15">
								<a href="{{ path('admin_agency_bus_document_open_file', {'code': document.code}) }}" target="_blank" class="btn-refined btn-primary-gradient text-size-12">
									<i class="fa-solid fa-eye"></i> Voir le scan actuel
								</a>
							</div>
						{% endif %}
						<div class="field mb-25">
							{{ form_label(form.documentFile, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
							{{ form_widget(form.documentFile, {'attr': {'class': 'admin-bus-layout-add-input-file'}}) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.documentFile) }}</div>
							<small class="text-gray text-size-11 mt-5 block">
								<i class="fa-solid fa-circle-info"></i>
								Recommandé pour présentation mobile au chauffeur.
							</small>
						</div>
					</div>

					<div class="card sticky-aside-card">
						<div class="notice-box-info">
							<p>
								<i class="fa-solid fa-shield-halved"></i>
								La date de mise à jour ainsi que le statut de validité sont calculés automatiquement par le système.
							</p>
						</div>
					</div>
				</aside>

			</div>
		{{ form_end(form) }}
	</div>
{% endblock %}
