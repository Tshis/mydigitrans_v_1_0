{# templates/admin/agency/bus_document/renew.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div class="admin-agency-fleet-document-add-scope container">
		{# --- HEADER DE LA CONSOLE --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_bus_show', {'code': bus.code}) }}" class="agency-back-action" title="Retour au bus">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Logistique</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Portefeuille Documentaire</span>
					</div>
					<h1 class="mt-5">
						Renouvellement : {{ document.type|capitalize }}
					</h1>
				</div>
			</div>
		</header>

		{# --- FORMULAIRE SYMFONY LIÉ AU DTO BusDocumentData (mode renew) --- #}
		{{ form_start(form, {'attr': {'id': 'document-renew-form', 'class': 'document-form-layout', 'novalidate': 'novalidate'}}) }}

			<div class="document-container-grid">

				{# COLONNE GAUCHE : FORMULAIRE DE RENOUVELLEMENT #}
				<div class="main-form-panel">

					{{ form_errors(form) }}

					{# CARD 1 : RAPPEL VÉHICULE & DOCUMENT EXPIRÉ #}
					<div class="card control-card mb-20">
						<div class="direct-pricing-row renew mb-10">
							<div class="field info">
								<i class="fa-solid fa-bus text-danger"></i>
								<div>
									{{ bus.brand|capitalize }} {{ bus.model|capitalize }}
									<p class="text-gray text-size-14 mt-5">Plaque : {{ bus.plateNumber|upper }}</p>
								</div>
							</div>
							<div class="field info">
								<i class="fa-regular fa-file text-danger"></i>
								<div>
									{{ document.type }}
									<p class="text-gray text-size-14 mt-5">Expiré le {{ document.expiredAt|date('d/m/Y') }}</p>
								</div>
							</div>
						</div>
					</div>

					{# CARD 2 : NOUVEAU CYCLE DE VALIDITÉ #}
					<div class="card control-card success-accent">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-calendar-days text-success"></i>
							Nouvelles Dates de Validité
						</h2>

						<div class="direct-pricing-row">
							<div class="field mb-20">
								{{ form_label(form.referenceNumber, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
								{{ form_widget(form.referenceNumber, {'attr': {'class': 'admin-bus-layout-add-input'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.referenceNumber) }}</div>
							</div>
						</div>

						<div class="direct-pricing-row">
							<div class="field">
								{{ form_label(form.issuedAt, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
								{{ form_widget(form.issuedAt, {'attr': {'class': 'admin-bus-layout-add-input'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.issuedAt) }}</div>
							</div>
							<div class="field">
								{{ form_label(form.expiredAt, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
								{{ form_widget(form.expiredAt, {'attr': {'class': 'admin-bus-layout-add-input'}}) }}
								<div class="text-danger text-size-12 mt-5">{{ form_errors(form.expiredAt) }}</div>
							</div>
						</div>

						<h2 class="card-title-fix my-20">
							<i class="fa-solid fa-user-shield text-success"></i>
							Audit Système
						</h2>
						<div class="field mb-15">
							<label class="admin-bus-layout-add-label">Agent Inspecteur</label>
							<input type="text" class="admin-bus-layout-add-input text-disabled" value="{{ app.user.fullName|default(app.user.email) }}" readonly>
						</div>

						<hr class="section-divider mb-15">
						<div class="field-button-right">
							<a href="{{ path('admin_agency_bus_show', {'code': bus.code}) }}" class="btn-refined btn-gray-gradient mr-10">Annuler</a>
							<button type="submit" class="btn-refined btn-success-gradient">
								<i class="fa-solid fa-arrows-rotate"></i>
								Valider le renouvellement
							</button>
						</div>
					</div>
				</div>

				{# COLONNE DROITE : TÉLÉVERSEMENT DU NOUVEAU SCAN #}
				<aside class="sidebar-action-panel">
					<div class="card control-card mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-cloud-arrow-up text-primary"></i>
							Nouveau Scan du Document
						</h2>
						<div class="field mb-25">
							{{ form_label(form.documentFile, null, {'label_attr': {'class': 'admin-bus-layout-add-label'}}) }}
							{{ form_widget(form.documentFile, {'attr': {'class': 'admin-bus-layout-add-input-file'}}) }}
							<div class="text-danger text-size-12 mt-5">{{ form_errors(form.documentFile) }}</div>
							<small class="text-gray text-size-11 mt-5 block">
								<i class="fa-solid fa-circle-info"></i>
								L'ancien scan sera remplacé automatiquement si vous joignez un fichier.
							</small>
						</div>
					</div>

					<div class="card sticky-aside-card">
						<div class="notice-box-info">
							<p>
								<i class="fa-solid fa-shield-halved"></i>
								La date de mise à jour ainsi que l'agent responsable seront enregistrés automatiquement.
							</p>
						</div>
					</div>
				</aside>

			</div>
		{{ form_end(form) }}
	</div>
{% endblock %}
