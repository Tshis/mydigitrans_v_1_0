{# templates/admin/agency/branch/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-agency-branch-index-scope branch-scope container">
		{# --- HEADER DE LA CONSOLE --- #}
		<header class="header-refined mb-30">
			<div class="header-left">
				<div class="breadcrumb-mini">
					<span>Paramètres Réseau</span>
					<i class="fa-solid fa-chevron-right"></i>
					<strong>Points de Vente</strong>
				</div>
				<h1>Gestion des Succursales</h1>
				<p class="subtitle">Registre et suivi opérationnel de vos agences de quartier et guichets.</p>
			</div>
			{% if is_granted('branch.write') %}
				<div class="header-right">
					<a href="{{ path('admin_agency_branch_add') }}" class="btn-refined btn-primary-gradient">
						<i class="fa-solid fa-plus"></i>
						<span>Ouvrir une succursale</span>
					</a>
				</div>
			{% endif %}
		</header>

		{# --- STATS RAPIDES --- #}
		<div class="branch-stats-grid mb-25">
			<div class="stat-card card-refined total">
				<div class="icon-wrap">
					<i class="fas fa-network-wired"></i>
				</div>
				<div class="info">
					<h3>{{ stats.total }}</h3>
					<span>Total Succursales</span>
				</div>
			</div>
			<div class="stat-card card-refined active">
				<div class="icon-wrap">
					<i class="fa-solid fa-circle-check"></i>
				</div>
				<div class="info">
					<h3>{{ stats.active }}</h3>
					<span>Actives</span>
				</div>
			</div>
			<div class="stat-card card-refined alert">
				<div class="icon-wrap">
					<i class="fa-solid fa-building-lock"></i>
				</div>
				<div class="info">
					<h3>{{ stats.suspended }}</h3>
					<span>Suspendues</span>
				</div>
			</div>
		</div>

		{# --- LISTE DES SUCCURSALES --- #}
		<div class="table-responsive-wrapper">
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Code & Nom</th>
						<th>Ville / Pays</th>
						<th>Gérant / Personnel</th>
						<th>Statut</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for branch in branches %}
						<tr>
							<td>
								<span class="text-primary">#{{ branch.code }}</span>
								<div>
									<strong>{{ branch.name }}</strong>
								</div>
							</td>
							<td>
								<strong>{{ branch.city }}</strong>
								<div class="text-gray text-size-12">{{ branch.country }}</div>
							</td>
							<td>
								<i class="fa-solid fa-user-tie text-gray"></i>
								{{ branch.managerName }}
								{% if branch.staffCount > 1 %}
									<small class="text-gray">(+{{ branch.staffCount - 1 }})</small>
								{% endif %}
							</td>
							<td>
								<span class="pill-branch-status {{ branch.status }}">
									{{ branch.statusLabel }}
								</span>
							</td>
							<td class="text-right">
								<div class="action-group-refined">
									<a href="{{ path('admin_agency_branch_show', {'code': branch.code}) }}" class="action-link" title="Fiche de la succursale">
										<i class="fa-solid fa-eye"></i>
									</a>
									{% if is_granted('branch.write') and branch.status == 'active' %}
										<a href="{{ path('admin_agency_branch_edit', {'code': branch.code}) }}" class="action-link" title="Modification">
											<i class="fa-solid fa-edit"></i>
										</a>
									{% endif %}
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="5" class="text-center text-gray italic padding-20">
								Aucune succursale n'est configurée pour cette agence pour le moment.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
