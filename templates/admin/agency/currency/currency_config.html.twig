{# templates/admin/agency/currency/configure_base.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div class="admin-agency-currency-scope container">
		<header class="header-refined my-30">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_currency_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Action A</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Périmètre Monétaire</span>
					</div>
					<h1 class="mt-5">Configuration des Devises Activées</h1>
				</div>
			</div>
		</header>

		<form action="#" method="POST" class="card control-card">
			<h2 class="card-title-fix">
				<i class="fa-solid fa-earth-africa text-primary"></i>
				Sélection de la Monnaie de Base et d'Acceptation</h2>

			<div class="direct-pricing-row mb-25">
				<div class="field">
					<label class="admin-bus-layout-add-label">Définir la Devise Pivot Principale *</label>
					<select name="base_currency" class="admin-bus-layout-add-select" required>
						{% for currency in system_currencies %}
							<option value="{{ currency.code }}" {% if agency_config.baseCurrency == currency.code %} selected {% endif %}>{{ currency.code }}
								-
								{{ currency.name }}</option>
						{% endfor %}
					</select>
				</div>
			</div>

			<label class="admin-bus-layout-add-label mb-10">Cocher les autres devises acceptées au guichet :</label>
			<div class="currency-checkbox-group mb-20">
				{% for currency in system_currencies %}
					<label class="checkbox-container">
						<input type="checkbox" name="accepted_currencies[]" value="{{ currency.code }}" {% if currency.code in agency_config.acceptedCurrencies %} checked {% endif %}>
						<span class="checkmark"></span>
						{{ currency.code }}
						-
						{{ currency.name }}
					</label>
				{% endfor %}
			</div>

			<div class="admin-bus-layout-add-action-zone">
				<a href="{{ path('admin_agency_currency_index') }}" class="btn-refined btn-gray-gradient">Annuler</a>
				<button type="submit" class="btn-refined btn-success-gradient">
					<i class="fa-solid fa-circle-check"></i>
					Sauvegarder l'acceptation</button>
			</div>
		</form>
	</div>
{% endblock %}
