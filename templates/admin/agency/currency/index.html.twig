{# templates/admin/agency/currency/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/table-responsive.js" defer></script>
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div
		class="admin-agency-currency-scope container">
		{# --- HEADER AVEC TES DEUX BOUTONS D'ACTION (A et B) --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Trésorerie Centrale</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Console de Référence</span>
					</div>
					<h1 class="mt-5">Monnaies & Taux Actifs</h1>
				</div>
			</div>
			<div
				class="header-actions">
				{# BOUTON A : Paramétrage structurel #}
				<a href="{{ path('admin_agency_currency_configure_base') }}" class="btn-refined btn-primary-gradient">
					<i class="fa-solid fa-gears"></i>
					<span>A / Configuration Devises</span>
				</a>
				{# BOUTON B : Ajustement quotidien du matin #}
				<a href="{{ path('admin_agency_currency_configure_rate') }}" class="btn-refined btn-success-gradient">
					<i class="fa-solid fa-sun"></i>
					<span>B / Fixer Taux Journalier</span>
				</a>
			</div>
		</header>

		<div
			class="reports-center-grid-layout">
			{# PANNEAU PRINCIPAL #}
			<div
				class="main-form-panel">

				{# BLOC INFO : LA DEVISE DE BASE DE L'AGENCE #}
				<div class="card control-card mb-20">
					<h2 class="card-title-fix">
						<i class="fa-solid fa-building-columns text-primary"></i>
						Devise de Base Verrouillée
					</h2>
					<div class="direct-pricing-row">
						<div class="field">
							<label class="admin-bus-layout-add-label">Unité de consolidation comptable de votre SaaS</label>
							<div class="admin-bus-layout-add-input text-disabled font-bold" style="font-size: 15px; color: var(--primary);">
								<i class="fa-solid fa-circle-check text-success"></i>
								{{ agency_config.baseCurrency }}
								-
								{{ base_currency_details.name }}
							</div>
						</div>
					</div>
				</div>

				{# TABLEAU DES DEVISES ACTIVES ET LEURS RAPPORTS DE TAUX CROISÉS #}
				<div class="table-responsive-wrapper mb-25">
					<h2 class="card-title-fix text-size-14 py-10">
						<i class="fa-solid fa-money-bill-transfer text-primary"></i>
						Matrice des Taux en Cours (Par rapport au
						{{ agency_config.baseCurrency }})
					</h2>
					<table class="table table-scrollable table-striped">
						<thead>
							<tr>
								<th>Code Devises</th>
								<th>Libellé International</th>
								<th>Taux d'Échange Actif</th>
								<th class="text-center">Acceptation Guichet</th>
							</tr>
						</thead>
						<tbody>
							{% for currency in active_currencies_list %}
								<tr>
									<td class="monospace">
										<strong>{{ currency.code }}</strong>
									</td>
									<td>{{ currency.name }}</td>
									<td class="font-bold">
										{% if currency.code == agency_config.baseCurrency %}
											<span class="text-gray">1.00 (Pivot)</span>
										{% else %}
											<span class="text-success-mode">1
												{{ currency.code }}
												=
												{{ currency.current_rate|number_format(0, ',', ' ') }}
												{{ agency_config.baseCurrency }}</span>
										{% endif %}
									</td>
									<td class="text-center">
										<span class="pill-report-audit {{ currency.code == agency_config.baseCurrency ? 'closed' : 'open' }}">
											{{ currency.code == agency_config.baseCurrency ? 'Base unique' : 'Acceptée' }}
										</span>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				{# --- NOUVEAU TABLEAU : JOURNAL HISTORIQUE DES VARIATIONS DE TAUX --- #}
				<div class="table-responsive-wrapper">
					<h2 class="card-title-fix text-size-14 py-10">
						<i class="fa-solid fa-clock-rotate-left text-primary"></i>
						Journal Historique des Taux Saisis (Entité ExchangeRate)
					</h2>
					<table class="table table-scrollable table-striped js-datatable">
						<thead>
							<tr>
								<th>Date d'Application</th>
								<th>Heure de Fixation</th>
								<th>Taux d'Échange Enregistré</th>
								<th>Opérateur Responsable
								</th>
								<th class="text-center">Statut du Taux</th>
							</tr>
						</thead>
						<tbody>
							{% for history in rate_history %}
								<tr>
									<td>
										<strong>{{ history.effectiveFrom|date('d/m/Y') }}</strong>
									</td>
									<td class="monospace">{{ history.effectiveFrom|date('H:i:s') }}</td>
									<td class="font-bold text-primary-mode">
										1
										{{ history.targetCurrency }}
										=
										{{ history.rate|number_format(0, ',', ' ') }}
										{{ agency_config.baseCurrency }}
									</td>
									<td>
										<small>
											<i class="fa-solid fa-user-shield text-gray"></i>
											{{ history.createdBy }}</small>
									</td>
									<td
										class="text-center">
										{# La toute première ligne du tableau représente toujours le taux actuel en cours #}
										{% if loop.first %}
											<span class="pill-report-audit open">
												<i class="fa-solid fa-circle-check"></i>
												Actif
											</span>
										{% else %}
											<span class="pill-report-audit open" style="background: rgba(0,0,0,0.04); color: #7f8c8d;">
												Archivé
											</span>
										{% endif %}
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="5" class="text-center text-gray italic padding-20">
										Aucun historique de taux enregistré dans la table ExchangeRate.
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

			</div>
		</div>
	</div>
{% endblock %}
