{# templates/admin/agency/currency/rate_config.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div
		class="admin-agency-currency-scope container">
		{# --- EN-TÊTE --- #}
		<header class="header mb-25">
			<div class="header-main-info">
				<a href="{{ path('admin_agency_currency_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Action B</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Planification Temporelle [MCD 16]</span>
					</div>
					<h1 class="mt-5">Configuration du Taux Journalier</h1>
				</div>
			</div>
		</header>

		{# --- LAYOUT DOUBLE COLONNE FORMULAIRE --- #}
		<form action="#" method="POST" class="settings-form-layout">
			<div
				class="settings-container-grid">

				{# COLONNE GAUCHE : FORMULAIRE DE SAISIE AVEC PLANIFICATION #}
				<div class="main-form-panel">
					<div class="card control-card">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-clock text-warning"></i>
							Programmer l'Application du Taux</h2>

						<div class="direct-pricing-row mb-25">
							<div class="field">
								<label class="admin-bus-layout-add-label">Devise Cible</label>
								<input type="text" class="admin-bus-layout-add-input text-disabled" value="1 USD ($)" disabled style="opacity: 0.7;">
							</div>
							<div class="field">
								<label class="admin-bus-layout-add-label">Équivalent en
									{{ agency_config.baseCurrency }}
									*</label>
								<div class="input-currency-wrapper">
									<input type="number" name="rate_value" class="admin-bus-layout-add-input-with-prefix" value="615" min="1" max="10000" required>
									<span class="input-suffix-label">{{ agency_config.baseCurrency }}</span>
								</div>
							</div>
						</div>

						{# --- NOUVEAU CHAMP : DATE ET HEURE D'EFFECTIVITÉ [MCD 16] --- #}
						<div class="direct-pricing-row mb-25">
							<div class="field">
								<label class="admin-bus-layout-add-label">Date et Heure d'Effectivité (effectiveFrom) *</label>
								{# Initialisé par défaut avec la date et l'heure actuelle pour gagner du temps #}
								<input type="datetime-local" name="effective_from" class="admin-bus-layout-add-input" value="{{ "now"|date('Y-m-d\\TH:i') }}" required>
							</div>
						</div>

						<div class="admin-bus-layout-add-action-zone">
							<a href="{{ path('admin_agency_currency_index') }}" class="btn btn-gray">Annuler</a>
							<button type="submit" class="btn btn-success">
								<i class="fa-solid fa-calendar-check"></i>
								Déployer le taux programmé
							</button>
						</div>
					</div>
				</div>

				{# COLONNE DROITE : INFORMATION REGLEMENTAIRE #}
				<aside class="sidebar-action-panel">
					<div class="card sticky-aside-card" style="border-top-color: #f2994a;">
						<h2 class="card-title-fix" style="color: #d06d16;">
							<i class="fa-solid fa-timeline"></i>
							Gestion Chronologique</h2>
						<div class="notice-box-info info-warning mb-15">
							<p>
								<strong>
									<i class="fa-solid fa-clock"></i>
									Déclenchement Temporel :</strong>
								Le système MyDigitrans basculera automatiquement sur ce taux dès que l'horloge système aura dépassé la date d'effectivité choisie à gauche.</p>
						</div>
					</div>
				</aside>

			</div>
		</form>
	</div>
{% endblock %}
