{# templates/guichet/pos/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
    {{ parent() }}
    <script src="/js/guichet/pos_sync.js" defer></script>
{% endblock %}

{% block body %}
    <div class="admin-pos-portal-scope container-fluid">
    
        {# --- HEADER DE L'ÉCRAN DE CAISSE TACTILE --- #}
        <header class="header mb-25">
            <div class="header-main-info">
                <div class="title">
                    <div class="sub-header-flex">
                        <span class="text-gray text-size-13">Session Synchrone POS</span>
                        <span class="arrow-divider">•</span>
                        <span class="text-primary text-size-13 text-highlight">
                            <i class="fa-solid fa-satellite-dish"></i> Terminal Connecté
                        </span>
                    </div>
                    <h1 class="mt-5">Guichet & Émission Billetterie</h1>
                </div>
            </div>

            {# RAPPEL DE LA COMPAGNIE ET DE LA DEVISE PIVOT #}
            <div class="pos-terminal-meta-status">
                <div class="meta-item">
                    <span class="label">Gare Active :</span>
                    <span class="value font-bold">{{ current_branch.name }}</span>
                </div>
                <div class="meta-item ml-15">
                    <span class="label">Devise Pivot :</span>
                    <span class="value font-bold monospace text-primary-mode">{{ agency_currency_settings.base_currency }}</span>
                </div>
            </div>
        </header>

        {# --- LAYOUT TECHNIQUE ASYMÉTRIQUE INVERSÉ --- #}
        <div class="settings-form-layout">
            <div class="settings-container-grid">
            
                {# COLONNE DROITE : TIROIR-CAISSE & ÉTAT DU COFFRE (PLACÉE EN PREMIER DANS LE HTML) #}
                <aside class="sidebar-action-panel">
                
                    {# ÉTAT D'OUVERTURE DU COFFRE LOGICIEL [MCD 43] #}
                    <div class="card control-card mb-20 pos-sidebar-theme-vault">
                        <h2 class="card-title-fix">
                            <i class="fa-solid fa-vault"></i> Tiroir-Caisse Session
                        </h2>
                    
                        <div class="financial-block-summary mb-15">
                            <label class="admin-bus-layout-add-label">Espèces en Caisse (Session)</label>
                            <span class="invoice-macro-amount text-success-color font-monospace">{{ session_vault.amount|number_format(2, ',', ' ') }} $</span>
                        </div>

                        <div class="pos-cashier-badge mb-15">
                            <p class="text-gray text-size-12">Guichetier : <strong>{{ app.user.name|default('Agent Guichet') }}</strong></p>
                            <p class="text-gray text-size-12">Ouvert le : <span class="monospace">{{ session_vault.openedAt|date('d/m H:i') }}</span></p>
                        </div>

                        <div class="notice-box-info-currency">
                            <table class="table min-currency-table">
                                <tbody>
                                    {% if agency_currency_settings.accepted_currencies is defined %}
                                        {# 🚨 SÉCURISATION TWIG : Utilisation correcte du filtre pour exclure les devises inactives #}
                                        {% for curr in agency_currency_settings.accepted_currencies|filter(curr => curr.isActive) %}
                                            <tr>
                                                <td>Taux {{ curr.code }} :</td>
                                                <td class="text-right font-bold monospace text-size-12">
                                                    {{ curr.exchange_rate|number_format(0, ',', ' ') }} {{ curr.symbol }}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>

                    </div>

                    {# PANNEAU D'ACCÈS RAPIDE FRET & COLIS #}
                    <div class="card control-card mb-20">
                        <h2 class="card-title-fix"><i class="fa-solid fa-box-open text-primary"></i> Expédition Fret</h2>
                        <p class="text-gray text-size-12 mb-15">Peser un colis hors-gabarit et éditer un bon de colisage immédiat.</p>
                        <a href="#" class="btn-refined btn-primary-gradient w-100-percent">
                            <i class="fa-solid fa-weight-scale"></i> Nouvelle Pesée Colis
                        </a>
                    </div>
                </aside>

                {# COLONNE GAUCHE : LA GRILLE TACTILE DES BUS À REMPLIR #}
                <main class="main-form-panel">
                    <div class="table-responsive-wrapper">
                        <h2 class="card-title-fix py-10">
                            <i class="fa-solid fa-bus text-primary"></i> Sélectionner un Départ Imminent pour Vente Directe
                        </h2>
                    
                        <div class="pos-trips-tactile-grid">
                            {% for trip in upcoming_trips %}
                                <div class="pos-trip-tactile-card {% if trip.status == 'embarking' %}active-embark{% endif %}">
                                    <div class="trip-time-badge monospace font-bold">{{ trip.time }}</div>
                                    <div class="trip-meta-info-layout">
                                        <h3 class="route-title">{{ trip.route }}</h3>
                                        <p class="bus-plate text-gray">Bus : {{ trip.bus }} • <span class="monospace">{{ trip.plate }}</span></p>
                                    </div>
                                    <div class="trip-seats-fill-progress">
                                        <span class="seats-count font-bold monospace">{{ trip.seats_taken }} / {{ trip.capacity }}</span>
                                        <span class="label text-gray">Sièges occupés</span>
                                    </div>
                                    <div class="trip-action-button-zone">
                                        <a href="#" class="btn-refined {% if trip.status == 'embarking' %}btn-success-gradient{% else %}btn-gray-gradient{% endif %}">
                                            <i class="fa-solid fa-cash-register"></i> Ouvrir la Caisse
                                        </a>
                                    </div>
                                </div>
                            {% else %}
                                <div class="text-center text-gray italic padding-20">Aucun départ planifié ou disponible pour cette gare aujourd'hui.</div>
                            {% endfor %}
                        </div>
                    </div>
                </main>

            </div>
        </div>
    </div>
{% endblock %}
