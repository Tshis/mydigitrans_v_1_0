{# templates/admin/agency/user/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-agency-user-index-scope container">
		{# --- HEADER DE LA CONSOLE --- #}
		<header class="header-refined mb-30">
			<div class="header-left">
				<div class="breadcrumb-mini">
					<span>Administration</span>
					<i class="fa-solid fa-chevron-right"></i>
					<strong>Ressources Humaines</strong>
				</div>
				<h1>Registre des Utilisateurs</h1>
				<p class="subtitle">Gestion des comptes agents, affectations aux guichets et habilitations RBAC.</p>
			</div>
			<div class="header-right">
				{# ✅ Utilisation dynamique sécurisée du préfixe de route #}
				<a href="{{ path(route_prefix ~ '_agent_add') }}" class="btn-refined btn-primary-gradient">
					<i class="fa-solid fa-user-plus"></i>
					<span>Créer un utilisateur</span>
				</a>
			</div>
		</header>

		{# --- ZONE DE FILTRES AVANCÉS --- #}
		<div class="user-filters-card mb-20">
			<form action="#" method="GET" class="field-group">
				<div class="field">
					<label class="admin-bus-layout-add-label">Rechercher un agent</label>
					<input type="text" name="search" value="{{ filters.search }}" class="admin-bus-layout-add-input" placeholder="Nom, email ou téléphone...">
				</div>
				<div class="field">
					<label class="admin-bus-layout-add-label">Succursale / Affectation</label>
					<select name="branch_code" class="admin-bus-layout-add-select">
						<option value="">-- Toutes les succursales --</option>
						{# ✅ Dynamisation des succursales avec les données du contrôleur #}
						{% for branch in branch_options %}
							<option value="{{ branch.code }}" {{ filters.branch == branch.code ? 'selected' : '' }}>{{ branch.name }}</option>
						{% endfor %}
					</select>
				</div>
				<div class="field">
					<label class="admin-bus-layout-add-label">État du compte</label>
					<select name="status" class="admin-bus-layout-add-select">
						<option value="">-- Tous --</option>
						<option value="active" {{ filters.status == 'active' ? 'selected' : '' }}>Actif</option>
						<option value="inactive" {{ filters.status == 'inactive' ? 'selected' : '' }}>Bloqué / Suspendu</option>
					</select>
				</div>
				<div class="field-actions">
					<button type="submit" class="btn-refined btn-success-gradient">
						<i class="fa-solid fa-filter"></i>
						Filtrer
					</button>
				</div>
			</form>
		</div>

		{# --- LE TABLEAU CONFORME AU MODELE TABLEAU APLETI --- #}
		<div class="table-responsive-wrapper">
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Utilisateur</th>
						<th>Contact & Email</th>
						<th>Affectation Guichet</th>
						<th>Fonction / Rôle</th>
						<th class="text-center">Dernière Connexion</th>
						<th class="text-center">Statut</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for agent in users %}
						<tr>
							<td>
								<div class="user-profile-cell">
									<div class="meta">
										<span class="full-name">
											<strong>{{ agent.firstname }} {{ agent.lastname }}</strong>
											{% if agent.isSelf %}
												<span class="badge badge-info text-size-10">Moi</span>
											{% endif %}
										</span>
									</div>
								</div>
							</td>
							<td>
								<div class="contact-stack">
									<span class="email-text">{{ agent.email }}</span>
									<small class="phone-text monospace">{{ agent.phone }}</small>
								</div>
							</td>
							<td>
								{# ✅ Correction de l'erreur : Utilisation des clés plates branchCode et branchName #}
								{% if agent.branchCode %}
									<strong>{{ agent.branchName }}</strong>
									<br><small class="text-muted">#{{ agent.branchCode }}</small>
								{% else %}
									<span class="text-gray italic">Siège Central (Général)</span>
								{% endif %}
							</td>
							<td>
								{# ✅ Correction de l'erreur : Récupération du rôle métier pré-traité par ton service #}
								<span class="badge-role monospace text-size-12" title="{{ agent.role.description }}">
									{{ agent.role.name }}
								</span>
							</td>
							<td class="text-center monospace text-size-12">
								{{ agent.lastLoginAt ? agent.lastLoginAt|date('d/m/Y H:i') : 'Jamais connecté' }}
							</td>
							<td class="text-center">
								<span class="pill-user-account-status {{ agent.isActive ? 'active' : 'inactive' }}">
									{{ agent.isActive ? 'Actif' : 'Bloqué' }}
								</span>
							</td>
							<td class="text-right">
								<div class="action-group-refined">
									<a href="{{ path(route_prefix ~ '_agent_show', {'code': agent.code}) }}" class="action-link config" title="Détails sur l'agent">
										<i class="fa-solid fa-eye"></i>
									</a>
									{# ✅ CORRECTION : Le bouton Edit réapparaît pour l'admin, sauf sur sa propre ligne (isSelf) #}
									{% if is_granted('user.write') and not agent.isSelf %}
										<a href="{{ path(route_prefix ~ '_agent_edit', {'code': agent.code}) }}" class="action-link config" title="Modifier le compte">
											<i class="fa-solid fa-user-pen"></i>
										</a>
									{% endif %}
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="7" class="text-center text-gray italic padding-20">
								Aucun agent utilisateur n'est répertorié pour cette agence.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
