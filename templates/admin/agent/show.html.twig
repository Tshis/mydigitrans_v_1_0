{# templates/admin/agent/show.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
    {{ parent() }}
    <script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
    <div class="admin-agency-agent-history-scope container">
        {# --- EN-TÊTE DU PROFIL DYNAMIQUE --- #}
        <header class="header-refined mb-25">
            <div class="header-main-info">
                {% set indexUrl = agent.userType == 'platform' ? path('admin_platform_agent_index') : path('admin_agency_agent_index') %}
                <a href="{{ indexUrl }}" class="agency-back-action">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div class="title">
                    <h1 class="mt-5">
                        {{ agent.firstname|capitalize }} {{ agent.lastname|capitalize }}
                    </h1>
                    <div class="sub-header-flex">
                        <span class="text-gray text-size-13">Poste actuel</span>
                        <span class="arrow-divider">•</span>
                    
                        {# Extraction du nom du rôle actif depuis la table 5. UserRole du MCD #}
                        {% set currentRoleName = 'Aucun rôle assigné' %}
                        {% if agent.userRoles is defined and agent.userRoles|length > 0 %}
                            {% for userRole in agent.userRoles %}
                                {# Si le rôle n'est pas révoqué, c'est le poste actuel #}
                                {% if userRole.revokedAt is null %}
                                    {% set currentRoleName = userRole.role.name %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    
                        <span class="text-primary text-size-13 text-highlight">{{ currentRoleName|upper }}</span>
                    </div>
                </div>
            </div>
        </header>

        {# --- LAYOUT DOUBLE COLONNE --- #}
        <div class="agent-history-grid-layout">

            {# COLONNE GAUCHE : COORDONNÉES & FONCTIONS #}
            <div class="main-info-panel">

                {# BLOC 1 : COORDONNÉES #}
                <div class="card control-card mb-20">
                    <h2 class="card-title-fix">
                        <i class="fa-solid fa-id-card text-primary"></i>
                        Coordonnées Professionnelles
                    </h2>
                    <div class="direct-pricing-row">
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Adresse Email</label>
                            <div class="admin-bus-layout-add-input text-disabled">{{ agent.email }}</div>
                        </div>
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Téléphone mobile</label>
                            <div class="admin-bus-layout-add-input text-disabled font-bold">{{ agent.phone }}</div>
                        </div>
                    </div>
                </div>

                {# HISTORIQUE ISSU DE LA TABLE 5. USERROLE (MCD) #}
                <div class="table-responsive-wrapper my-20">
                    <h2 class="card-title-fix text-size-13 py-10">
                        <i class="fa-solid fa-history text-primary"></i>
                        Historique des Fonctions & Affectations en Succursales
                    </h2>
                    <table class="table table-scrollable table-striped js-datatable">
                        <thead>
                            <tr>
                                <th>Fonction (Role System)</th>
                                <th>Succursale (Branch)</th>
                                <th>Date d'affectation</th>
                                <th>Date de fin (Mutation)</th>
                                <th class="text-right">Opérateur Système</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% set userRoles = agent.userRoles is defined ? agent.userRoles : [] %}
                            {% for userRole in userRoles %}
                                <tr>
                                    {# Table 4. Role -> name #}
                                    <td><strong>{{ userRole.role.name }}</strong></td>
                                    {# Relation branch(nullable) de UserRole #}
                                    <td>{{ userRole.branch ? userRole.branch.name : 'Siège Central (Général)' }}</td>
                                    {# assignedAt de UserRole #}
                                    <td>{{ userRole.assignedAt|date('d/m/Y') }}</td>
                                    <td>
                                        {# RevokedAt de UserRole #}
                                        {% if userRole.revokedAt %}
                                            <span class="pill-branch-status inactive">{{ userRole.revokedAt|date('d/m/Y') }}</span>
                                        {% else %}
                                            <span class="pill-branch-status active">Actuel</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-right text-gray text-size-12">
                                        {# AssignedBy et revokedBy de UserRole #}
                                        <small>Par : {{ userRole.assignedBy ? userRole.assignedBy.firstname : 'Système' }}</small>
                                        {% if userRole.revokedBy %}
                                            <br><small>Clos par : {{ userRole.revokedBy.firstname }}</small>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center text-gray italic padding-20">
                                        Aucun historique d'affectation enregistré pour cet utilisateur dans la table UserRole.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {# COLONNE DROITE : BARRE LATÉRALE DE STATUT SÉCURITÉ #}
            <aside class="sidebar-action-panel">
                <div class="card sticky-aside-card">
                    <h2 class="card-title-fix">
                        <i class="fa-solid fa-fingerprint text-primary"></i>
                        Console Statut
                    </h2>
                    <div class="current-status-box mb-15">
                        <span class="label">Connexion :</span>
                        <strong class="status-text">
                            <span class="{{ agent.isOnline is defined and agent.isOnline ? 'active' : 'inactive' }}">
                                <i class="fa-solid fa-globe"></i>
                                {{ agent.isOnline is defined and agent.isOnline ? 'EN LIGNE' : 'HORS LIGNE' }}
                            </span>
                        </strong>
                    </div>
                    <div class="current-status-box mb-15">
                        <span class="label">Autorisation :</span>
                        <strong class="status-text">
                            {% if not agent.isActive %}
                                <span class="inactive">
                                    <i class="fa-solid fa-lock text-danger"></i>
                                    COMPTE BLOQUÉ
                                </span>
                            {% else %}
                                <span class="active">
                                    <i class="fa-solid fa-unlock text-success"></i>
                                    COMPTE ACTIF
                                </span>
                            {% endif %}
                        </strong>
                    </div>
                    <hr class="section-divider mb-15">
                    <div class="notice-box-info">
                        <p>
                            <i class="fa-solid fa-circle-info"></i>
                            Ce registre historique basé sur la table de sécurité **UserRole** audite les habilitations et la responsabilité financière des caisses de chaque guichet.
                        </p>
                    </div>
                </div>
            </aside>
        </div>
    </div>
{% endblock %}
