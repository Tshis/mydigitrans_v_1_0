{# templates/admin/platform/subscription_plan/form.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
<div class="admin-platform-scope container">

    {# --- EN-TÊTE CONFIGURABLE --- #}
    <header class="header-refined my-25">
        <div class="header-main-info">
            <a href="{{ path('admin_platform_subscription_index') }}" class="agency-back-action">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div class="title">
                <div class="sub-header-flex">
                    <span class="text-gray text-size-13">Spécifications Commerciales</span>
                    <span class="arrow-divider">•</span>
                    <span class="text-primary text-size-13 text-highlight">Configuration Offres</span>
                </div>
                <h1 class="mt-5">{{ is_edit ? 'Ajuster le Forfait : ' ~ plan.name|upper : 'Créer un Forfait d\'Usine' }}
                </h1>
            </div>
        </div>
    </header>

    {# --- FORMULAIRE UNIQUE --- #}
    <form action="#" method="POST" class="settings-form-layout">
        <div class="settings-container-grid">

            {# COLONNE GAUCHE : SÉCURITÉ STATUT #}
            <aside class="sidebar-action-panel">
                <div class="card sticky-aside-card">
                    <h2 class="card-title-fix">
                        <i class="fa-solid fa-toggle-on text-primary"></i>
                        Visibilité Catalogue
                    </h2>

                    <div class="currency-checkbox-group">
                        <label class="checkbox-container">
                            <input type="checkbox" name="status" value="active" {{ (not is_edit) or
                                plan.status=='active' ? 'checked' : '' }}>
                            <span class="checkmark"></span>
                            Forfait Actif (Disponible pour les agences)
                        </label>
                    </div>

                    <div class="notice-box-info">
                        <p>
                            <strong>
                                <i class="fa-solid fa-shield-halved"></i>
                                Impact des Ajustements :</strong>
                            Modifier le prix ou les quotas d'un forfait existant n'impactera pas rétroactivement les
                            factures (`Invoice`) déjà payées ou émises. Les nouvelles restrictions s'appliqueront
                            uniquement lors des prochains cycles de renouvellement.
                        </p>
                    </div>
                </div>
            </aside>

            {# COLONNE DROITE : PARAMÈTRES ET LIMITATIONS MÉTIERS #}
            <div class="main-form-panel">
                <div class="card control-card mb-20">
                    <h2 class="card-title-fix"><i class="fa-solid fa-sliders text-primary"></i> 1. Caractéristiques de
                        l'Offre</h2>

                    <div class="field-group mb-20">
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Nom du forfait (Code unique) *</label>
                            <input type="text" name="name" class="admin-bus-layout-add-input"
                                placeholder="Ex: basic, pro, VIP, trial" value="{{ is_edit ? plan.name : '' }}" {{
                                is_edit ? 'readonly' : '' }} required>
                        </div>
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Durée de validité (en jours) *</label>
                            <input type="number" name="duration_days" class="admin-bus-layout-add-input"
                                placeholder="Ex: 30" value="{{ is_edit ? plan.duration_days : '30' }}" required>
                        </div>
                    </div>

                    <div class="field-group mb-20">
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Tarif Mensuel Recurrent *</label>
                            <input type="number" step="0.01" name="price" class="admin-bus-layout-add-input"
                                placeholder="0.00" value="{{ is_edit ? plan.price : '0.00' }}" required>
                        </div>
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Devise de Facturation SaaS *</label>
                            <select name="currency" class="admin-bus-layout-add-select" required>
                                <option value="USD" {{ is_edit and plan.currency=='USD' ? 'selected' : '' }}>USD -
                                    Dollar Américain</option>
                                <option value="EUR" {{ is_edit and plan.currency=='EUR' ? 'selected' : '' }}>EUR - Euro
                                </option>
                            </select>
                        </div>
                    </div>

                    <h2 class="card-title-fix pt-10">
                        <i class="fa-solid fa-chart-pie text-primary"></i>
                        2. Quotas & Limitations Techniques (Tenant Restrictions)
                    </h2>

                    <div class="field-group mb-20">
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Nombre max de gares (max_branches) *</label>
                            <input type="number" name="max_branches" class="admin-bus-layout-add-input"
                                placeholder="Ex: 5 (999 pour illimité)" value="{{ is_edit ? plan.max_branches : '1' }}"
                                required>
                        </div>
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Flotte maximum autorisée (max_buses) *</label>
                            <input type="number" name="max_buses" class="admin-bus-layout-add-input"
                                placeholder="Ex: 10" value="{{ is_edit ? plan.max_buses : '5' }}" required>
                        </div>
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Utilisateurs max (max_users) *</label>
                            <input type="number" name="max_users" class="admin-bus-layout-add-input" placeholder="Ex: 5"
                                value="{{ is_edit ? plan.max_users : '5' }}" required>
                        </div>
                    </div>

                    {# --- COMPOSANT DES ASSOCATIONS PLANFEATURE [MCD 32] --- #}
                    <h2 class="card-title-fix pt-10"><i class="fa-solid fa-cubes text-primary"></i> 3. Associer les
                        Fonctionnalités Applicatives</h2>
                    <label class="admin-bus-layout-add-label sub-title-hint-label">Cochez les modules d'usine à injecter
                        dans ce forfait :</label>

                    <div class="platform-features-selection-grid my-20">
                        {% for feature in system_features %}
                        <div class="feature-checkbox-card">
                            <label class="checkbox-container">
                                {# Si on modifie, on coche automatiquement si la feature est déjà liée dans PlanFeature
                                #}
                                <input type="checkbox" name="features[]" value="{{ feature.code }}" {{ is_edit and
                                    feature.code in plan_active_features ? 'checked' : '' }}>
                                <span class="checkmark"></span>
                                <div class="feature-meta-label">
                                    <strong>{{ feature.name }}</strong>
                                    <small class="monospace">{{ feature.code }}</small>
                                    <p class="feature-desc-text">{{ feature.description }}</p>
                                </div>
                            </label>
                        </div>
                        {% endfor %}
                    </div>

                    <div class="field-button-right">
                        <a href="{{ path('admin_platform_subscription_index') }}"
                            class="btn-refined btn-gray-gradient mr-10">Annuler</a>
                        <button type="submit" class="btn-refined btn-success-gradient">
                            <i class="fa-solid {{ is_edit ? 'fa-floppy-disk' : 'fa-cloud-arrow-up' }}"></i>
                            {{ is_edit ? 'Sauvegarder les Ajustements' : 'Déployer le Forfait Système' }}
                        </button>
                    </div>
                </div>
            </div>



        </div>
    </form>
</div>{% endblock %}