{# templates/admin/platform/finance/expense_form.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
<div class="admin-platform-scope container">

    {# --- EN-TÊTE --- #}
    <header class="header-refined my-25">
        <div class="header-main-info">
            <a href="{{ path('admin_platform_finance_index') }}" class="agency-back-action">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div class="title">
                <div class="sub-header-flex">
                    <span class="text-gray text-size-13">Trésorerie Centrale</span>
                    <span class="arrow-divider">•</span>
                    <span class="text-primary text-size-13 text-highlight">Flux Sortant (OUT)</span>
                </div>
                <h1 class="mt-5">Enregistrer une Dépense & Décaissement</h1>
            </div>
        </div>
    </header>

    {# --- FORMULAIRE DOUBLE COLONNE INVERSÉ --- #}
    <form action="#" method="POST" class="settings-form-layout">
        <div class="settings-container-grid">

            {# COLONNE DROITE : SÉCURITÉ COMPTABLE (PLACÉE EN PREMIER DANS LE GRILLE) #}
            <aside class="sidebar-action-panel">
                <div class="card sticky-aside-card flex-aside-sidebar-theme-danger">
                    <h2 class="card-title-fix">
                        <i class="fa-solid fa-shield-halved"></i>
                        Contrôle des Sorties
                    </h2>
                    <div class="notice-box-info">
                        <p>
                            <strong>
                                <i class="fa-solid fa-calculator"></i>
                                Calcul du Solde en Direct :</strong>
                            Valider ce formulaire va automatiquement déduire ce montant de la valeur
                            <strong class="monospace">Solde actuel</strong>
                            de la caisse. Cette action diminuera immédiatement tes liquides
                            disponible.
                        </p>
                    </div>
                </div>
            </aside>

            {# COLONNE GAUCHE : PARAMÈTRES DE LA DÉPENSE #}
            <div class="main-form-panel">
                <div class="card control-card mb-20">
                    <h2 class="card-title-fix">
                        <i class="fa-solid fa-square-minus text-danger-mode"></i>
                        Écriture de Décaissement
                    </h2>



                    <div class="field-group mb-20">
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Intitulé / Nature de la Dépense *</label>
                            <input type="text" name="name" class="admin-bus-layout-add-input"
                                placeholder="Ex: Hébergement serveurs, Loyer Bureau" required>
                        </div>
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Montant à Décaisser ($) *</label>
                            <input type="number" step="0.01" name="amount" class="admin-bus-layout-add-input"
                                placeholder="0.00" required>
                        </div>
                    </div>

                    <div class="field-group mb-25">
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Description Explicative Détaillée *</label>
                            <input type="text" name="description" class="admin-bus-layout-add-input"
                                placeholder="Ex: Paiement facture mensuelle AWS Cloud infrastructure MyDigitrans"
                                required>
                        </div>
                    </div>

                    <div class="admin-bus-layout-add-action-zone">
                        <a href="{{ path('admin_platform_finance_index') }}"
                            class="btn-refined btn-gray-gradient">Annuler</a>
                        <button type="submit" class="btn-refined btn-danger-gradient">
                            <i class="fa-solid fa-floppy-disk"></i>
                            Enrgistrer la depense
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>
{% endblock %}