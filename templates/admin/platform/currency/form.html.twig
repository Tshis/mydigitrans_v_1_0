{# templates/admin/platform/currency/form.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div class="admin-platform-scope container">

		{# --- EN-TÊTE CONFIGURABLE --- #}
		<header class="header-refined my-25">
			<div class="header-main-info">
				<a href="{{ path('admin_platform_currency_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Référentiel International</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Dictionnaire Monétaire</span>
					</div>
					<h1 class="mt-5">{{ is_edit ? 'Ajuster la Devise : ' ~ currency.code : 'Ajouter une Devise Système' }}</h1>
				</div>
			</div>
		</header>

		{# --- FORMULAIRE UNIQUE --- #}
		<form action="{{ is_edit ? path('admin_platform_currency_edit', {'code' : currency.code}) : path('admin_platform_currency_add') }}" method="POST" class="settings-form-layout">
			<div class="settings-container-grid" style="grid-template-columns: 1fr;">

				{# COLONNE UNIQUE : SÉMANTIQUE DE LA MONNAIE #}
				<div class="main-form-panel">
					<div class="card control-card mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-coins text-primary"></i>
							Spécifications de la Devise</h2>

						<div class="field-group mb-20" style="display: grid; grid-template-columns: 1fr 2fr; gap: 20px;">
							<div class="field">
								<label class="admin-bus-layout-add-label">Code ISO International *</label>
								<input type="text" name="code" class="admin-bus-layout-add-input font-monospace-code" placeholder="Ex: USD, CDF, XAF" style="text-transform: uppercase;" minlength="3" maxlength="10" value="{{ is_edit ? currency.code : '' }}" {{ is_edit ? 'readonly' : '' }} required>
							</div>
							<div class="field">
								<label class="admin-bus-layout-add-label">Nom Complet de la Monnaie *</label>
								<input type="text" name="name" class="admin-bus-layout-add-input" placeholder="Ex: Dollar Américain, Franc Congolais" value="{{ is_edit ? currency.name : '' }}" required>
							</div>
						</div>

						<div class="admin-bus-layout-add-action-zone">
							<a href="{{ path('admin_platform_currency_index') }}" class="btn-refined btn-gray-gradient">Annuler</a>
							<button type="submit" class="btn-refined btn-success-gradient">
								<i class="fa-solid {{ is_edit ? 'fa-floppy-disk' : 'fa-cloud-arrow-up' }}"></i>
								{{ is_edit ? 'Enregistrer les Modifications' : 'Greffer la Devise au Système' }}
							</button>
						</div>
					</div>
				</div>

			</div>
		</form>
	</div>
{% endblock %}
