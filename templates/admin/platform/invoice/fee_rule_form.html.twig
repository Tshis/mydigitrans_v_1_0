{# templates/admin/platform/invoice/fee_rule_form.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
<div class="admin-platform-scope container">

    {# --- EN-TÊTE --- #}
    <header class="header-refined my-25">
        <div class="header-main-info">
            <a href="{{ path('admin_platform_invoice_index') }}" class="agency-back-action">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div class="title">
                <div class="sub-header-flex">
                    <span class="text-gray text-size-13">Spécifications Facturation</span>
                    <span class="arrow-divider">•</span>
                    <span class="text-primary text-size-13 text-highlight">Barème Réseau
                    </span>
                </div>
                <h1 class="mt-5">{{ is_edit ? 'Ajuster la Règle de Facturation' : 'Créer une Règle de Facturation' }}
                </h1>
            </div>
        </div>
    </header>

    {# --- FORMULAIRE DOUBLE COLONNE INVERSÉ --- #}
    <form action="#" method="POST" class="settings-form-layout">
        <div class="settings-container-grid">

            {# COLONNE DROITE : ALERTE RÉGLEMENTAIRE (EN PREMIER DANS LE GRILLE) #}
            <aside class="sidebar-action-panel">
                <div class="card sticky-aside-card flex-aside-sidebar-theme">
                    <h2 class="card-title-fix">
                        <i class="fa-solid fa-shield-halved"></i>
                        Cadrage Système
                    </h2>
                    <div class="notice-box-info">
                        <p>
                            <strong>
                                <i class="fa-solid fa-circle-exclamation"></i>
                                Priorité de la Règle :
                            </strong>
                            Si vous affectez une agence spécifique à cette règle, elle écrasera la règle générale de 1 $
                            de la plateforme pour cette compagnie. Laissez le champ agence vide pour appliquer la règle
                            à l'ensemble du réseau.
                        </p>
                    </div>
                </div>
            </aside>

            {# COLONNE GAUCHE : PARAMÈTRES COMPTABLES DE LA RÈGLE #}
            <div class="main-form-panel">
                <div class="card control-card mb-20">
                    <h2 class="card-title-fix">
                        <i class="fa-solid fa-sliders text-primary"></i>
                        Configuration du Prélèvement
                    </h2>

                    <div class="field-group mb-20">
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Source Déclencheuse *</label>
                            <select name="source_type" class="admin-bus-layout-add-select" required>
                                <option value="reservation" {{ is_edit and rule.sourceType=='reservation' ? 'selected'
                                    : '' }}>reservation (Vente de Billet Passager)</option>
                                <option value="shipment" {{ is_edit and rule.sourceType=='shipment' ? 'selected' : ''
                                    }}>shipment (Expédition de Colis / Fret)</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Type de Prélèvement *</label>
                            <select name="fee_type" class="admin-bus-layout-add-select" required>
                                <option value="fixed" {{ is_edit and rule.feeType=='fixed' ? 'selected' : '' }}>fixed
                                    (Montant Fixe - ex: 1$)</option>
                                <option value="percent" {{ is_edit and rule.feeType=='percent' ? 'selected' : '' }}>
                                    percent (Pourcentage sur le volume)</option>
                            </select>
                        </div>
                    </div>

                    <div class="field-group mb-20">
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Valeur Numérique du Prélèvement *</label>
                            <input type="number" step="0.01" name="value" class="admin-bus-layout-add-input"
                                placeholder="Ex: 1.00" value="{{ is_edit ? rule.value : '1.00' }}" required>
                        </div>
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Devise Affectée</label>
                            <select name="currency" class="admin-bus-layout-add-select">
                                <option value="USD" {{ is_edit and rule.currency=='USD' ? 'selected' : '' }}>USD ($)
                                </option>
                                <option value="CDF" {{ is_edit and rule.currency=='CDF' ? 'selected' : '' }}>CDF (FC)
                                </option>
                                <option value="XAF" {{ is_edit and rule.currency=='XAF' ? 'selected' : '' }}>XAF (FCFA)
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="field-group mb-25">
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Agence Spécifique d'Exception
                                *</label>
                            <select name="agency_id" class="admin-bus-layout-add-select">
                                <option value="">-- Appliquer à tout le réseau d'usine (Générale) --</option>
                                {% for agency in agencies %}
                                <option value="{{ agency.id }}" {{ is_edit and rule.agency_id==agency.id ? 'selected'
                                    : '' }}>{{ agency.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="admin-bus-layout-add-action-zone">
                        <a href="{{ path('admin_platform_invoice_index') }}"
                            class="btn-refined btn-gray-gradient">Annuler</a>
                        <button type="submit" class="btn-refined btn-primary-gradient">
                            <i class="fa-solid fa-floppy-disk"></i>
                            {{ is_edit ? 'Sauvegarder les Modification' : 'Déployer la Règle Réseau' }}
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>
{% endblock %}