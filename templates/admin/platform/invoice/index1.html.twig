{# templates/admin/platform/invoice/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
{{ parent() }}
<script src="/js/datatable.js" defer></script>
<script src="/js/admin/platform_tabs.js" defer></script>
<script src="/js/admin/modalQuestion.js" defer></script>
{% endblock %}

{% block body %}
<div class="admin-platform-scope container">

	{# --- EN-TÊTE --- #}
	<header class="header-refined my-25">
		<div class="header-main-info">
			<div class="title">
				<div class="sub-header-flex">
					<span class="text-gray text-size-13">Supervision Comptable</span>
					<span class="arrow-divider">•</span>
					<span class="text-primary text-size-13 text-highlight">Registre Global</span>
				</div>
				<h1 class="mt-5">Facturation du Réseau (Invoices)</h1>
			</div>
		</div>
	</header>

	{# --- COMPOSANT MACRO DE MONITORING FINANCIER CENTRAL --- #}
	<div class="stats-grid mb-25">

		{# CARTE 1 : FACTURE GENEREE (du mois) #}
		<div class="card control-card kpi-card kpi-success">
			<div class="kpi-icon-wrapper text-success-mode">
				<i class="fa-solid fa-vault"></i>
			</div>
			<div class="kpi-data">
				<label class="admin-bus-layout-add-label">
					Coffre Central (Disponible)
				</label>
				<span class="kpi-value text-success-color">{{ cash_summary.vault_total|number_format(2, ',', ' ') }}
					$</span>
			</div>
		</div>

		{# CARTE 2 : FACTURE PAYEE (du mois) #}
		<div class="card control-card kpi-card kpi-card kpi-danger">
			<div class="kpi-icon-wrapper text-danger-mode">
				<i class="fa-solid fa-money-bill-wave"></i>
			</div>
			<div class="kpi-data">
				<label class="admin-bus-layout-add-label">Total Dépenses Centrales ({{ "now"|date('F') }}
					)</label>
				<span class="kpi-value text-danger-color">{{ cash_summary.expense_total|number_format(2, ',', ' ')
					}}
					$</span>
			</div>
		</div>

		{# CARTE 2 : FACTURE NON PAYEE (du mois) #}
		<div class="card control-card kpi-card kpi-card kpi-danger">
			<div class="kpi-icon-wrapper text-danger-mode">
				<i class="fa-solid fa-money-bill-wave"></i>
			</div>
			<div class="kpi-data">
				<label class="admin-bus-layout-add-label">Total Dépenses Centrales ({{ "now"|date('F') }}
					)</label>
				<span class="kpi-value text-danger-color">{{ cash_summary.expense_total|number_format(2, ',', ' ')
					}}
					$</span>
			</div>
		</div>


	</div>

	{# 1. Mise à jour de la barre de navigation des onglets #}
	<div class="platform-tabs-navigation mb-25">
		<button type="button" class="tab-nav-btn active" data-target="panel-invoices">
			<i class="fa-solid fa-receipt"></i>
			Registre des Factures (Invoices)
		</button>
		<button type="button" class="tab-nav-btn" data-target="panel-rules">
			<i class="fa-solid fa-gavel"></i>
			Règles de Commission (platformFeeRule)
		</button>
	</div>

	{# --- GRILLE COMPTABLE EXPANSIVE DILATÉE ET AÉRÉE --- #}
	<div class="tab-panel-content active" id="panel-invoices">
		<div class="table-responsive-wrapper">
			<h2 class="card-title-fix text-size-14 py-10">
				<i class="fa-solid fa-receipt text-primary"></i>
				Journal Général des Factures Émises
			</h2>
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>N° Facture</th>
						<th>Agence Compte</th>
						<th>Nature Facture</th>
						<th>Période Couverte</th>
						<th class="text-right">Reste à Payer (Balance)</th>
						<th class="text-right">Montant Total</th>
						<th class="text-center">Statut Facture</th>
						<th class="text-right">Audit</th>
					</tr>
				</thead>
				<tbody>
					{% for invoice in global_invoices_list %}
					<tr>
						<td class="monospace font-bold">
							<strong>{{ invoice.invoiceNumber }}</strong>
						</td>
						<td>
							<strong>{{ invoice.agency_name }}</strong>
						</td>
						<td>
							<span class="invoice-nature-label">
								{% if invoice.type == 'subscription' %}
								<i class="fa-solid fa-calendar-check text-primary-mode"></i>
								Abonnement Fixe
								{% elseif invoice.type == 'platformFee' %}
								<i class="fa-solid fa-percent text-success-mode"></i>
								Commissions Escales
								{% else %}
								<i class="fa-solid fa-layer-group text-warning-mode"></i>
								Facture Mixte
								{% endif %}
							</span>
						</td>
						<td class="monospace text-size-12 text-gray">
							{{ invoice.periodStart|date('d/m/y') }}
							⇄
							{{ invoice.periodEnd|date('d/m/y') }}
						</td>
						<td
							class="text-right font-bold monospace {% if invoice.balanceDue > 0 %}text-balance-warning{% endif %}">
							{{ invoice.balanceDue|number_format(2, ',', ' ') }}
							{{ invoice.currency }}
						</td>
						<td class="text-right font-bold monospace text-total-amount">
							{{ invoice.total|number_format(2, ',', ' ') }}
							{{ invoice.currency }}
						</td>
						<td class="text-center">
							<span
								class="pill-report-audit {% if invoice.status == 'paid' %}closed{% elseif invoice.status == 'overdue' %}open{% elseif invoice.status == 'cancelled' %}cancelled-status{% else %}draft{% endif %}">
								{{ invoice.status|upper }}
							</span>
						</td>
						<td class="text-right">
							<div class="action-group-refined">
								{# Lien pivot vers l'affichage détaillé de l'agence ou de la quittance #}
								<a href="{{ path('admin_platform_invoice_show', {'id': invoice.id}) }}"
									class="action-link view-file" title="Inspecter la facture & Justificatifs">
									<i class="fa-solid fa-eye"></i>
								</a>
							</div>
						</td>
					</tr>
					{% else %}
					<tr>
						<td colspan="8" class="text-center text-gray italic padding-20">Aucune facture enregistrée dans
							le
							grand livre système.</td>
					</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

	{# 2. LE NOUVEAU PANNEAU DES RÈGLES DE CONFIGURATION DES COMMISSIONS #}
	<div class="tab-panel-content" id="panel-rules">
		<div class="table-macro-actions-bar mb-15">
			<div class="actions-hint-text">
				<i class="fa-solid fa-circle-info text-primary-mode"></i>
				<span>Barème d'usine des prélèvements fixes ou proportionnels sur le trafic des terminaux POS et
					guichets.</span>
			</div>
			<a href="{{ path('admin_platform_fee_rule_add') }}" class="btn-refined btn-primary-gradient">
				<i class="fa-solid fa-plus"></i>
				Nouvelle Règle de Commission
			</a>
		</div>

		<div class="table-responsive-wrapper card">
			<table class="table table-scrollable table-striped">
				<thead>
					<tr>
						<th>Type d'Événement (Source)</th>
						<th>Mode de Prélèvement</th>
						<th class="text-right">Valeur de la Règle</th>
						<th>Agence Spécifique</th>
						<th class="text-center">Statut Usine</th>
						<th class="text-right">Actions Référentiel</th>
					</tr>
				</thead>
				<tbody>
					{% for rule in fee_rules_list %}
					<tr>
						<td class="font-bold text-primary-mode">
							{% if rule.sourceType == 'reservation' %}
							<i class="fa-solid fa-ticket"></i>
							Billet (reservation)
							{% else %}
							<i class="fa-solid fa-box"></i>
							Colis (shipment)
							{% endif %}
						</td>
						<td class="font-bold">{{ rule.feeType == 'fixed' ? 'Montant Fixe' : 'Pourcentage' }}</td>
						<td class="text-right font-bold monospace">
							{{ rule.value|number_format(2, ',', ' ') }}
							{{ rule.currency|default('$') }}
						</td>
						<td>
							{% if rule.agency_name %}
							<span class="font-bold text-warning-mode">
								<i class="fa-solid fa-building-flag"></i>
								{{ rule.agency_name }}</span>
							{% else %}
							<span class="text-gray italic">Toutes les agences (Générale)</span>
							{% endif %}
						</td>
						<td class="text-center">
							<span class="pill-report-audit {{ rule.isActive ? 'closed' : 'open' }}">
								{{ rule.isActive ? 'Active' : 'Suspendue' }}
							</span>
						</td>
						<td class="text-right">
							<div class="action-group-refined">
								{# Action 1 : Modifier la règle #}
								<a href="{{ path('admin_platform_fee_rule_edit', {'id': rule.id}) }}"
									class="action-link edit" title="Ajuster la valeur du barème">
									<i class="fa-solid fa-pen-to-square"></i>
								</a>

								<a id="ctaBtn"
									data-target="{{ path('admin_platform_fee_rule_toggle', {'id': rule.id}) }}"
									class="action-link {{ rule.isActive ? 'text-primary' : 'text-success' }}"
									title="Changer le statut opérationnel">
									<i class="fa-solid {{ rule.isActive ? 'fa-ban' : 'fa-circle-check' }}"></i>
								</a>

							</div>
						</td>
					</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>


</div>

{% include "admin/partials/_modal.html.twig" %}

{% endblock %}