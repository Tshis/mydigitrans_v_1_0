{# templates/admin/agency/bus/show.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
    {{ parent() }}
    <script src="/js/admin/bus_profil.js" defer></script>
    <script src="/js/seatmap.js" defer></script>
    <script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
    <div class="agency-bus-profile-scope">
        <div class="agency-bus-profile-container">

            {# --- EN-TÊTE --- #}
            <header class="agency-bus-profile-header">
                <a href="{{ path('admin_agency_bus_index') }}" class="agency-bus-profile-back">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div class="bus-info text-center">
                    <h2 class="agency-bus-profile-title">Fiche Véhicule : {{ bus.code }} ({{ bus.plateNumber }})</h2>
                    <p class="agency-bus-profile-subtitle">{{ bus.brand }} {{ bus.model }}{% if bus.name %} — {{ bus.name }}{% endif %} • {{ bus.seats|length }} places</p>
                    <p class="text-dark text-size-13 my-10">Gabarit : {{ bus.busLayout.name }} • Année {{ bus.year }}</p>
                </div>
                <div class="agency-bus-profile-status-badge-zone text-weight-700 text-size-20">
                    {% if bus.status.value == 'active' %}
                        <span class="agency-bus-state-badge agency-bus-state-badge--on-route" id="current-global-status">En service</span>
                    {% elseif bus.status.value == 'maintenance' %}
                        <span class="agency-bus-state-badge" style="background: rgba(230, 126, 34, 0.15); color: #d35400;" id="current-global-status">Au garage</span>
                    {% else %}
                        <span class="agency-bus-state-badge" style="background: rgba(231, 76, 60, 0.15); color: #c0392b;" id="current-global-status">Déclassé</span>
                    {% endif %}
                </div>
            </header>

            {# --- DOCUMENTS DU VÉHICULE --- #}
            <div class="admin-agency-fleet-document-scope">
                <div class="action-header">
                    <div class="title">
                        <h3>
                            <i class="fa-solid fa-file-lines"></i>
                            Documents du véhicule
                        </h3>
                        <p class="subtitle">Suivi des assurances, cartes roses et pièces légales obligatoires.</p>
                    </div>

                    {% if is_granted('bus.write') and bus.status.value != 'inactive' %}
                        <a href="{{ path('admin_agency_bus_choosen_document_add', {'bus_code': bus.code}) }}" class="btn-refined btn-primary-gradient text-size-14">
                            <i class="fa-solid fa-file-circle-plus"></i>
                            Nouveau document
                        </a>
                    {% endif %}
                </div>

                <div class="table-responsive-wrapper">
                    <table class="table table-scrollable table-striped js-datatable">
                        <thead>
                            <tr>
                                <th>Type de Document</th>
                                <th>Référence</th>
                                <th>Date d'Émission</th>
                                <th>Date d'Expiration</th>
                                <th class="text-center">Statut</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for doc in documents %}
                                <tr>
                                    <td><strong>{{ doc.type }}</strong></td>
                                    <td>{{ doc.referenceNumber|default('Non spécifié') }}</td>
                                    <td>{{ doc.issuedAt|date('d/m/Y') }}</td>
                                    <td>{{ doc.expiredAt|date('d/m/Y') }}</td>
                                    <td class="text-center">
                                        <span class="pill-document-status {{ doc.status }}">
                                            {{ doc.status == 'expired' ? 'Expiré' : 'Valide' }}
                                        </span>
                                    </td>
                                    <td class="text-right">
                                        <div class="action-group-refined">
                                            {% if doc.url %}
                                                <a href="{{ path('admin_agency_bus_document_download_file', {'code': doc.code}) }}" target="_blank" class="action-link view-file" title="Télécharger le scan">
                                                    <i class="fa-solid fa-download"></i>
                                                </a>
                                            {% endif %}

                                            {% if is_granted('bus.write') %}
                                                {% if doc.status == 'expired' %}
                                                    <a href="{{ path('admin_agency_bus_document_renew', {'bus_code': bus.code, 'doc_code': doc.code}) }}" class="action-link" title="Renouveler">
                                                        <i class="fa-solid fa-arrows-rotate"></i>
                                                    </a>
                                                {% else %}
                                                    <a href="{{ path('admin_agency_bus_document_edit', {'bus_code': bus.code, 'doc_code': doc.code}) }}" class="action-link" title="Modifier">
                                                        <i class="fa-solid fa-file-pen"></i>
                                                    </a>
                                                {% endif %}
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center text-gray italic padding-20">
                                        Aucun document administratif répertorié pour le moment.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {# --- FORMULAIRES & BLOCS --- #}
            <div class="agency-bus-profile-layout">

                <div class="left-side">

                    {# FORMULAIRE DE MISE À JOUR DU BUS #}
                    <div class="agency-bus-profile-card">
                        <h3 class="agency-bus-profile-card-title">
                            <i class="fa-solid fa-pen-to-square"></i>
                            Informations du Bus
                        </h3>
                        <form id="agency-bus-update-form" class="agency-bus-profile-form" method="POST" action="{{ path('admin_agency_bus_update', {'code': bus.code}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('bus_update_' ~ bus.code) }}">

                            <div class="field-group mb-20">
                                <div class="field">
                                    <label class="agency-bus-profile-form-label">Plaque d'Immatriculation *</label>
                                    <input type="text" name="plate_number" class="agency-bus-profile-form-input" value="{{ bus.plateNumber }}" {{ bus.status.value == 'inactive' or not is_granted('bus.write') ? 'disabled' : '' }} required>
                                </div>
                                <div class="field">
                                    <label class="agency-bus-profile-form-label">Kilométrage (km parcourus) *</label>
                                    <input type="number" name="mileage" class="agency-bus-profile-form-input" value="{{ bus.mileage }}" min="{{ bus.mileage }}" {{ bus.status.value == 'inactive' or not is_granted('bus.write') ? 'disabled' : '' }} required>
                                </div>
                            </div>

                            <div class="field-group mb-20">
                                <div class="field">
                                    <label class="agency-bus-profile-form-label">Marque *</label>
                                    <input type="text" name="brand" class="agency-bus-profile-form-input" value="{{ bus.brand }}" {{ bus.status.value == 'inactive' or not is_granted('bus.write') ? 'disabled' : '' }} required>
                                </div>
                                <div class="field">
                                    <label class="agency-bus-profile-form-label">Modèle *</label>
                                    <input type="text" name="model" class="agency-bus-profile-form-input" value="{{ bus.model }}" {{ bus.status.value == 'inactive' or not is_granted('bus.write') ? 'disabled' : '' }} required>
                                </div>
                            </div>

                            <div class="field-group mb-20">
                                <div class="field">
                                    <label class="agency-bus-profile-form-label">Nom commercial</label>
                                    <input type="text" name="name" class="agency-bus-profile-form-input" value="{{ bus.name }}" {{ bus.status.value == 'inactive' or not is_granted('bus.write') ? 'disabled' : '' }}>
                                </div>
                                <div class="field">
                                    <label class="agency-bus-profile-form-label">Année de fabrication *</label>
                                    <input type="number" name="year" class="agency-bus-profile-form-input" value="{{ bus.year }}" min="1990" max="2027" {{ bus.status.value == 'inactive' or not is_granted('bus.write') ? 'disabled' : '' }} required>
                                </div>
                            </div>

                            {% if is_granted('bus.write') and bus.status.value != 'inactive' %}
                                <div class="field-button-right">
                                    <button type="submit" class="btn-refined btn-success-gradient text-size-12">
                                        <i class="fa-solid fa-floppy-disk"></i>
                                        Enregistrer les modifications
                                    </button>
                                </div>
                            {% endif %}
                        </form>
                    </div>
                    {# DÉCLASSEMENT (ZONE CRITIQUE) #}
                    {% if is_granted('bus.write') %}
                        <div class="agency-bus-profile-card agency-bus-profile-card--critical">
                            <h3 class="agency-bus-profile-card-title text-danger">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Zone de Danger
                            </h3>
                            {% if bus.status.value == 'inactive' %}
                                <div class="agency-bus-maintenance-status-box border-dark">
                                    <p class="text-danger"><strong>Véhicule déclassé :</strong> {{ bus.inactiveReason }}</p>
                                </div>
                            {% else %}
                                <div class="agency-bus-maintenance-status-box border-dark">
                                    <p>Le déclassement retire définitivement le bus du réseau actif. Utilisez cette option si le véhicule est vendu, détruit ou jugé irréparable.</p>

                                    <button type="button" id="btn-trigger-decommission" class="btn btn-danger btn-full text-size-12">
                                        <i class="fa-solid fa-trash-can"></i>
                                        Déclasser / Rendre inactif ce bus
                                    </button>
                                </div>

                                <div id="decommission-action-panel" class="agency-bus-panic-panel panel-border-danger hidden">
                                    <form method="POST" action="{{ path('admin_agency_bus_decommission', {'code': bus.code}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('bus_decommission_' ~ bus.code) }}">
                                        <div class="field mb-20">
                                            <label class="agency-bus-profile-form-label text-danger">Motif du déclassement définitif *</label>
                                            <select name="inactive_reason" id="decommission-reason-select" class="agency-bus-profile-form-select" required>
                                                <option value="Véhicule vendu / Cédé">Véhicule vendu / Cédé</option>
                                                <option value="Véhicule irréparable (Épave / Réforme)">Véhicule irréparable (Épave / Réforme)</option>
                                                <option value="Fin de contrat de leasing / Retrait">Fin de contrat de leasing / Retrait</option>
                                            </select>
                                        </div>
                                        <div class="agency-bus-panic-actions">
                                            <button type="button" id="btn-cancel-decommission" class="btn btn-dark text-size-12">Annuler</button>
                                            <button type="submit" class="btn btn-success text-size-12">Confirmer la radiation</button>
                                        </div>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}

                    {# HISTORIQUE DES PANNES #}
                    <div class="maintenance-history-wrapper">
                        <div class="table-responsive-wrapper my-20">
                            <h2 class="card-title-fix text-size-16 py-10">
                                <i class="fa-solid fa-screwdriver-wrench text-primary"></i>
                                Historique des Pannes & Interventions
                            </h2>
                            <table class="table table-scrollable table-striped js-datatable">
                                <thead>
                                    <tr>
                                        <th>Date signalement</th>
                                        <th>Gravité</th>
                                        <th>Diagnostic / Rapport</th>
                                        <th>Statut</th>
                                        <th class="text-right">Date résolution</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for log in maintenanceHistory %}
                                        <tr>
                                            <td>{{ log.reportedAt|date('d/m/Y H:i') }}</td>
                                            <td><span class="monospace font-bold">{{ log.severity.value|upper }}</span></td>
                                            <td>{{ log.solution|default('En attente de diagnostic...')|nl2br }}</td>
                                            <td>
                                                <span class="pill-maintenance {{ log.status.value == 'broken' ? 'in_progress' : 'resolved' }}">
                                                    {{ log.status.value == 'broken' ? 'Panne' : (log.status.value == 'resolved' ? 'Résolue' : 'Annulée') }}
                                                </span>
                                            </td>
                                            <td class="text-right text-success-mode font-bold">
                                                {{ log.resolvedAt ? log.resolvedAt|date('d/m/Y') : 'En attente...' }}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-center text-gray italic padding-20">
                                                Aucun incident technique signalé sur ce véhicule. Excellent état.
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
                {# /left-side #}

                {# --- COLONNE DROITE : GARAGE & PLAN DE SIÈGES --- #}
                <div class="right-side seatmap-section">

                    {% if bus.status.value != 'inactive' %}
                        <div class="agency-bus-profile-card">
                            <h3 class="agency-bus-profile-card-title" id="maintenance-card-title">
                                <i class="fa-solid fa-wrench"></i>
                                État Technique & Garage
                            </h3>

                            {% if bus.status.value == 'active' %}
                                <div id="bus-operational-box" class="agency-bus-maintenance-status-box">
                                    <p>Le véhicule est actuellement opérationnel sur le réseau national.</p>
                                    {% if is_granted('bus.write') %}
                                        <button type="button" id="btn-trigger-panic" class="btn btn-danger btn-full text-size-12">
                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                            Déclarer une panne / Envoyer au garage
                                        </button>
                                    {% endif %}
                                </div>
                            {% else %}
                                <div id="bus-broken-box" class="agency-bus-maintenance-status-box border-danger">
                                    <p class="text-danger-custom">⚠️
                                        <strong>Immobilisé :</strong>
                                        <span>{{ activeMaintenance ? activeMaintenance.solution : 'En maintenance à l\'atelier.' }}</span>
                                    </p>
                                    {% if is_granted('bus.write') %}
                                        <button type="button" id="btn-trigger-resolve" class="btn btn-success btn-full text-size-12">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Résoudre la panne / Remettre en service
                                        </button>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if is_granted('bus.write') %}
                                {# Volet 1 : Déclaration de panne #}
                                <div id="panic-action-panel" class="agency-bus-panic-panel">
                                    <form method="POST" action="{{ path('admin_agency_bus_report_fault', {'code': bus.code}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('bus_fault_' ~ bus.code) }}">
                                        <div class="field mb-10">
                                            <label>Gravité</label>
                                            <select name="severity" class="agency-bus-profile-form-select">
                                                <option value="low">Faible (Low)</option>
                                                <option value="medium" selected>Moyenne (Medium)</option>
                                                <option value="critical">Critique (Critical)</option>
                                            </select>
                                        </div>
                                        <div class="field">
                                            <label>Nature de l'avarie *</label>
                                            <textarea name="issue" id="maintenance-reason" placeholder="Détaillez la panne..." rows="3" required></textarea>
                                        </div>
                                        <div class="field-button-right my-5">
                                            <button type="button" id="btn-cancel-panic" class="btn btn-dark text-size-14">Annuler</button>
                                            <button type="submit" class="btn btn-primary ml-10 text-size-14">Confirmer le garage</button>
                                        </div>
                                    </form>
                                </div>

                                {# Volet 2 : Résolution de panne #}
                                <div id="resolve-action-panel" class="agency-bus-panic-panel panel-border-success">
                                    <form method="POST" action="{{ path('admin_agency_bus_resolve_fault', {'code': bus.code}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('bus_resolve_' ~ bus.code) }}">
                                        <div class="field">
                                            <label>Rapport de réparation / Clôture *</label>
                                            <textarea name="resolution" id="resolution-reason" placeholder="Indiquez les réparations faites..." rows="3" required></textarea>
                                        </div>
                                        <div class="agency-bus-panic-actions">
                                            <button type="button" id="btn-cancel-resolve" class="btn btn-dark text-size-14">Annuler</button>
                                            <button type="submit" class="btn btn-success text-size-14">Valider la sortie</button>
                                        </div>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}

                    {# COLONNE DU PLAN DE SIÈGES DU VÉHICULE #}
                    <div class="seatmap-zone">
                        <div class="seatmap-section-header">
                            <h4 class="seatmap-section-title">{{ seatmap.name }}</h4>
                        </div>
                        {{ include('system/seatmap.html.twig', { 'seatmap': seatmap }) }}
                    </div>

                </div>
                {# /right-side #}

            </div>
            {# /agency-bus-profile-layout #}

        </div>
        {# /agency-bus-profile-container #}
    </div>
    {# /agency-bus-profile-scope #}
{% endblock %}
