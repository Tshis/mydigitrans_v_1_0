{# templates/admin/agency/bus/index.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/datatable.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-agency-fleet-index-scope container">
		{# --- HEADER --- #}
		<header class="header-refined mb-30">
			<div class="header-left">
				<div class="breadcrumb-mini">
					<span>Logistique</span>
					<i class="fa-solid fa-chevron-right"></i>
					<strong>Flotte</strong>
				</div>
				<h1>Gestion de la Flotte</h1>
				<p class="subtitle">Suivi technique, administratif et opérationnel de vos bus.</p>
			</div>
			{% if is_granted('bus.write') %}
				<div class="header-right">
					<a href="{{ path('admin_agency_bus_add') }}" class="btn-refined btn-primary-gradient">
						<i class="fa-solid fa-plus"></i>
						<span>Ajouter un véhicule</span>
					</a>
				</div>
			{% endif %}
		</header>

		{# --- STATS RAPIDES DYNAMIQUES --- #}
		<div class="fleet-stats-grid mb-25">
			<div class="stat-card card-refined total">
				<div class="icon-wrap">
					<i class="fa-solid fa-bus"></i>
				</div>
				<div class="info">
					<h3>{{ stats.total }}</h3>
					<span>Total Flotte</span>
				</div>
			</div>
			<div class="stat-card card-refined active">
				<div class="icon-wrap">
					<i class="fa-solid fa-circle-check"></i>
				</div>
				<div class="info">
					<h3>{{ stats.active }}</h3>
					<span>En Service</span>
				</div>
			</div>
			<div class="stat-card card-refined maintenance">
				<div class="icon-wrap">
					<i class="fa-solid fa-screwdriver-wrench"></i>
				</div>
				<div class="info">
					<h3>{{ stats.maintenance }}</h3>
					<span>Au Garage</span>
				</div>
			</div>
			<div class="stat-card card-refined alert">
				<div class="icon-wrap">
					<i class="fa-solid fa-triangle-exclamation"></i>
				</div>
				<div class="info">
					<h3>{{ stats.expiredDocs }}</h3>
					<span>Doc. Expirés</span>
				</div>
			</div>
		</div>

		{# --- LISTE DE LA FLOTTE --- #}
		<div class="table-responsive-wrapper">
			<table class="table table-scrollable table-striped js-datatable">
				<thead>
					<tr>
						<th>Code</th>
						<th>Véhicule</th>
						<th>Immatriculation</th>
						<th>Capacité</th>
						<th>Kilométrage</th>
						<th class="text-center">État Administratif</th>
						<th class="text-center">Statut Opérationnel</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for bus in fleet %}
						<tr>
							<td class="monospace font-bold text-primary-mode">{{ bus.code }}</td>
							<td>
								<div class="bus-cell">
									<div class="info">
										<span class="model">{{ bus.brand }} {{ bus.model }}{% if bus.name %} ({{ bus.name }}){% endif %}</span>
										<span class="type-badge">{{ bus.layoutName }}</span>
									</div>
								</div>
							</td>
							<td>
								<span class="plate-tag">{{ bus.plateNumber }}</span>
							</td>
							<td>
								<span class="seat-count-badge">
									<i class="fa-solid fa-chair"></i>
									{{ bus.capacity }} places
								</span>
							</td>
							<td>
								<strong>{{ bus.mileage|number_format(0, ',', ' ') }} km</strong>
							</td>
							<td class="text-center">
								<span class="doc-status-pill {{ bus.docStatus }}">
									<i class="fa-solid {{ bus.docStatus == 'up-to-date' ? 'fa-shield-check' : 'fa-circle-exclamation' }}"></i>
									{{ bus.docStatus == 'up-to-date' ? 'À jour' : 'Alerte' }}
								</span>
							</td>
							<td class="text-center">
								<span class="status-pill-fleet {{ bus.status == 'maintenance' ? 'broken' : (bus.status == 'active' ? 'available' : 'expired') }}">
									{{ bus.statusLabel }}
								</span>
							</td>
							<td class="text-right">
								<div class="action-group-refined">
									<a href="{{ path('admin_agency_bus_show', {'code': bus.code}) }}" class="action-link edit" title="Fiche technique">
										<i class="fa-solid fa-eye"></i>
									</a>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="8" class="text-center text-gray italic padding-20">Aucun véhicule enregistré dans votre flotte pour le moment.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
