{# templates/admin/platform/bus_layout/add.html.twig #}
{% extends "admin/base.html.twig" %}

{% block javascripts %}
	{{ parent() }}
	<script src="/js/admin/layout_builderOld.js" defer></script>
{% endblock %}

{% block body %}
	<div class="admin-bus-layout-add-scope container">

		<header class="header-refined my-30">
			<div class="header-main-info">
				<a href="{{ path('admin_platform_bus_layout_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="agency-profile-meta">
					<h2 class="admin-bus-layout-add-title">
						<i class="fa-solid fa-compass-drafting"></i>
						Concepteur de Gabarits
					</h2>
					<p class="text-gray text-size-13">Créez des plans de sièges réutilisables pour la flotte des agences.</p>
				</div>
			</div>
		</header>

		<form action="{{ path('admin_platform_bus_layout_add') }}" class="admin-bus-layout-add-grid-layout" id="bus_layout_add_form" method="post">
			<input type="hidden" name="_token" value="{{ csrf_token('bus_layout_add') }}">

			<div class="admin-bus-layout-add-column">
				<div class="admin-bus-layout-add-card">
					<h3 class="card-inner-title mb-20">
						<i class="fa-solid fa-sliders"></i>
						Configuration Technique
					</h3>

					<div class="admin-bus-layout-add-form">
						<div class="field mb-20">
							<label class="admin-bus-layout-add-label">Nom du modèle / Gabarit *</label>
							<input type="text" id="layout-name" class="admin-bus-layout-add-input" placeholder="Ex: Yutong 55 places standard" required name="name">
						</div>

						<div class="field-group mb-20">
							<div class="field">
								<label class="admin-bus-layout-add-label">Nombre de Rangées *</label>
								<input type="number" id="layout-main-rows" class="admin-bus-layout-add-input" min="2" max="22" placeholder="Ex: 12" required name="rows">
							</div>
							<div class="field">
								<label class="admin-bus-layout-add-label">Colonnes de Sièges *</label>
								<input type="number" id="layout-main-cols" class="admin-bus-layout-add-input" min="2" max="7" placeholder="Ex: 4" required name="columns">
							</div>
						</div>

						<div class="field mb-20 toggle-field">
							<label class="checkbox-container">
								<input type="checkbox" id="layout-back-extra" checked name="backExtraSeat">
								<span class="checkmark"></span>
								Banquette complète au fond
							</label>
						</div>

						<h3 class="card-inner-title mb-20">
							<i class="fa-solid fa-chair"></i>
							Configuration Cellules spéciales (wc, chauffeur, etc)
						</h3>

						<div class="js-special-cell-wrapper mb-20">
							<div id="special-cells-container"></div>
							<div class="button-right">
								<button type="button" id="btn-add-special-cell" class="agency-layout-btn">
									<i class="fa-solid fa-plus"></i>
									une autre cellule
								</button>
							</div>
						</div>

						<div class="field mb-20 toggle-field">
							<label class="checkbox-container">
								<input type="checkbox" id="layout-aisle-toggle" checked>
								<span class="checkmark"></span>
								Présence d'un ou plusieurs couloirs
							</label>
						</div>

						<div class="js-aisle mb-20" id="aisle-logic-block">
							<div id="aisles-container"></div>
							<div class="button-right">
								<button type="button" id="btn-add-aisle" class="agency-layout-btn">
									<i class="fa-solid fa-plus"></i>
									un autre couloir
								</button>
							</div>
						</div>

						<button type="button" id="btn-generate-matrix" class="btn-refined btn-success-gradient btn-full">
							<i class="fa-solid fa-arrows-rotate"></i>
							Générer la Grille de Dessin
						</button>
					</div>
				</div>
			</div>

			<div class="admin-bus-layout-add-column">
				<div class="admin-bus-layout-add-card card-highlight">
					<h3 class="card-inner-title text-center">
						<i class="fa-solid fa-bus"></i>
						Carrosserie & Aménagement
					</h3>

					<div class="seatmap-card">
						<div class="bus-head">Avant du véhicule</div>
						<div id="layout-interactive-grid" class="seatmap-matrix"></div>
					</div>

					<div class="admin-bus-layout-add-action-zone">
						<button type="submit" id="btn-submit-layout" class="btn-refined btn-success-gradient btn-full">
							<i class="fa-solid fa-cloud-arrow-up"></i>
							Enregistrer ce Modèle d'Usine
						</button>
					</div>
				</div>
			</div>
		</form>

	</div>
{% endblock %}
