{# templates/admin/platform/subscription/add.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
	<div
		class="admin-platform-scope container">

		{# --- EN-TÊTE --- #}
		<header class="header-refined my-25">
			<div class="header-main-info">
				<a href="{{ path('admin_platform_subscription_index') }}" class="agency-back-action">
					<i class="fa-solid fa-arrow-left"></i>
				</a>
				<div class="title">
					<div class="sub-header-flex">
						<span class="text-gray text-size-13">Finance SaaS</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary text-size-13 text-highlight">Nouvel Enregistrement Contractuel</span>
					</div>
					<h1 class="mt-5">Déployer une Nouvelle Souscription</h1>
				</div>
			</div>
		</header>

		{# --- LAYOUT DOUBLE COLONNE --- #}
		<form action="#" method="POST" class="settings-form-layout-reverse">
			<div
				class="settings-container-grid">

				{# COLONNE DROITE : CADRAGE REGLEMENTAIRE #}
				<aside class="sidebar-action-panel">
					<div class="card sticky-aside-card">
						<h2 class="card-title-fix text-primary">
							<i class="fa-solid fa-triangle-exclamation"></i>
							Règle de Prolongement</h2>
						<div class="notice-box-info info-warning" style="">
							<p>
								<strong>
									<i class="fa-solid fa-clock-rotate-left"></i>
									Prolongement Rétroactif / Futur :</strong>
								Si cette agence possède déjà une licence active, assurez-vous de caler la
								<strong>Date de Prise d'Effet</strong>
								sur le jour exact de son expiration actuelle pour cumuler proprement les périodes de droits.</p>
						</div>
					</div>
				</aside>

				{# COLONNE GAUCHE : PARAMÈTRES FINANCIERS #}
				<div class="main-form-panel">
					<div class="card control-card mb-20">
						<h2 class="card-title-fix">
							<i class="fa-solid fa-file-invoice-dollar text-primary"></i>
							Quittance d'Abonnement d'Usine</h2>

						<div class="field-group mb-20">
							<div class="field">
								<label class="admin-bus-layout-add-label">Sélectionner l'Agence Cible *</label>
								<select name="agency_id" class="admin-bus-layout-add-select" required>
									<option value="" disabled selected>-- Choisir le partenaire exploité --</option>
									{% for agency in agencies %}
										<option value="{{ agency.id }}">{{ agency.name }}
											({{ agency.country }})</option>
									{% endfor %}
								</select>
							</div>
							<div class="field">
								<label class="admin-bus-layout-add-label">Forfait / Niveau de Licence *</label>
								<select name="plan_id" class="admin-bus-layout-add-select" required>
									<option value="1">Basique Standard (75,00 $ / mois)</option>
									<option value="2" selected>Premium Multitenant (250,00 $ / mois)</option>
									<option value="3">VIP Corporation (490,00 $ / mois)</option>
								</select>
							</div>
						</div>

						<div class="field-group mb-20">
							<div class="field">
								<label class="admin-bus-layout-add-label">Date de Prise d'Effet  *</label>
								<input type="date" name="started_at" class="admin-bus-layout-add-input" value="{{ "now"|date("Y-m-d") }}" required>
							</div>
							<div class="field">
								<label class="admin-bus-layout-add-label">Date de Fin de Validité *</label>
								<input type="date" name="expires_at" class="admin-bus-layout-add-input" value="{{ "now"|date_modify("+30 days")|date("Y-m-d") }}" required>
							</div>
						</div>

						<div class="field-group mb-20">
							<div class="field">
								<label class="admin-bus-layout-add-label">Montant Facturé Perçu ($) *</label>
								<input type="number" step="0.01" name="price" class="admin-bus-layout-add-input" value="250.00" required>
							</div>
							<div class="field">
								<label class="admin-bus-layout-add-label">Mode de Règlement Externe *</label>
								<select name="payment_method" class="admin-bus-layout-add-select" required>
									<option value="Mobile Money">Mobile Money (M-Pesa / Orange Money / Airtel Money)</option>
									<option value="Virement">Virement Bancaire</option>
									<option value="Cash">Versement Cash Trésorerie</option>
								</select>
							</div>
						</div>

						<div class="field-button-right my-20">
							<a href="{{ path('admin_platform_subscription_index') }}" class="btn-refined btn-gray-gradient">Annuler</a>
							<button type="submit" class="btn-refined btn-success-gradient ml-10">
								<i class="fa-solid fa-circle-check"></i>
								Activer le bloc de validité
							</button>
						</div>
					</div>
				</div>


			</div>
		</form>
	</div>
{% endblock %}
