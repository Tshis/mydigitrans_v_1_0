{# templates/admin/platform/subscription/add.html.twig #}
{% extends "admin/base.html.twig" %}

{% block body %}
<div class="admin-platform-scope container">

    {# --- EN-TÊTE CONFIGURABLE --- #}
    <header class="header-refined my-25">
        <div class="header-main-info">
            <a href="{{ path('admin_platform_subscription_index') }}" class="agency-back-action">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div class="title">
                <div class="sub-header-flex">
                    <span class="text-gray text-size-13">Finance SaaS</span>
                    <span class="arrow-divider">•</span>
                    <span class="text-primary text-size-13 text-highlight">
                        {{ is_renewal ? 'Chaînage Chronologique' : 'Nouvel Enregistrement Contractuel' }}
                    </span>
                </div>
                <h1 class="mt-5">{{ is_renewal ? 'Prolonger la Licence Agence' : 'Déployer une Nouvelle Souscription' }}
                </h1>
            </div>
        </div>
    </header>

    {# --- LAYOUT DOUBLE COLONNE --- #}
    <form action="#" method="POST" class="settings-form-layout">
        <div class="settings-container-grid">

            {# COLONNE GAUCHE : CONTRÔLE DE SÉCURITÉ #}
            <aside class="sidebar-action-panel">
                <div class="card sticky-aside-card" class="sidebar-info-card-theme">
                    <h2 class="card-title-fix text-primary"><i class="fa-solid fa-shield-halved"></i> Validation Réseau
                    </h2>
                    <div class="notice-box-info info-warning">
                        <p><strong><i class="fa-solid fa-timeline"></i> Sécurité Chronologique :</strong> {{ is_renewal
                            ? 'La date de début est automatiquement figée et verrouillée sur l\'expiration de la période
                            précédente pour empêcher tout trou d\'accès ou chevauchement comptable.' : 'Cette action
                            déploie la première Invoice de la compagnie.' }}</p>
                    </div>
                </div>
            </aside>

            {# COLONNE DROITE : FORMULAIRE DE QUITTANCE #}
            <div class="main-form-panel">
                <div class="card control-card mb-20">
                    <h2 class="card-title-fix">
                        <i class="fa-solid fa-file-invoice-dollar text-primary"></i>
                        {{ is_renewal ? 'Avenant de Prolongation' : 'Quittance d\'Abonnement d\'Usine' }}
                    </h2>

                    <div class="field-group mb-20">
                        {# AFFICHAGE CONDITIONNEL SELON LA ROUTE SOURCE #}
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Agence Cible *</label>
                            {% if is_renewal %}
                            <div class="text-data-box-lock-view">
                                <i class="fa-solid fa-lock"></i>
                                {{ sub.agency_name }}
                                ({{ sub.country }})
                            </div>
                            <input type="hidden" name="agency_id" value="{{ sub.agency_id }}">
                            {% else %}
                            <select name="agency_id" class="admin-bus-layout-add-select" required>
                                <option value="" disabled selected>-- Choisir le partenaire exploité --</option>
                                {% for agency in agencies %}
                                <option value="{{ agency.id }}">{{ agency.name }}
                                    ({{ agency.country }})</option>
                                {% endfor %}
                            </select>
                            {% endif %}
                        </div>

                        <div class="field">
                            <label class="admin-bus-layout-add-label">Forfait / Niveau de Licence *</label>
                            <select name="plan_id" class="admin-bus-layout-add-select" required>
                                <option value="1" {{ is_renewal and sub.plan_id==1 ? 'selected' : '' }}>Basique Standard
                                    (75,00 $ / mois)</option>
                                <option value="2" {{ (not is_renewal) or sub.plan_id==2 ? 'selected' : '' }}>Premium
                                    Multitenant (250,00 $ / mois)</option>
                                <option value="3" {{ is_renewal and sub.plan_id==3 ? 'selected' : '' }}>VIP Corporation
                                    (490,00 $ / mois)</option>
                            </select>
                        </div>
                    </div>

                    <div class="field-group mb-20">
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Date de Prise d'Effet *</label>
                            <input type="date" name="start_at" class="admin-bus-layout-add-input"
                                value="{{ is_renewal ? suggested_start|date('Y-m-d') : " now"|date("Y-m-d") }}" {{
                                is_renewal ? 'readonly' : '' }} required>
                        </div>
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Date de Fin de Validité *</label>
                            <input type="date" name="end_at" class="admin-bus-layout-add-input"
                                value="{{ is_renewal ? suggested_end|date('Y-m-d') : " now"|date_modify("+30
                                days")|date("Y-m-d") }}" required>
                        </div>
                    </div>

                    <div class="field-group mb-20">
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Montant Facturé Perçu ($) *</label>
                            <input type="number" step="0.01" name="price" class="admin-bus-layout-add-input"
                                value="{{ is_renewal ? sub.price : '250.00' }}" required>
                        </div>
                        <div class="field">
                            <label class="admin-bus-layout-add-label">Mode de Règlement Externe *</label>
                            <select name="payment_method" class="admin-bus-layout-add-select" required>
                                <option value="Mobile Money">Mobile Money (M-Pesa / Orange Money)</option>
                                <option value="Virement">Virement Bancaire</option>
                                <option value="Cash">Versement Cash Trésorerie</option>
                            </select>
                        </div>
                    </div>

                    <div class="field-button-right my-20">
                        <a href="{{ path('admin_platform_subscription_index') }}"
                            class="btn-refined btn-gray-gradient">Annuler</a>
                        <button type="submit" class="btn-refined btn-success-gradient ml-10">
                            <i class="fa-solid fa-circle-check"></i>
                            Activer le bloc de validité
                        </button>
                    </div>
                </div>
            </div>



        </div>
    </form>
</div>
{% endblock %}