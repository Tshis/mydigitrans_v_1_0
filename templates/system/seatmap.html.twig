<div class="seatmap-card">

    <div class="bus-head">L'avant du bus</div>

    <div class="seatmap-matrix" style="--grid-cols: {{ seatmap.totalColumns }};">

        {# ◄ SÉCURITÉ : Mode checkbox uniquement si max_seats est défini et supérieur à 1 #}
        {% set max_passengers = max_seats|default(1) %}
        {% set input_type = max_passengers > 1 ? 'checkbox' : 'radio' %}

        {% for cell in seatmap.cells %}

            {% if cell.type in ['seat', 'vip', 'normal'] %}

                {# ◄ ATTRIBUTS SÉCURISÉS : Si seat_info n'est pas fourni, le bouton est "available" par défaut #}
                {% set current_status = seat_info[cell.label]|default('available') %}
                {% set is_occupied = current_status in ['held', 'reserved', 'blocked'] %}

                <input
                    type="{{ input_type }}"
                    name="seat"
                    id="seat-{{ cell.row }}-{{ cell.col }}"
                    value="{{ cell.label }}"
                    class="seat-radio js-seat-btn"
                    data-seat-label="{{ cell.label }}"
                    {# Désactivé si occupé OU si on est sur une simple page "show" sans formulaire #}
                    {{ is_occupied or form is not defined ? 'disabled' : '' }}
                >

                <label
                    for="seat-{{ cell.row }}-{{ cell.col }}"
                    class="cell-unit {{ current_status }}"
                    data-type="{{ cell.type }}"
                >
                    <span class="-number">
                        {{ cell.label }}
                    </span>
                </label>

            {% else %}

                <div class="cell-unit" data-type="{{ cell.type }}">
                    {% if cell.type == 'driver' %}
                        <i class="fa-solid fa-circle-user text-size-20"></i>
                    {% elseif cell.type == 'coDriver' %}
                        <i class="fa-solid fa-id-card"></i>
                    {% elseif cell.type == 'wc' %}
                        <i class="fa-solid fa-restroom"></i>
                    {% elseif cell.type == 'door' %}
                        <i class="fa-solid fa-door-open"></i>
                    {% elseif cell.type == 'cashier' %}
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                    {% elseif cell.type == 'porter' %}
                        <i class="fa-solid fa-image-portrait"></i>
                    {% endif %}
                </div>

            {% endif %}

        {% endfor %}

    </div>

    <div class="seatmap-legend-bar">
        <p class="legend">
            <span class="available">Disponible</span>
            <span class="selected">Sélectionné</span>
            <span class="vip">VIP</span>
            <span class="booked">Occupé</span>
        </p>
    </div>
</div>
