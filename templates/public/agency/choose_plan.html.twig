{# templates/public/agency/choose_plan.html.twig #}
{% extends "public/base.html.twig" %}

{% block body %}
    <div class="public-become-partner-scope pricing-plans-scope">

        <header class="page-header mb-25">
            <div class="header-main-info container text-center">
                <h1>Sélectionnez votre Plan d'Abonnement</h1>
                <p class="search-summary mt-5">Activez la formule d'infrastructure SaaS adaptée à la taille de votre réseau de gares.</p>
            </div>
        </header>

        <div class="container plan-cards-flex-layout mb-25">
            {% for plan in available_plans %}
                <div class="card control-card pricing-box-item {% if plan.code == 'pro' %}featured-plan-border{% endif %}">
                    <div class="plan-header-title text-center">
                        <h3 class="plan-name">{{ plan.name|upper }}</h3>
                        <div class="plan-price-tag my-15">
                            <span class="price font-bold monospace">{{ plan.price|number_format(0, ',', ' ') }}</span>
                            <span class="currency font-bold">USD / Mois</span>
                        </div>
                        <p class="text-gray text-size-12">{{ plan.description }}</p>
                    </div>

                    <hr class="summary-divider my-15">

                    {# INJECTION OBLIGATOIRE D'UN TABLEAU MARKDOWN POUR LA MULTI-SPÉCIFICATION #}
                    <div class="table-responsive-wrapper plan-spec-table-clean">
                        <table class="table">
                            <tbody>
                                <tr>
                                    <td><i class="fa-solid fa-building-flag text-success-mode"></i> Branches (Gares)</td>
                                    <td class="text-right font-bold">{{ plan.max_branches == 999 ? 'Illimitées' : plan.max_branches }}</td>
                                </tr>
                                <tr>
                                    <td><i class="fa-solid fa-cash-register text-success-mode"></i> Terminaux POS</td>
                                    <td class="text-right font-bold">{{ plan.max_pos == 999 ? 'Illimités' : plan.max_pos }}</td>
                                </tr>
                                <tr>
                                    <td><i class="fa-solid fa-percent text-success-mode"></i> Prélèvement Ticket</td>
                                    <td class="text-right font-bold text-primary-mode">1,00 $ / unité</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <form action="{{ path('public_agency_subscribe_finalize') }}" method="POST" class="mt-20">
                        <input type="hidden" name="plan_id" value="{{ plan.id }}">
                        <button type="submit" class="btn-refined {% if plan.code == 'pro' %}btn-primary-gradient{% else %}btn-gray-gradient{% endif %} w-100-percent">
                            <i class="fa-solid fa-circle-check"></i> Activer la formule {{ plan.name }}
                        </button>
                    </form>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
