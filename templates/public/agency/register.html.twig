{# templates/public/agency/register.html.twig #}
{% extends "public/base.html.twig" %}

{% block body %}
    <div class="public-become-partner-scope public-agency-register-v1-scope">

        {# --- HEADER SANS CONTAINER (PLEINE LARGEUR VISUELLE) --- #}
        <header class="page-header mb-25">
            <div class="header-main-info container">
                <h1>Connectez votre Compagnie de Transport</h1>
                <p class="search-summary mt-5">Créez votre compte entreprise et configurez l'accès de l'administrateur souverain du réseau.</p>
            </div>
        </header>

        {# --- FORMULAIRE D'INSCRIPTION CENTRÉ --- #}
        <section class="form-container mb-25 container">
            <div class="form-card card control-card">

                {% for type in ['success', 'warning', 'danger'] %}
                    {% for message in app.flashes(type) %}
                        <div class="notice-box-danger-dashboard mb-15"><p>{{ message }}</p></div>
                    {% endfor %}
                {% endfor %}

                {# L'action est fixée dans le contrôleur : public_agency_register_process #}
                {{ form_start(form) }}

                {% if form.vars.errors|length > 0 %}
                    <div class="notice-box-danger-dashboard mb-15">{{ form_errors(form) }}</div>
                {% endif %}

                {# --- SECTION 1 : INFORMATIONS AGENCE --- #}
                <h3 class="card-section-title-fix mb-20">
                    <i class="fa-solid fa-hotel text-primary"></i> Informations agence
                </h3>

                <div class="field mb-20">
                    {{ form_label(form.agencyName) }}
                    {{ form_widget(form.agencyName) }}
                    {{ form_errors(form.agencyName) }}
                </div>

                <div class="field-group mb-20">
                    <div class="field">
                        {{ form_label(form.registrationNumber) }}
                        {{ form_widget(form.registrationNumber) }}
                        {{ form_errors(form.registrationNumber) }}
                    </div>
                    <div class="field">
                        {{ form_label(form.taxNumber) }}
                        {{ form_widget(form.taxNumber) }}
                        {{ form_errors(form.taxNumber) }}
                    </div>
                </div>

                <div class="field-group mb-25">
                    <div class="field">
                        {{ form_label(form.agencyPhone) }}
                        {{ form_widget(form.agencyPhone) }}
                        {{ form_errors(form.agencyPhone) }}
                    </div>
                    <div class="field">
                        {{ form_label(form.agencyEmail) }}
                        {{ form_widget(form.agencyEmail) }}
                        {{ form_errors(form.agencyEmail) }}
                    </div>
                </div>
                <!--field-group-->

                {# --- SECTION 2 : ANTENNE PRINCIPALE (SIÈGE) : créée automatiquement avec l'agence --- #}
                <h3 class="card-section-title-fix my-20">
                    <i class="fa-solid fa-building text-primary"></i> Siège de l'agence
                </h3>

                <div class="field-group mb-25">
                    <div class="field">
                        {{ form_label(form.mainCity) }}
                        {{ form_widget(form.mainCity) }}
                        {{ form_errors(form.mainCity) }}
                    </div>
                    <div class="field">
                        {{ form_label(form.country) }}
                        {{ form_widget(form.country) }}
                        {{ form_errors(form.country) }}
                    </div>
                </div>

                <div class="field mb-25">
                    {{ form_label(form.address) }}
                    {{ form_widget(form.address) }}
                    {{ form_errors(form.address) }}
                    <small class="text-gray mt-5">Le siège de l'agence est créé automatiquement à cette adresse. Vous pourrez ajouter d'autres gares ensuite.</small>
                </div>

                {# --- SECTION 3 : PARRAINAGE & AFFILIATION --- #}
                <h3 class="card-section-title-fix my-20">
                    <i class="fa-solid fa-code-branch text-primary"></i> Programme d'Affiliation
                </h3>

                <div class="field mb-25">
                    {{ form_label(form.sponsorToken) }}
                    {{ form_widget(form.sponsorToken, {attr : {readonly : sponsor_locked ? 'readonly' : false}}) }}
                    {{ form_errors(form.sponsorToken) }}
                    <small class="text-gray mt-5">
                        {% if sponsor_locked %}
                            <i class="fa-solid fa-link text-success-mode"></i> Ce code d'apporteur d'affaires est sécurisé par le lien d'invitation.
                        {% else %}
                            Saisissez manuellement le code MDT du partenaire qui vous a parrainé pour activer vos bonus de réseau.
                        {% endif %}
                    </small>
                    {{ form_widget(form.sponsorLocked) }}
                </div>

                {# --- SECTION 4 : RESPONSABLE --- #}
                <h3 class="card-section-title-fix my-20">
                    <i class="fa-solid fa-user text-primary"></i> Responsable (Manager Général)
                </h3>

                <div class="field-group mb-25">
                    <div class="field">
                        {{ form_label(form.ownerLastname) }}
                        {{ form_widget(form.ownerLastname) }}
                        {{ form_errors(form.ownerLastname) }}
                    </div>

                    <div class="field">
                        {{ form_label(form.ownerFirstname) }}
                        {{ form_widget(form.ownerFirstname) }}
                        {{ form_errors(form.ownerFirstname) }}
                    </div>
                </div>

                <div class="field mb-25">
                    {{ form_label(form.ownerPhone) }}
                    {{ form_widget(form.ownerPhone) }}
                    {{ form_errors(form.ownerPhone) }}
                </div>

                <div class="field mb-25">
                    {{ form_label(form.ownerEmail) }}
                    {{ form_widget(form.ownerEmail) }}
                    {{ form_errors(form.ownerEmail) }}
                </div>

                <div class="field-group mb-25">
                    <div class="field">
                        {{ form_label(form.password) }}
                        {{ form_widget(form.password) }}
                        {{ form_errors(form.password) }}
                        <small class="text-gray mt-5">Au moins 8 caractères, avec une lettre et un chiffre.</small>
                    </div>

                    <div class="field">
                        {{ form_label(form.confirmPassword) }}
                        {{ form_widget(form.confirmPassword) }}
                        {{ form_errors(form.confirmPassword) }}
                    </div>
                </div>

                <div class="field mb-25 checkbox-legal-consent-row">
                    <label class="custom-checkbox">
                        {{ form_widget(form.acceptLegal) }}
                        <span class="checkmark"></span>
                        <span class="legal-label-text">
                            En créant ce compte, la compagnie accepte expressément les <a href="{{ path('public_legal_cgu') }}" target="_blank" class="text-success text-weight-700">CGU d'infrastructure</a>, les obligations de paiement sous peine de suspension de données, et la clause de confidentialité MyDigitrans.
                        </span>
                    </label>
                    {{ form_errors(form.acceptLegal) }}
                </div>

                <button type="submit" class="btn-refined btn-primary-gradient btn-full w-100-percent">Créer mon compte agence</button>

                {{ form_widget(form._token) }}
                {{ form_end(form, {render_rest: false}) }}

                <p class="mt-25 text-weight-500 text-center account-toggle-text">
                    Déjà un compte ?
                    <a class="text-success-mode-link font-bold" href="{{ path('security_login_index') }}">Se connecter</a>
                </p>

            </div>
        </section>
    </div>
{% endblock %}
