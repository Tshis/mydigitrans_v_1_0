{% extends "public/base.html.twig" %}


{% block body %}

	<div class="public-package">

		<section class="page-header container">
			<h1>Transfert de colis</h1>
			<p>Envoyez vos colis en toute sécurité sur nos lignes régulières</p>
		</section>
		<!--page-header-->

		<section class="info-section">
			<div class="info-card">
				<h3>📦 Ce service est fait pour vous si :</h3>
				<ul>
					<li>Vous n’êtes pas passager</li>
					<li>Vous souhaitez envoyer un colis entre deux villes</li>
					<li>Vous utilisez nos lignes existantes</li>
				</ul>
			</div>
		</section>
		<!--info-section-->

		<section class="form-section-colis">
			{# searchForm : formulaire vierge, ou formulaire soumis avec ses erreurs (renvoyé par le contrôleur) #}
			{{ form_start(searchForm) }}

			<div class="field mb-25">
				{{ form_label(searchForm.departure) }}
				{{ form_widget(searchForm.departure) }}
				{{ form_errors(searchForm.departure) }}
			</div>

			<div class="field mb-25">
				{{ form_label(searchForm.arrival) }}
				{{ form_widget(searchForm.arrival) }}
				{{ form_errors(searchForm.arrival) }}
			</div>

			<div class="field mb-25">
				{{ form_label(searchForm.date) }}
				{{ form_widget(searchForm.date) }}
				{{ form_errors(searchForm.date) }}
			</div>

			<div class="field mb-25">
				{{ form_label(searchForm.packageType) }}
				{{ form_widget(searchForm.packageType) }}
				{{ form_errors(searchForm.packageType) }}
			</div>

			<div class="field mb-25">
				{{ form_label(searchForm.weightRange) }}
				{{ form_widget(searchForm.weightRange) }}
				{{ form_errors(searchForm.weightRange) }}
			</div>

			<button type="submit" class="btn-refined btn-primary-gradient btn-full">Vérifier la disponibilité</button>

			{{ form_end(searchForm, {render_rest: false}) }}
		</section>
		<!--form-selection-colis-->

	</div>
	<!--public-package-->


{% endblock %}
