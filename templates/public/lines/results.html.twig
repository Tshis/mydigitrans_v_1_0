{# templates/public/lines/results.html.twig #}
{% extends "public/base.html.twig" %}

{% block body %}
    <div class="results">
        <header class="page-header text-center mb-25">
            <h1>Trajets disponibles</h1>
            <p class="search-summary">
                <i class="fa-solid fa-location-dot text-primary"></i>
                <strong>{{ criteria.departure }}</strong> ➔ <strong>{{ criteria.arrival }}</strong>
                le <span class="monospace">{{ criteria.date|date('d/m/Y') }}</span>

                <p>
                    {{ criteria.passengers }} {{ criteria.passengers > 1 ? ' passagers' : 'passager' }}
                    <i class="fa-solid fa-circle text-size-10"></i>
                    {{ results|length }} {{ results|length > 1 ? 'résultats' : 'résultat' }}
                </p>
            </p>
        </header>

        <div class="public-search-results-scope container">
            {# --- LAYOUT DOUBLE COLONNE ASYMÉTRIQUE --- #}
            <div class="results-layout-grid">

                {% if results|length > 0 %}
                    {# COLONNE COMPACTE : FILTRES DE RAFFINEMENT DES COMPAGNIES #}
                    <aside class="filters-sidebar">
                        <div class="card filter-card sticky-filter-box">
                            <h2 class="filter-title-fix"><i class="fa-solid fa-sliders text-primary"></i> Filtrer les résultats
                            </h2>

                            <form action="#" method="GET" class="filter-action-form" onsubmit="return false;">

                                <div class="filter-group-section mb-20">
                                    <label class="filter-micro-label">Compagnies Partenaires</label>
                                    {% for agencyName in agencies %}
                                        <div class="checkbox-item-row">
                                            <label class="custom-checkbox">
                                                <input type="checkbox" class="filter-agency" value="{{ agencyName|lower }}" checked>
                                                <span class="checkmark"></span> {{ agencyName|capitalize }}
                                            </label>
                                        </div>
                                    {% endfor %}
                                </div>

                                <div class="filter-group-section mb-25">
                                    <label class="filter-micro-label">Confort / Classe</label>
                                    <div class="checkbox-item-row">
                                        <label class="custom-checkbox">
                                            <input type="checkbox" class="filter-comfort" value="vip" checked>
                                            <span class="checkmark"></span> Classe VIP (Climatisation)
                                        </label>
                                    </div>
                                    <div class="checkbox-item-row">
                                        <label class="custom-checkbox">
                                            <input type="checkbox" class="filter-comfort" value="standard" checked>
                                            <span class="checkmark"></span> Standard
                                        </label>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </aside>
                {% endif %}

                {# COLONNE PRINCIPALE : CARTES DES VOYAGES DISPONIBLES #}
                <main class="results-main-panel">
                    {% for trip in results %}
                        {# Identification du niveau de confort pour le JS #}
                        {% set comfortClass = 'vip' in trip.busModel|lower or 'vip' in trip.trip.bus.busLayout.name|lower ?
                'vip' : 'standard' %}

                        <div
                            class="card trip-result-card mb-20 js-trip-card"
                            data-agency="{{ trip.agencyName|lower }}"
                            data-comfort="{{ comfortClass }}"
                        >
                            <div class="trip-card-body-layout">

                                {# 1. Identité Compagnie #}
                                <div class="agency-brand-block">
                                    <h3 class="agency-name-title">{{ trip.agencyName }}</h3>
                                    <span class="bus-badge-type"><i class="fa-solid fa-bus"></i> {{ trip.busModel }}</span>
                                </div>

                                {# 2. Chronologie et Itinéraire #}
                                <div class="route-timeline-block">
                                    <div class="time-node">
                                        <span class="time font-bold monospace">{{ trip.departureAt|date('H:i') }}</span>
                                        <span class="station-name font-bold">{{ trip.departureCity }}</span>
                                        <span class="station-name text-primary font-bold">{{ trip.departureAt|date('d-m-Y')
                                    }}</span>
                                    </div>
                                    <div class="route-duration-line">
                                        <span class="duration-text text-danger font-bold text-size-16 monospace">{{
                                    trip.durationInMinutes|duration }}</span>
                                        <div class="visual-line"></div>
                                    </div>
                                    <div class="time-node">
                                        <span class="time font-bold monospace">{{ trip.arrivalAt|date('H:i') }}</span>
                                        <span class="station-name font-bold">{{ trip.arrivalCity }}</span>
                                        <span class="station-name text-primary font-bold">{{ trip.arrivalAt|date('d-m-Y')
                                    }}</span>
                                    </div>
                                </div>

                                {# 3. Tarification & Réservation #}
                                <div class="pricing-booking-block text-right">
                                    <div class="seat-left-alert mb-10">
                                        <i class="fa-solid fa-chair text-warning"></i>
                                        <span class="font-bold text-size-12">{{ trip.availableSeats }} places dispos</span>
                                    </div>
                                    <div class="trip-price-tag mb-15">
                                        <span class="price font-bold monospace">{{ trip.unitPrice|number_format(2, ',', ' ')
                                    }}</span>
                                        <span class="currency font-bold">{{ trip.currency|upper }}</span>
                                    </div>

                                    {# Formulaire de soumission vers le tunnel d'achat #}
                                    {# ◄ RECORRECTION ICI : Utilisation du slug de la route pour correspondre aux exigences de
                            la route #}
                                    <form
                                        action="{{ path('public_lines_booking', {'slug': trip.trip.slug}) }}"
                                        method="POST"
                                    >
                                        <input type="hidden" name="trip_id" value="{{ trip.trip.id }}">
                                        <input type="hidden" name="passengers_count" value="{{ criteria.passengers }}">
                                        <button type="submit" class="btn-refined btn-success-gradient w-100-percent">
                                            <i class="fa-solid fa-ticket"></i> Réserver ma place
                                        </button>
                                    </form>
                                </div>

                            </div>
                        </div>
                    {% else %}
                        <div class="card control-card no-results-box text-center padding-40">
                            <div class="no-results-icon-wrap text-gray mb-15">
                                <i class="fa-solid fa-bus-slash fa-3x"></i>
                            </div>
                            <h3>Aucun bus disponible pour cette date</h3>
                            <p class="text-gray mt-5 text-size-12 text-weight-500">Essayez de modifier vos critères de recherche
                                ou explorez les suggestions de trajets populaires en bas de page.</p>
                            <a href="{{ path('public_lines_index') }}" class="btn-refined btn-dark-gradient mt-15">
                                <i class="fa-solid fa-arrow-left"></i> Modifier la recherche
                            </a>
                        </div>
                    {% endfor %}

                    {# Bloc d'alerte JS caché par défaut #}
                    <div
                        id="js-no-match-box"
                        class="card control-card no-results-box text-center padding-40"
                        style="display: none;"
                    >
                        <div class="no-results-icon-wrap text-gray mb-15">
                            <i class="fa-solid fa-filter fa-3x"></i>
                        </div>
                        <h3>Aucun voyage ne correspond à vos filtres</h3>
                        <p class="text-gray mt-5 text-size-12">Veuillez recocher au moins une compagnie ou un niveau de
                            confort.</p>
                    </div>
                </main>

            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const agencyCheckboxes = document.querySelectorAll(".filter-agency");
            const comfortCheckboxes = document.querySelectorAll(".filter-comfort");

            const tripCards = document.querySelectorAll(".js-trip-card");
            const noMatchBox = document.getElementById("js-no-match-box");
            function applyFilters() {
                const checkedAgencies = Array.from(agencyCheckboxes)
                    .filter((cb) => cb.checked)
                    .map((cb) => cb.value);
                const checkedComforts = Array.from(comfortCheckboxes)
                    .filter((cb) => cb.checked)
                    .map((cb) => cb.value);
                let visibleCardsCount = 0;
                tripCards.forEach((card) => {
                    const cardAgency = card.getAttribute("data-agency");
                    const cardComfort = card.getAttribute("data-comfort");
                    const matchesAgency = checkedAgencies.includes(cardAgency);
                    const matchesComfort = checkedComforts.includes(cardComfort);
                    if (matchesAgency && matchesComfort) {
                        card.style.display = "block";
                        visibleCardsCount++;
                    } else {
                        card.style.display = "none";
                    }
                });
                if (visibleCardsCount === 0 && tripCards.length > 0) {
                    noMatchBox.style.display = "block";
                } else {
                    noMatchBox.style.display = "none";
                }
            }
            agencyCheckboxes.forEach((cb) =>
                cb.addEventListener("change", applyFilters),
            );
            comfortCheckboxes.forEach((cb) =>
                cb.addEventListener("change", applyFilters),
            );
        });
    </script>
{% endblock %}
