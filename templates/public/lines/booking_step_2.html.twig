{# templates/public/lines/booking_step_2.html.twig #}
{% extends "public/base.html.twig" %}

{% block body %}
	{% set online_enabled = online_payment_enabled|default(false) %}
	<div class="public-booking-scope">

		{# --- HEADER PLEINE LARGEUR SANS CONTAINER --- #}
		<header class="page-header mb-25">
			<div class="header-main-info container">
				<div class="title">
					<div class="sub-header-flex text-size-16 text-weight-700">
						<span class="">Tunnel de Réservation</span>
						<span class="arrow-divider">•</span>
						<span class="text-primary  text-highlight">Étape 2 sur 2</span>
					</div>
					<h1 class="mt-5">Mode de Règlement & Validation</h1>
				</div>
			</div>
		</header>

		<div class="container">

			{% for type in ['danger', 'warning'] %}
				{% for message in app.flashes(type) %}
					<div class="notice-box-danger-dashboard mb-15"><p>{{ message }}</p></div>
				{% endfor %}
			{% endfor %}

			{# --- FORMULAIRE DOUBLE COLONNE INVERSÉ --- #}
			<form action="{{ path('public_lines_booking_finalize', {'reference': booking.reference}) }}" method="POST" class="settings-form-layout">
				<input type="hidden" name="_token" value="{{ csrf_token('finalize' ~ booking.reference) }}">

				<div class="settings-container-grid">

					{# COLONNE DROITE : SYNTHÈSE DE LA RÉSERVATION (EN PREMIER DANS LE HTML) #}
					<aside class="sidebar-action-panel">
						<div class="card sticky-aside-card public-invoice-sidebar-theme">
							<h2 class="card-title-fix">
								<i class="fa-solid fa-ticket text-primary"></i> Récapitulatif Réservation
							</h2>

							<div class="financial-block-summary mb-12">
								<label class="admin-bus-layout-add-label">Voyageur</label>
								<span class="trip-summary-text-value font-bold">{{ booking.passengerName }}</span>
							</div>

							<div class="financial-block-summary mb-12">
								<label class="admin-bus-layout-add-label">Itinéraire</label>
								<span class="trip-summary-text-value font-bold text-primary-mode">{{ booking.departureCity }} ➔ {{ booking.arrivalCity }}</span>
							</div>

							<div class="financial-block-summary mb-12">
								<label class="admin-bus-layout-add-label">Départ</label>
								<span class="trip-summary-text-value monospace">{{ booking.departureAt|date('d/m/Y à H:i') }}</span>
							</div>

							<div class="financial-block-summary mb-12">
								<label class="admin-bus-layout-add-label">Bus & Siège{{ booking.seats|length > 1 ? 's' : '' }}</label>
								<span class="trip-summary-text-value monospace">{{ booking.busModel }} • <strong>N° {{ booking.seats|join(', ') }}</strong></span>
							</div>

							<hr class="summary-divider mb-15">

							<div class="financial-block-summary mb-20">
								<label class="admin-bus-layout-add-label">Montant Total</label>
								<span class="invoice-macro-amount font-primary">{{ booking.total }} {{ booking.currencyCode }}</span>
							</div>

							{% if booking.expiresAt %}
								<div class="notice-box-info">
									<p><i class="fa-solid fa-clock"></i> Vos sièges sont retenus jusqu'à <strong>{{ booking.expiresAt|date('H:i') }}</strong>. Passé ce délai, ils sont remis en vente.</p>
								</div>
							{% endif %}
						</div>
					</aside>

					{# COLONNE GAUCHE : SÉLECTEUR DE MÉTHODE DE PAIEMENT #}
					<div class="main-form-panel">
						<div class="card control-card mb-20">
							<h2 class="card-title-fix mb-20">
								<i class="fa-solid fa-wallet text-primary"></i> Choisir votre mode de règlement
							</h2>

							{# OPTION A : PAIEMENT MOBILE MONEY IMMÉDIAT (version 2) #}
							<div class="payment-method-option-card mb-15">
								<label class="payment-radio-container">
									<input type="radio" name="payment_method" value="mobile_money" {{ online_enabled ? 'checked' : 'disabled' }}>
									<span class="radio-marker"></span>
									<div class="option-label-content">
										<span class="option-title">Payer maintenant par Mobile Money{% if not online_enabled %} <small class="text-gray">(bientôt disponible)</small>{% endif %}</span>
										<p class="option-desc">Validation instantanée de votre billet électronique. Votre siège est sécurisé à 100%.</p>

										{# Logos des opérateurs de RDC #}
										<div class="operator-logos-grid mt-10">
											<span class="op-logo op-mpesa">M-Pesa</span>
											<span class="op-logo op-orange">Orange Money</span>
											<span class="op-logo op-airtel">Airtel Money</span>
										</div>
									</div>
								</label>
							</div>

							{# OPTION B : RÉSERVATION GRATUITE & PAIEMENT AU GUICHET #}
							<div class="payment-method-option-card standard-accent-border">
								<label class="payment-radio-container">
									<input type="radio" name="payment_method" value="station_cash" {{ not online_enabled and station_deadline ? 'checked' : '' }} {{ station_deadline is null ? 'disabled' : '' }}>
									<span class="radio-marker"></span>
									<div class="option-label-content">
										<span class="option-title text-warning-mode">Réserver sans payer (Règlement au Guichet)</span>
										<p class="option-desc">Génère un Bon de Réservation temporaire. Vous paierez en espèces à la gare avant le départ.</p>

										<div class="notice-box-danger-dashboard mt-10">
											{% if station_deadline %}
												<p><i class="fa-solid fa-clock-history"></i> <strong>Règle de carence :</strong> Ce bon expirera automatiquement le <strong>{{ station_deadline|date('d/m/Y à H:i') }}</strong>, avant le départ du bus, s'il n'est pas soldé à la gare.</p>
											{% else %}
												<p><i class="fa-solid fa-clock-history"></i> Le départ est trop proche pour réserver sans payer.</p>
											{% endif %}
										</div>
									</div>
								</label>
							</div>

						</div>

						{# BOUTONS D'ACTION #}
						<div class="admin-bus-layout-add-action-zone">
							<button type="submit" class="btn-refined btn-success-gradient" {{ (not online_enabled and station_deadline is null) ? 'disabled' : '' }}>
								<i class="fa-solid fa-circle-check"></i> Confirmer & Éditer ma pièce
							</button>
						</div>
					</div>

				</div>
			</form>
		</div>
	</div>
{% endblock %}
