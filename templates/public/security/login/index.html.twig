{% extends 'public/base.html.twig' %}

{% block body %}

	<section class="page-header container">
		<h1>Connectez-vous</h1>
		<p>Accédez à votre espace administration en toute sécurité.</p>
	</section>
	<!--page header-->

	<section class="login-container">

		<div class="login-card">

			<form method="post">

				{% if app.user %}
					<div class="mb-3">
						You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
					</div>
				{% endif %}

				{% if error %}
					<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
				{% endif %}

				<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">


				<div class="field mb-25">
					<div class="form-group">
						<label>Email</label>
						<input value="{{ last_username }}" name="email" type="email" autocomplete="off" placeholder="exemple@mydigitrans.com" required autofocus>
					</div>
				</div>


				<div class="field mb-25">
					<div class="form-group">
						<label>Mot de passe</label>
						<input name="password" type="password" placeholder="••••••••" required>
					</div>
				</div>

				<div class="options mb-25">
					<label class="remember">
						<input name="_remember_me" type="checkbox">
						Se souvenir de moi
					</label>
					<a href="{{ path('security_password_forgot') }}" class="forgot">Mot de passe oublié ?</a>
				</div>

				<button class="btn-refined btn-primary-gradient btn-full py-10">Se connecter</button>

			</form>

		</div>

	</section>

{% endblock %}
