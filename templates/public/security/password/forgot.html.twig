{% extends "public/base.html.twig" %}

{% block body %}


	<section class="page-header container">
		<h1>Mot de passe oublié ?</h1>
		<p class="subtitle">
			Entrez votre email pour recevoir un lien de réinitialisation.
		</p>
	</section>
	<!--page header-->

	<section class="login-container">

		<div class="login-card">


			{# <form method="post">

				<div class="field mb-25">
					<label>Email</label>
					<input type="email" placeholder="exemple@voyagest.com" required>
				</div>

				<button class="btn-refined btn-primary-gradient btn-full mb-25">Envoyer le lien</button>

			</form>
 #}

			<form method="post">
				{% if error %}
					<div class="alert alert-danger mb-25">{{ error }}</div>
				{% endif %}
				{% if success %}
					<div class="alert alert-success mb-25">Un lien de réinitialisation vous a été envoyé si votre compte est éligible.</div>
				{% endif %}

				<div class="field mb-25">
					<label>Email</label>
					<input type="email" name="email" placeholder="exemple@voyagest.com" required>
				</div>
				<button type="submit" class="btn-refined btn-primary-gradient btn-full mb-25">Envoyer le lien</button>
			</form>

			<p class="back-link">
				<a href="{{ path('security_login_index') }}">← Retour à la connexion</a>
			</p>
		</div>

	</section>


{% endblock %}
