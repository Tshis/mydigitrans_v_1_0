{% extends "public/base.html.twig" %}

{% block body %}

    <div class="contact">

        <section class="page-header container">
            <h1>Contactez l’équipe Mydigitrans</h1>
            <p>Support technique, partenariat ou informations générales</p>
        </section>

        <section class="contact-container">

            <!-- FORMULAIRE -->
            {{ form_start(form, {attr: {class: 'contact-form'}}) }}
                <h3>
                    <i class="fas fa-envelope"></i>
                    Envoyer un message
                </h3>

                {% for message in app.flashes('success') %}
                    <div class="notice-box-info mb-25"><p><i class="fa-solid fa-circle-check"></i> {{ message }}</p></div>
                {% endfor %}

                {% if form.vars.errors|length > 0 %}
                    <div class="notice-box-danger-dashboard mb-25">{{ form_errors(form) }}</div>
                {% endif %}

                <div class="field mb-25">
                    {{ form_label(form.fullName) }}
                    {{ form_widget(form.fullName) }}
                    {{ form_errors(form.fullName) }}
                </div>

                <div class="field mb-25">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="field mb-25">
                    {{ form_label(form.subject) }}
                    {{ form_widget(form.subject) }}
                    {{ form_errors(form.subject) }}
                </div>

                <div class="field mb-25">
                    {{ form_label(form.message) }}
                    {{ form_widget(form.message) }}
                    {{ form_errors(form.message) }}
                </div>

                {# Piège à robots : invisible pour les visiteurs, ne pas remplir #}
                <div style="position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden;" aria-hidden="true">
                    {{ form_widget(form.website) }}
                </div>

                <button type="submit" class="btn-refined btn-primary-gradient btn-full">
                    Envoyer le message
                    <i class="fa-solid fa-paper-plane"></i>
                </button>

                {{ form_widget(form._token) }}
            {{ form_end(form, {render_rest: false}) }}

            <!-- INFOS -->
            <div class="contact-info">

                <div class="card">
                    <div class="icon"><i class="fas fa-phone-volume"></i></div>
                    <h3>Téléphone</h3>
                    <p>+ 243 81 000 00 00</p>
                </div>
                <!--card-->

                <div class="card">
                    <div class="icon"><i class="fa-solid fa-envelope"></i></div>
                    <h3>Adresse email</h3>
                    <p>Support@mydigitrans.com</p>
                </div>
                <!--card-->

                <div class="card">
                    <div class="icon"><i class="fa-solid fa-location-dot"></i></div>
                    <h3>Localisation</h3>
                    <p>Kinshasa - RDC</p>
                </div>
                <!--card-->

            </div>
            <!--contact-info-->

        </section>

    </div>
    <!--contact-->


{% endblock %}
